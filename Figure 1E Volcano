#!/usr/bin/env Rscript
# =============================================================================
# 1_volcano_sex_adjusted.R
#
# Figure 1C: volcano plots of the six phase transitions.
# Model:   ~ 0 + Group + Sex (filterByExpr, TMM, robust edgeR QL), FDR < 0.01
# Output:  one figure saved as PDF (vector) + PNG + TIFF (600 dpi)
#
# DIRECTION CONVENTION
# edgeR contrasts are written as first phase minus second phase (e.g. TE - TL).
# The plot shows the change FROM the first TO the second phase, so the x-axis is
# -logFC: "Upregulated" (right, blue) = higher in the second phase of the label,
# e.g. for "TE-TL", higher in TL. This is the convention used in the manuscript
# (TE-TL: 248 up / 156 down). The script stops with a warning if the counts
# differ from the manuscript values.
# =============================================================================

# ----------------------------
# 1) Load Required Libraries
# ----------------------------
required_packages <- c("edgeR", "limma", "dplyr", "ggplot2", "ggtext",
                       "gridExtra", "grid", "ggsci")

missing_packages <- required_packages[
  !vapply(required_packages, requireNamespace, quietly = TRUE, FUN.VALUE = logical(1))
]
if (length(missing_packages) > 0) {
  stop("The following required packages are missing: ", paste(missing_packages, collapse = ", "))
}

suppressPackageStartupMessages({
  library(edgeR)
  library(limma)
  library(dplyr)
  library(ggplot2)
  library(ggtext)
  library(gridExtra)
  library(grid)
})

##############################################################
# FIGURE STYLE  (this block is identical in all five scripts)
#
# Every figure is drawn at its FINAL printed size, so the font
# sizes below are the real sizes on paper. If you change a number
# here, change it in the other four scripts too so all figures match.
##############################################################

FIG_WIDTH  <- 7.0    # inches (about 178 mm = full page width)
FIG_HEIGHT <- 6.0    # inches
FIG_DPI    <- 600
FIG_FONT   <- "sans" # Helvetica/Arial

FS <- list(          # font sizes in points
  title        = 16,
  axis_title   = 14,
  axis_text    = 13,
  legend_title = 13,
  legend_text  = 13
)

LINE_WIDTH <- 0.7    # axis lines and ticks

theme_pub <- function() {
  ggplot2::theme_classic(base_size = FS$axis_text, base_family = FIG_FONT) +
    ggplot2::theme(
      plot.title   = ggplot2::element_text(size = FS$title, face = "bold", hjust = 0.5),
      axis.title   = ggplot2::element_text(size = FS$axis_title),
      axis.text    = ggplot2::element_text(size = FS$axis_text, colour = "black"),
      axis.line    = ggplot2::element_line(linewidth = LINE_WIDTH, colour = "black"),
      axis.ticks   = ggplot2::element_line(linewidth = LINE_WIDTH, colour = "black"),
      legend.title = ggplot2::element_text(size = FS$legend_title, face = "bold"),
      legend.text  = ggplot2::element_text(size = FS$legend_text),
      legend.key   = ggplot2::element_blank(),
      plot.margin  = ggplot2::margin(6, 6, 6, 6)
    )
}

gp_title        <- grid::gpar(fontsize = FS$title,        fontface = "bold", fontfamily = FIG_FONT)
gp_axis_title   <- grid::gpar(fontsize = FS$axis_title,   fontfamily = FIG_FONT)
gp_legend_title <- grid::gpar(fontsize = FS$legend_title, fontface = "bold", fontfamily = FIG_FONT)
gp_legend_text  <- grid::gpar(fontsize = FS$legend_text,  fontfamily = FIG_FONT)

# Saves a figure as PDF (vector) + PNG + TIFF (600 dpi).
# fig: a ggplot, a grid grob/gtable, or a function that draws the figure.
# path_no_ext: full file path WITHOUT extension.
save_figure <- function(fig, path_no_ext,
                        width = FIG_WIDTH, height = FIG_HEIGHT,
                        formats = c("pdf", "png", "tiff")) {
  draw_fig <- function() {
    if (inherits(fig, "ggplot")) {
      print(fig)
    } else if (is.function(fig)) {
      fig()
    } else {
      grid::grid.newpage()
      grid::grid.draw(fig)
    }
  }
  # "cairo" supports TIFF compression on every system (macOS "quartz" does not)
  bitmap_type <- if (isTRUE(capabilities("cairo"))) "cairo" else getOption("bitmapType")
  if ("pdf" %in% formats) {
    pdf_file <- paste0(path_no_ext, ".pdf")
    if (isTRUE(capabilities("cairo"))) {
      grDevices::cairo_pdf(pdf_file, width = width, height = height, family = FIG_FONT)
    } else {
      grDevices::pdf(pdf_file, width = width, height = height,
                     family = "Helvetica", useDingbats = FALSE)
    }
    draw_fig()
    grDevices::dev.off()
  }
  if ("png" %in% formats) {
    grDevices::png(paste0(path_no_ext, ".png"), width = width, height = height,
                   units = "in", res = FIG_DPI, bg = "white", type = bitmap_type)
    draw_fig()
    grDevices::dev.off()
  }
  if ("tiff" %in% formats) {
    grDevices::tiff(paste0(path_no_ext, ".tiff"), width = width, height = height,
                    units = "in", res = FIG_DPI, compression = "lzw", bg = "white",
                    type = bitmap_type)
    draw_fig()
    grDevices::dev.off()
  }
  message("Saved: ", path_no_ext, " (", paste(formats, collapse = ", "), "), ",
          width, " x ", height, " in, ", FIG_DPI, " dpi")
  invisible(path_no_ext)
}

##############################################################
# END OF FIGURE STYLE
##############################################################

# ----------------------------
# 2) User Settings
# ----------------------------
counts_path   <- "/Users/adrian/Desktop/EQU.03/20251016_merged_Cortex_0FPM.txt"
metadata_path <- "/Users/adrian/Desktop/EQU.03/20251016_merged_Cortex_samples.txt"

sex_column   <- "Sex"
group_levels <- c("SE", "TE", "TL", "AE", "AL")
fdr_cutoff   <- 0.01
fdr_label    <- format(fdr_cutoff, scientific = FALSE, trim = TRUE)

output_dir <- file.path(
  "/Users/adrian/Desktop/EQU.03",
  paste0("Volcano_filtered_robust_sex_adjusted_FDR_", fdr_label)
)
dir.create(output_dir, recursive = TRUE, showWarnings = FALSE)

# Panel order (3 columns x 2 rows) and the edgeR contrasts (first - second).
contrast_definitions <- c(
  SE_vs_TE = "SE - TE",
  TE_vs_TL = "TE - TL",
  TL_vs_AE = "TL - AE",
  AE_vs_AL = "AE - AL",
  AL_vs_TE = "AL - TE",
  AL_vs_SE = "AL - SE"
)

# Manuscript values (Table 1), used only as a check.
expected_up   <- c(SE_vs_TE = 11L, TE_vs_TL = 248L, TL_vs_AE = 191L,
                   AE_vs_AL = 0L,  AL_vs_TE = 242L, AL_vs_SE = 48L)
expected_down <- c(SE_vs_TE = 4L,  TE_vs_TL = 156L, TL_vs_AE = 226L,
                   AE_vs_AL = 0L,  AL_vs_TE = 74L,  AL_vs_SE = 27L)

# Colours: JAMA palette, as in the submitted figure.
jama <- ggsci::pal_jama("default")(3)
colour_values <- c(
  "Downregulated"   = jama[2],
  "Not significant" = jama[1],
  "Upregulated"     = jama[3]
)

point_size <- 1.0   # points are small because each panel is about 2 in wide

# ----------------------------
# 3) Load and Validate Data
# ----------------------------
counts <- read.table(counts_path, header = TRUE, row.names = 1, sep = "\t",
                     check.names = FALSE, stringsAsFactors = FALSE, quote = "", comment.char = "")
metadata <- read.table(metadata_path, header = TRUE, sep = "\t",
                       check.names = FALSE, stringsAsFactors = FALSE, quote = "", comment.char = "")

missing_metadata_columns <- setdiff(c("Sample", "Group", sex_column), colnames(metadata))
if (length(missing_metadata_columns) > 0) {
  stop("The metadata is missing these required columns: ", paste(missing_metadata_columns, collapse = ", "))
}

metadata$Sample <- trimws(as.character(metadata$Sample))
metadata$Group  <- trimws(as.character(metadata$Group))
metadata$Sex    <- trimws(as.character(metadata[[sex_column]]))

if (anyDuplicated(metadata$Sample)) stop("The metadata contains duplicated Sample values.")
if (any(is.na(metadata$Sex) | metadata$Sex == "")) stop("The metadata contains missing Sex values.")

unexpected_groups <- setdiff(unique(metadata$Group), group_levels)
if (length(unexpected_groups) > 0) {
  stop("Unexpected Group values were found: ", paste(unexpected_groups, collapse = ", "))
}

metadata$Group <- factor(metadata$Group, levels = group_levels)
metadata$Sex   <- droplevels(factor(metadata$Sex))
rownames(metadata) <- metadata$Sample

missing_count_samples <- setdiff(metadata$Sample, colnames(counts))
if (length(missing_count_samples) > 0) {
  stop("These metadata samples are absent from the count matrix: ",
       paste(missing_count_samples, collapse = ", "))
}

counts <- as.matrix(counts[, metadata$Sample, drop = FALSE])
suppressWarnings(storage.mode(counts) <- "numeric")
if (anyNA(counts)) stop("The count matrix contains missing or non-numeric values.")
if (!all(abs(counts - round(counts)) < 1e-8)) {
  stop("The expression matrix is not integer-like. edgeR requires raw read counts.")
}

cat("\nSample composition by Group and Sex:\n")
print(table(Group = metadata$Group, Sex = metadata$Sex))

# ----------------------------
# 4) Filter, Normalize, Fit the Sex-Adjusted Model
# ----------------------------
dge  <- edgeR::DGEList(counts = counts, group = metadata$Group)
keep <- edgeR::filterByExpr(dge, group = metadata$Group)
dge  <- dge[keep, , keep.lib.sizes = FALSE]
dge  <- edgeR::normLibSizes(dge, method = "TMM")
cat("Genes retained after filterByExpr:", nrow(dge), "\n")

design <- model.matrix(~ 0 + Group + Sex, data = metadata)
colnames(design) <- sub("^Group", "", colnames(design))
if (qr(design)$rank < ncol(design)) stop("The sex-adjusted design matrix is not full rank.")

dge_model <- edgeR::estimateDisp(dge, design, robust = TRUE)
fit       <- edgeR::glmQLFit(dge_model, design, robust = TRUE)

contrast_matrix <- limma::makeContrasts(contrasts = unname(contrast_definitions), levels = design)
colnames(contrast_matrix) <- names(contrast_definitions)

# ----------------------------
# 5) Test Each Contrast
# ----------------------------
results_list <- list()

for (contrast_name in colnames(contrast_matrix)) {
  test <- edgeR::glmQLFTest(fit, contrast = contrast_matrix[, contrast_name])
  tab  <- edgeR::topTags(test, n = Inf, sort.by = "none")$table
  tab$GeneID <- rownames(tab)

  tab <- tab %>%
    dplyr::mutate(
      # change from the first to the second phase of the label
      logFC_second_vs_first = -logFC,
      negLog10FDR = -log10(pmax(FDR, .Machine$double.xmin)),
      Significance = factor(
        dplyr::case_when(
          FDR < fdr_cutoff & logFC_second_vs_first > 0 ~ "Upregulated",
          FDR < fdr_cutoff & logFC_second_vs_first < 0 ~ "Downregulated",
          TRUE                                         ~ "Not significant"
        ),
        levels = c("Downregulated", "Not significant", "Upregulated")
      )
    ) %>%
    dplyr::relocate(GeneID)

  write.table(tab,
              file = file.path(output_dir, paste0(contrast_name, "_volcano_table.txt")),
              sep = "\t", quote = FALSE, row.names = FALSE)

  results_list[[contrast_name]] <- tab
}

# ----------------------------
# 6) Check the Counts Against the Manuscript
# ----------------------------
deg_counts <- data.frame(
  Contrast      = names(results_list),
  Upregulated   = vapply(results_list, function(x) sum(x$Significance == "Upregulated"),   integer(1)),
  Downregulated = vapply(results_list, function(x) sum(x$Significance == "Downregulated"), integer(1)),
  row.names     = NULL
)
deg_counts$Total <- deg_counts$Upregulated + deg_counts$Downregulated

cat("\nDEG counts (Upregulated = higher in the second phase of the label):\n")
print(deg_counts, row.names = FALSE)

write.table(deg_counts, file = file.path(output_dir, "Volcano_DEG_counts.txt"),
            sep = "\t", quote = FALSE, row.names = FALSE)

if (!identical(deg_counts$Upregulated,   unname(expected_up[deg_counts$Contrast])) ||
    !identical(deg_counts$Downregulated, unname(expected_down[deg_counts$Contrast]))) {
  warning("The up/down counts differ from the manuscript (Table 1). ",
          "Check the input files, the Sex coding and the direction convention.")
}

# ----------------------------
# 7) Volcano Panels (publication style)
# ----------------------------
x_limit <- max(abs(unlist(lapply(results_list, `[[`, "logFC_second_vs_first"))), na.rm = TRUE)
x_limit <- ceiling(x_limit)
y_max   <- max(unlist(lapply(results_list, function(x) x$negLog10FDR[is.finite(x$negLog10FDR)])), na.rm = TRUE)
y_upper <- max(1, ceiling(y_max))

make_panel <- function(tab, contrast_name) {
  n_up   <- sum(tab$Significance == "Upregulated")
  n_down <- sum(tab$Significance == "Downregulated")

  subtitle_text <- paste0(
    "<span style='color:", colour_values["Downregulated"], "'>↓ ", n_down, "</span>",
    "\u2002\u2002\u2002",   # spacing between the two counts
    "<span style='color:", colour_values["Upregulated"], "'>↑ ", n_up, "</span>"
  )

  # draw non-significant genes first so the coloured points sit on top
  tab <- tab[order(tab$Significance != "Not significant"), ]

  ggplot(tab, aes(x = logFC_second_vs_first, y = negLog10FDR, colour = Significance)) +
    geom_point(size = point_size, alpha = 0.8, stroke = 0) +
    scale_colour_manual(values = colour_values, drop = FALSE,
                        name = paste0("FDR < ", fdr_label)) +
    scale_x_continuous(limits = c(-x_limit, x_limit), expand = expansion(mult = 0.02)) +
    scale_y_continuous(limits = c(0, y_upper), expand = expansion(mult = c(0, 0.02))) +
    labs(title = gsub("_vs_", "-", contrast_name),
         subtitle = subtitle_text,
         x = expression(log[2]~"fold change"),
         y = expression(-log[10]~"FDR")) +
    guides(colour = guide_legend(override.aes = list(size = 3, alpha = 1))) +
    theme_pub() +
    theme(
      plot.subtitle   = ggtext::element_markdown(size = FS$axis_title, face = "bold", hjust = 0.5,
                                                 margin = margin(b = 4)),
      legend.position = "bottom"
    )
}

panels <- lapply(names(results_list), function(nm) make_panel(results_list[[nm]], nm))

# Take the shared legend from the first panel, then remove legends from all panels.
legend_grob <- local({
  g <- ggplotGrob(panels[[1]])
  idx <- which(vapply(g$grobs, function(x) grepl("guide-box", x$name), logical(1)))
  idx <- idx[vapply(g$grobs[idx], function(x) !inherits(x, "zeroGrob"), logical(1))]
  if (length(idx) == 0) grid::nullGrob() else g$grobs[[idx[1]]]
})
panels_no_legend <- lapply(panels, function(p) p + theme(legend.position = "none"))

volcano_figure <- gridExtra::arrangeGrob(
  gridExtra::arrangeGrob(grobs = panels_no_legend, ncol = 3),
  legend_grob,
  ncol = 1,
  heights = grid::unit.c(grid::unit(1, "null"), grid::unit(0.6, "in"))
)

volcano_path <- file.path(
  output_dir,
  paste0("Volcano_six_transitions_filtered_robust_sex_adjusted_FDR_lt_", fdr_label)
)
save_figure(volcano_figure, volcano_path)

# ----------------------------
# 8) Session Information
# ----------------------------
capture.output(sessionInfo(), file = file.path(output_dir, "R_sessionInfo.txt"))

cat("\n============================================================\n")
cat("DONE\n")
cat("Model: ~ 0 + Group + Sex (robust edgeR QL), FDR <", fdr_label, "\n")
cat("Volcano figure:\n", paste0(volcano_path, ".pdf / .png / .tiff"), "\n")
cat("============================================================\n")
