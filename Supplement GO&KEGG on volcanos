safe_query_biomart <- function(
    dataset_name,
    gene_ids
) {
  if (length(gene_ids) == 0) {
    return(
      data.frame(
        Target_gene = character(0),
        queried_gene_biotype = character(0),
        stringsAsFactors = FALSE
      )
    )
  }
  
  # Three total attempts by default: the default Ensembl endpoint first,
  # followed by two useEnsembl mirrors. This avoids silently turning a network
  # outage into an "all unannotated" biological result.
  endpoint_schedule <- c("default", "useast", "asia")
  last_errors <- character(0)
  
  old_timeout <- getOption("timeout")
  options(timeout = max(network_timeout_seconds, old_timeout))
  on.exit(options(timeout = old_timeout), add = TRUE)
  
  for (attempt in seq_len(network_retry_attempts)) {
    endpoint <- endpoint_schedule[
      ((attempt - 1L) %% length(endpoint_schedule)) + 1L
    ]
    
    message(
      "Ensembl query attempt ", attempt, "/", network_retry_attempts,
      " for ", dataset_name, " via ", endpoint, "."
    )
    
    query_result <- tryCatch(
      {
        dataset_mart <- if (identical(endpoint, "default")) {
          biomaRt::useEnsembl(
            biomart = "genes",
            dataset = dataset_name
          )
        } else {
          biomaRt::useEnsembl(
            biomart = "genes",
            dataset = dataset_name,
            mirror = endpoint
          )
        }
        
        queried_info <- biomaRt::getBM(
          attributes = c(
            "ensembl_gene_id",
            "gene_biotype"
          ),
          filters = "ensembl_gene_id",
          values = gene_ids,
          mart = dataset_mart
        )
        
        colnames(queried_info) <- c(
          "Target_gene",
          "queried_gene_biotype"
        )
        
        queried_info %>%
          dplyr::distinct(
            Target_gene,
            .keep_all = TRUE
          )
      },
      error = function(e) {
        structure(
          list(message = conditionMessage(e)),
          class = "biomart_query_error"
        )
      }
    )
    
    if (!inherits(query_result, "biomart_query_error")) {
      return(query_result)
    }
    
    last_errors <- c(
      last_errors,
      paste0(
        "attempt ", attempt, " (", endpoint, "): ",
        query_result$message
      )
    )
    
    message(
      "Ensembl attempt failed: ", query_result$message
    )
    
    if (attempt < network_retry_attempts) {
      Sys.sleep(network_retry_pause_seconds)
    }
  }
  
  stop(
    "All Ensembl biomaRt attempts failed for dataset ", dataset_name,
    ". The analysis is stopping rather than classifying all genes as ",
    "unannotated. Errors: ", paste(last_errors, collapse = " | ")
  )
}

