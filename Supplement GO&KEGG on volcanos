    BgRatio = character(),
    pvalue = numeric(),
    p.adjust = numeric(),
    qvalue = numeric(),
    geneID = character(),
    Count = integer(),
    BackgroundTermGenes = numeric(),
    RichFactor = numeric(),
    stringsAsFactors = FALSE
  )
}

filter_enrichment_table <- function(df) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  if (!"p.adjust" %in% colnames(df)) {
    stop("Enrichment table is missing the required p.adjust column.")
  }
  
  df %>%
    dplyr::filter(
      is.finite(p.adjust),
      p.adjust < enrichment_padj_cutoff
    )
}

safe_enrich_go <- function(genes, universe) {
  result <- tryCatch(
    clusterProfiler::enrichGO(
      gene = genes,
      universe = universe,
      OrgDb = org.Mm.eg.db,
      keyType = "ENTREZID",
      ont = go_ontology,
      pAdjustMethod = "BH",
      pvalueCutoff = enrichment_padj_cutoff,
      qvalueCutoff = enrichment_padj_cutoff,
      readable = TRUE
    ),
    error = function(e) {
      structure(
        list(message = conditionMessage(e)),
        class = "go_enrichment_error"
      )
    }
  )
  
  if (inherits(result, "go_enrichment_error")) {
    warning("GO enrichment failed: ", result$message)
    return(
      list(
        object = NULL,
        query_status = "query_failed",
        attempts = 1L,
        error_message = result$message
      )
    )
  }
  
  list(
    object = result,
    query_status = "ok",
    attempts = 1L,
    error_message = NA_character_
  )
}

safe_enrich_kegg <- function(genes, universe) {
  old_timeout <- getOption("timeout")
  options(timeout = max(network_timeout_seconds, old_timeout))
  on.exit(options(timeout = old_timeout), add = TRUE)
  
  last_error <- NA_character_
  
  for (attempt in seq_len(network_retry_attempts)) {
    message(
      "KEGG enrichment query attempt ", attempt, "/",
      network_retry_attempts, "."
    )
    
    result <- tryCatch(
      clusterProfiler::enrichKEGG(
        gene = genes,
        universe = universe,
        organism = "mmu",
        keyType = "ncbi-geneid",
        pvalueCutoff = enrichment_padj_cutoff,
        pAdjustMethod = "BH",
        qvalueCutoff = enrichment_padj_cutoff
      ),
      error = function(e) {
        structure(
          list(message = conditionMessage(e)),
          class = "kegg_query_error"
        )
      }
    )
    
    if (!inherits(result, "kegg_query_error")) {
      if (nrow(as.data.frame(result)) > 0) {
        result <- tryCatch(
          clusterProfiler::setReadable(
            result,
            OrgDb = org.Mm.eg.db,
            keyType = "ENTREZID"
          ),
          error = function(e) {
            warning(
              "KEGG enrichment completed, but setReadable() failed: ",
              conditionMessage(e)
            )
            result
          }
        )
      }
      
      return(
        list(
          object = result,
          query_status = "ok",
          attempts = attempt,
          error_message = NA_character_
        )
      )
    }
    
    last_error <- result$message
    message("KEGG query attempt failed: ", last_error)
    
    if (attempt < network_retry_attempts) {
      Sys.sleep(network_retry_pause_seconds)
    }
  }
  
  warning(
    "KEGG enrichment query failed after ", network_retry_attempts,
    " attempts: ", last_error
  )
  
  list(
    object = NULL,
    query_status = "query_failed",
    attempts = network_retry_attempts,
    error_message = last_error
  )
}

