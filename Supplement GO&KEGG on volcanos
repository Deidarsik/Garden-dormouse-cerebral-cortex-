run_direction_enrichment <- function(
    analysis_label,
    contrast_name,
    direction,
    result_table,
    selected_mouse_col,
    selected_key_type,
    gene_annotations,
    universe_entrez,
    output_root) {
  
  if (!direction %in% c(
    "Increased_in_second_phase",
    "Decreased_in_second_phase"
  )) {
    stop(
      "Direction must be Increased_in_second_phase or ",
      "Decreased_in_second_phase."
    )
  }
  
  direction_folder <- ifelse(
    direction == "Increased_in_second_phase",
    "increased_in_second_phase",
    "decreased_in_second_phase"
  )
  
  direction_title <- ifelse(
    direction == "Increased_in_second_phase",
    "increased in second phase",
    "decreased in second phase"
  )
  
  contrast_label <- gsub("_vs_", "-", contrast_name)
  
  output_dir <- file.path(
    output_root,
    analysis_label,
    contrast_name,
    direction_folder
  )
  
  dir.create(
    output_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  result_core <- result_table %>%
    dplyr::select(
      dplyr::any_of(
        c(
          "GeneID", "logFC", "logCPM", "F", "PValue", "FDR"
        )
      )
    ) %>%
    dplyr::mutate(GeneID = as.character(GeneID)) %>%
    dplyr::distinct(GeneID, .keep_all = TRUE)
  
  annotation_columns <- unique(
    c(
      "GeneID",
      selected_mouse_col,
      intersect(
        c("Gene_name", "Mmu_gene_name", "Mmu_Gene_name"),
        colnames(gene_annotations)
      )
    )
  )
  
  annotated_results <- result_core %>%
    dplyr::left_join(
      gene_annotations %>%
        dplyr::select(dplyr::all_of(annotation_columns)),
      by = "GeneID"
    )
  
  if (nrow(annotated_results) != nrow(result_core)) {
    stop(
      "Annotation joining changed the row count for ",
      analysis_label, "/", contrast_name, "."
    )
  }
  
  significant_here <- annotated_results %>%
    dplyr::filter(
      FDR < enrichment_fdr_cutoff,
      if (direction == "Increased_in_second_phase") {
        logFC < 0
      } else {
        logFC > 0
      }
    ) %>%
    dplyr::distinct(GeneID, .keep_all = TRUE)
  
  # Save all direction-specific FDR-significant original genes before mapping.
  write.csv(
    significant_here,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_ALL_DEGs_before_mouse_mapping.csv"
      )
    ),
    row.names = FALSE
  )
  
  significant_long <- expand_identifier_column(
    significant_here,
    identifier_col = selected_mouse_col
  )
  
  significant_id_map <- map_mouse_identifiers(
    identifier_table = significant_long,
    from_type = selected_key_type
  )
  
  mapped_foreground <- significant_long %>%
    dplyr::inner_join(
      significant_id_map,
      by = "MouseInputOriginal",
      relationship = "many-to-many"
    ) %>%
    dplyr::filter(ENTREZID %in% universe_entrez) %>%
    dplyr::left_join(
      significant_here %>%
        dplyr::select(
          dplyr::any_of(
            c(
              "GeneID", "logFC", "logCPM", "F", "PValue", "FDR",
              "Gene_name", "Mmu_gene_name", "Mmu_Gene_name",
              selected_mouse_col
            )
          )
        ),
      by = "GeneID"
    ) %>%
    dplyr::distinct()
  
  # One-row-per-original-gene audit of all inclusion/exclusion decisions.
  valid_input_status <- significant_long %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(HasValidMouseInput = TRUE)
  
  mapped_status <- significant_long %>%
    dplyr::inner_join(
      significant_id_map,
      by = "MouseInputOriginal",
      relationship = "many-to-many"
    ) %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(MappedToMouseEntrez = TRUE)
  
  used_status <- mapped_foreground %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(UsedForEnrichment = TRUE)
  
  gene_flow_audit <- significant_here %>%
    dplyr::left_join(valid_input_status, by = "GeneID") %>%
    dplyr::left_join(mapped_status, by = "GeneID") %>%
    dplyr::left_join(used_status, by = "GeneID") %>%
    dplyr::mutate(
      HasValidMouseInput = tidyr::replace_na(HasValidMouseInput, FALSE),
      MappedToMouseEntrez = tidyr::replace_na(MappedToMouseEntrez, FALSE),
      UsedForEnrichment = tidyr::replace_na(UsedForEnrichment, FALSE),
      Status = dplyr::case_when(
        UsedForEnrichment ~ "Used for GO/KEGG",
        !HasValidMouseInput ~
          "Excluded: no valid mouse ortholog identifier",
        HasValidMouseInput & !MappedToMouseEntrez ~
          "Excluded: mouse identifier did not map to Entrez",
        MappedToMouseEntrez & !UsedForEnrichment ~
          "Excluded: mapped mouse Entrez absent from tested universe",
        TRUE ~ "Unknown"
      )
    ) %>%
    dplyr::arrange(Status, FDR, GeneID)
  
  write.csv(
    gene_flow_audit,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_AUDIT_every_DEG_to_enrichment.csv"
      )
    ),
    row.names = FALSE
  )
  
  mapped_foreground <- mapped_foreground %>%
    dplyr::arrange(MouseSymbol, ENTREZID, FDR, GeneID)
  
  write.csv(
    mapped_foreground,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_EXACT_usable_mouse_ortholog_genes.csv"
      )
    ),
    row.names = FALSE
  )
  
  foreground_entrez <- sort(unique(mapped_foreground$ENTREZID))
  
  write.csv(
    data.frame(ENTREZID = foreground_entrez),
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_EXACT_GO_KEGG_foreground_EntrezIDs.csv"
      )
    ),
    row.names = FALSE
  )
  
  writeLines(
    foreground_entrez,
    con = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_EXACT_GO_KEGG_foreground_EntrezIDs_one_per_line.txt"
      )
    )
  )
  
  cat("\n============================================================\n")
  cat(analysis_label, "\n")
  cat(contrast_name, "-", direction, "\n")
  cat(
    "FDR-significant original genes:",
    nrow(significant_here),
    "\n"
  )
  cat(
    "Original genes mapped and used:",
    dplyr::n_distinct(mapped_foreground$GeneID),
    "\n"
  )
  cat(
    "Unique mouse Entrez IDs submitted:",
    length(foreground_entrez),
    "\n"
  )
  
  # Always create output tables, even when there are no usable genes.
  # GO/KEGG tables are explicitly filtered to finite BH p.adjust < 0.01 (or the
  # configured enrichment_padj_cutoff) before they are written or plotted.
  if (length(foreground_entrez) == 0) {
    go_df <- empty_enrichment_table()
    kegg_df <- empty_enrichment_table()
    go_object <- NULL
    kegg_object <- NULL
    go_status <- "no_foreground_genes"
    kegg_status <- "no_foreground_genes"
    go_attempts <- 0L
    kegg_attempts <- 0L
    go_error_message <- NA_character_
    kegg_error_message <- NA_character_
  } else {
    if (!all(foreground_entrez %in% universe_entrez)) {
      stop(
        analysis_label, "/", contrast_name, "/", direction,
        " contains foreground IDs outside the tested universe."
      )
    }
    
    go_call <- safe_enrich_go(
      genes = foreground_entrez,
      universe = universe_entrez
    )
    
    kegg_call <- safe_enrich_kegg(
      genes = foreground_entrez,
      universe = universe_entrez
    )
    
    go_object <- go_call$object
    kegg_object <- kegg_call$object
    go_attempts <- go_call$attempts
    kegg_attempts <- kegg_call$attempts
    go_error_message <- go_call$error_message
    kegg_error_message <- kegg_call$error_message
    
    go_df <- if (is.null(go_object)) {
      empty_enrichment_table()
    } else {
      add_rich_factor(as.data.frame(go_object)) %>%
        filter_enrichment_table()
    }
    
    kegg_df <- if (is.null(kegg_object)) {
      empty_enrichment_table()
    } else {
      add_rich_factor(as.data.frame(kegg_object)) %>%
        filter_enrichment_table()
    }
    
    go_status <- if (go_call$query_status != "ok") {
      go_call$query_status
    } else if (nrow(go_df) == 0) {
      "no_significant_terms"
    } else {
      "ok"
    }
    
    kegg_status <- if (kegg_call$query_status != "ok") {
      kegg_call$query_status
    } else if (nrow(kegg_df) == 0) {
      "no_significant_terms"
    } else {
      "ok"
    }
  }
  
  write.csv(
    go_df,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_GO_BP_enrichment.csv"
      )
    ),
    row.names = FALSE
  )
  
  write.csv(
    kegg_df,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_KEGG_mouse_enrichment.csv"
      )
    ),
    row.names = FALSE
  )
  
  # GO RichFactor dotplot — same visual structure as the example.
  if (nrow(go_df) > 0 && "RichFactor" %in% colnames(go_df)) {
    top_go <- go_df %>%
      dplyr::arrange(dplyr::desc(RichFactor)) %>%
      utils::head(top_terms_to_plot) %>%
      add_rich_group()
    
    go_plot <- ggplot2::ggplot(
      top_go,
      ggplot2::aes(
        x = RichFactor,
        y = reorder(Description, RichFactor),
        color = RichGroup,
        size = Count
      )
    ) +
      ggplot2::geom_point(alpha = 0.9) +
      ggplot2::scale_color_manual(values = three_cols) +
      ggplot2::labs(
        title = paste0(
          contrast_label,
          " ",
          direction_title,
          ": GO Biological Process"
        ),
        x = "Rich Factor",
        y = "GO term",
        color = "Rich Factor",
        size = "Gene Count"
      ) +
      clean_theme
    
    ggplot2::ggsave(
      filename = file.path(
        output_dir,
        paste0(
          contrast_name,
          "_",
          direction_folder,
          "_GO_RichFactor_dotplot.pdf"
        )
      ),
      plot = go_plot,
      width = 8,
      height = 6
    )
  } else {
    if (identical(go_status, "query_failed")) {
      cat(
        contrast_name, " ", direction_title,
        ": GO query/analysis failed; empty CSV written.\n",
        sep = ""
      )
    } else {
      cat(
        contrast_name, " ", direction_title,
        ": no significant GO BP terms at BH FDR < ",
        enrichment_padj_cutoff, ".\n",
        sep = ""
      )
    }
  }
  
  # KEGG RichFactor barplot — same visual structure as the example.
  if (nrow(kegg_df) > 0 && "RichFactor" %in% colnames(kegg_df)) {
    top_kegg <- kegg_df %>%
      dplyr::arrange(dplyr::desc(RichFactor)) %>%
      utils::head(top_terms_to_plot) %>%
      add_rich_group()
    
    kegg_plot <- ggplot2::ggplot(
      top_kegg,
      ggplot2::aes(
        x = RichFactor,
        y = reorder(Description, RichFactor),
        fill = RichGroup
      )
    ) +
      ggplot2::geom_col(width = 0.75) +
      ggplot2::scale_fill_manual(values = three_cols) +
      ggplot2::labs(
        title = paste0(
          contrast_label,
          " ",
          direction_title,
          ": KEGG pathways"
        ),
        x = "Rich Factor",
        y = "KEGG pathway",
        fill = "Rich Factor"
      ) +
      clean_theme
    
    ggplot2::ggsave(
      filename = file.path(
        output_dir,
        paste0(
          contrast_name,
          "_",
          direction_folder,
          "_KEGG_RichFactor_barplot.pdf"
        )
      ),
      plot = kegg_plot,
      width = 8,
      height = 6
    )
  } else {
    if (identical(kegg_status, "query_failed")) {
      cat(
        contrast_name, " ", direction_title,
        ": KEGG query failed after retries; empty CSV written.\n",
        sep = ""
      )
    } else {
      cat(
        contrast_name, " ", direction_title,
        ": no significant KEGG pathways at BH FDR < ",
        enrichment_padj_cutoff, ".\n",
        sep = ""
      )
    }
  }
  
  summary_row <- data.frame(
    Analysis = analysis_label,
    Contrast = contrast_name,
    Direction = direction,
    FDR_cutoff = enrichment_fdr_cutoff,
    Enrichment_BH_padj_cutoff = enrichment_padj_cutoff,
    GO_status = go_status,
    KEGG_status = kegg_status,
    GO_query_attempts = go_attempts,
    KEGG_query_attempts = kegg_attempts,
    GO_error_message = go_error_message,
    KEGG_error_message = kegg_error_message,
    Significant_original_genes = nrow(significant_here),
    Original_genes_with_valid_mouse_input =
      dplyr::n_distinct(significant_long$GeneID),
    Original_genes_mapped_and_used =
      dplyr::n_distinct(mapped_foreground$GeneID),
    Unique_mouse_Entrez_foreground = length(foreground_entrez),
    Tested_mouse_Entrez_universe = length(universe_entrez),
    Significant_GO_BP_terms = nrow(go_df),
    Significant_KEGG_terms = nrow(kegg_df),
    stringsAsFactors = FALSE
  )
  
  list(
    summary = summary_row,
    all_significant_original_genes = significant_here,
    audit = gene_flow_audit,
    exact_mapped_foreground = mapped_foreground,
    foreground_entrez = foreground_entrez,
    GO_object = go_object,
    GO_table = go_df,
    KEGG_object = kegg_object,
    KEGG_table = kegg_df
  )
}

# =============================================================================
# 8. RUN ALL REQUESTED ANALYSES, CONTRASTS, AND DIRECTIONS
# =============================================================================

all_enrichment_results <- list()
summary_rows <- list()
summary_counter <- 1L

for (analysis_key in names(analysis_registry)) {
  analysis_label <- analysis_registry[[analysis_key]]$label
  results_list <- analysis_registry[[analysis_key]]$results_list
  
  all_enrichment_results[[analysis_key]] <- list()
  
  for (contrast_name in names(results_list)) {
    all_enrichment_results[[analysis_key]][[contrast_name]] <- list()
    
    for (direction in c(
      "Increased_in_second_phase",
      "Decreased_in_second_phase"
    )) {
      result_here <- run_direction_enrichment(
        analysis_label = analysis_label,
        contrast_name = contrast_name,
        direction = direction,
        result_table = results_list[[contrast_name]],
        selected_mouse_col = selected_mouse_col,
        selected_key_type = selected_key_type,
        gene_annotations = gene_annotations,
        universe_entrez = universe_entrez,
        output_root = enrichment_output_root
      )
      
      direction_key <- ifelse(
        direction == "Increased_in_second_phase",
        "increased_in_second_phase",
        "decreased_in_second_phase"
      )
      
      all_enrichment_results[[analysis_key]][[contrast_name]][[direction_key]] <-
        result_here
      
      summary_rows[[summary_counter]] <- result_here$summary
      summary_counter <- summary_counter + 1L
    }
  }
}

enrichment_summary <- dplyr::bind_rows(summary_rows)

# Manuscript-facing summary contains SEX-ADJUSTED enrichment only, even if the
# optional unadjusted enrichment comparison was enabled.
reported_enrichment_summary <- enrichment_summary %>%
  dplyr::filter(Analysis == "Filtered_robust_sex_adjusted")

write.csv(
  reported_enrichment_summary,
  file = file.path(
    enrichment_output_root,
    "GO_KEGG_transition_direction_all_contrasts_summary.csv"
  ),
  row.names = FALSE
)

write.table(
  reported_enrichment_summary,
  file = file.path(
    enrichment_output_root,
    "GO_KEGG_transition_direction_all_contrasts_summary.txt"
  ),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

if (any(enrichment_summary$Analysis == "Filtered_robust_unadjusted")) {
  optional_unadjusted_enrichment_summary <- enrichment_summary %>%
    dplyr::filter(Analysis == "Filtered_robust_unadjusted")
  
  write.csv(
    optional_unadjusted_enrichment_summary,
    file = file.path(
      enrichment_output_root,
      "OPTIONAL_unadjusted_GO_KEGG_comparison_summary.csv"
    ),
    row.names = FALSE
  )
}

saveRDS(
  list(
    all_enrichment_results = all_enrichment_results,
    reported_sex_adjusted_summary = reported_enrichment_summary,
    all_requested_summary = enrichment_summary,
