is_valid_identifier <- function(x) {
  x <- trimws(as.character(x))
  
  !is.na(x) &
    x != "" &
    !(x %in% c(
      "-", ".", "NA", "na", "N/A", "n/a",
      "None", "none", "NULL", "null",
      "No", "no", "FALSE", "False", "false", "?"
    ))
}

find_column_case_insensitive <- function(df, requested_name) {
  hit <- which(tolower(colnames(df)) == tolower(requested_name))
  
  if (length(hit) == 0) {
    return(NA_character_)
  }
  
  colnames(df)[hit[1]]
}

normalise_mouse_identifier <- function(x, key_type) {
  x <- trimws(as.character(x))
  
  # Remove Ensembl version suffixes, for example ENSMUSG... .12.
  if (identical(key_type, "ENSEMBL")) {
    x <- sub("\\.[0-9]+$", "", x)
  }
  
  x
}

expand_identifier_column <- function(df, identifier_col) {
  if (!"GeneID" %in% colnames(df)) {
    stop("expand_identifier_column(): GeneID column is missing.")
  }
  
  if (!identifier_col %in% colnames(df)) {
    stop(
      "Identifier column not found: ", identifier_col,
      ". Available columns: ",
      paste(colnames(df), collapse = ", ")
    )
  }
  
  df %>%
    dplyr::transmute(
      GeneID = as.character(GeneID),
      MouseInputOriginal = as.character(.data[[identifier_col]])
    ) %>%
    dplyr::filter(is_valid_identifier(MouseInputOriginal)) %>%
    tidyr::separate_rows(
      MouseInputOriginal,
      sep = "\\s*[,;|]+\\s*"
    ) %>%
    dplyr::mutate(
      MouseInputOriginal = trimws(MouseInputOriginal)
    ) %>%
    dplyr::filter(is_valid_identifier(MouseInputOriginal)) %>%
    dplyr::distinct()
}

map_mouse_identifiers <- function(identifier_table, from_type) {
  empty_result <- data.frame(
    MouseInputOriginal = character(),
    MouseInput = character(),
    ENTREZID = character(),
    MouseSymbol = character(),
    stringsAsFactors = FALSE
  )
  
  if (nrow(identifier_table) == 0) {
    return(empty_result)
  }
  
  supported_keytypes <- AnnotationDbi::keytypes(org.Mm.eg.db)
  
  if (!from_type %in% supported_keytypes) {
    stop(
      "Key type '", from_type,
      "' is not supported by org.Mm.eg.db.\nSupported key types include:\n",
      paste(supported_keytypes, collapse = ", ")
    )
  }
  
  lookup <- identifier_table %>%
    dplyr::transmute(
      MouseInputOriginal,
      MouseInput = normalise_mouse_identifier(
        MouseInputOriginal,
        from_type
      )
    ) %>%
    dplyr::filter(is_valid_identifier(MouseInput)) %>%
    dplyr::distinct()
  
  if (nrow(lookup) == 0) {
    return(empty_result)
  }
  
  mapped <- tryCatch(
    suppressMessages(
      AnnotationDbi::select(
        org.Mm.eg.db,
        keys = unique(lookup$MouseInput),
        keytype = from_type,
        columns = unique(c("ENTREZID", "SYMBOL"))
      )
    ),
    error = function(e) {
      warning(
        "Mouse identifier mapping failed for key type ",
        from_type,
        ": ",
        conditionMessage(e)
      )
      NULL
    }
  )
  
  if (is.null(mapped) || nrow(mapped) == 0) {
    return(empty_result)
  }
  
  mapped_df <- data.frame(
    MouseInput = as.character(mapped[[from_type]]),
    ENTREZID = as.character(mapped$ENTREZID),
    MouseSymbol = as.character(mapped$SYMBOL),
    stringsAsFactors = FALSE
  ) %>%
    dplyr::filter(
      is_valid_identifier(MouseInput),
      is_valid_identifier(ENTREZID)
    ) %>%
    dplyr::distinct()
  
  lookup %>%
    dplyr::inner_join(mapped_df, by = "MouseInput") %>%
    dplyr::distinct()
}

add_rich_factor <- function(df) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  required_cols <- c("Count", "BgRatio")
  
  if (!all(required_cols %in% colnames(df))) {
    return(df)
  }
  
  df %>%
    dplyr::mutate(
      BackgroundTermGenes = as.numeric(sub("/.*", "", BgRatio)),
      RichFactor = Count / BackgroundTermGenes
    )
}

add_rich_group <- function(df) {
  if (nrow(df) == 0 || !"RichFactor" %in% colnames(df)) {
    return(df)
  }
  
  rich_breaks <- stats::quantile(
    df$RichFactor,
    probs = c(0, 1 / 3, 2 / 3, 1),
    na.rm = TRUE
  )
  
  if (length(unique(rich_breaks)) == 4) {
    return(
      df %>%
        dplyr::mutate(
          RichGroup = cut(
            RichFactor,
            breaks = rich_breaks,
            include.lowest = TRUE,
            labels = c("Low", "Medium", "High")
          )
        )
    )
  }
  
  distinct_values <- sort(unique(df$RichFactor))
  
  if (length(distinct_values) == 1) {
    df$RichGroup <- factor(
      rep("Low", nrow(df)),
      levels = c("Low", "Medium", "High")
    )
  } else if (length(distinct_values) == 2) {
    df$RichGroup <- factor(
      ifelse(
        df$RichFactor == min(distinct_values),
        "Low",
        "High"
      ),
      levels = c("Low", "Medium", "High")
    )
  } else {
    df$RichGroup <- factor(
      c("Low", "Medium", "High")[
        dplyr::ntile(
          rank(df$RichFactor, ties.method = "first"),
          3
        )
      ],
      levels = c("Low", "Medium", "High")
    )
  }
  
  df
}

