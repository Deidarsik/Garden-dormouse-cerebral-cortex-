get_tested_gene_set <- function(analysis_object, analysis_label) {
  tested_sets <- lapply(
    analysis_object$results_list,
    function(x) sort(unique(as.character(x$GeneID)))
  )
  
  reference_set <- tested_sets[[1]]
  
  if (!all(vapply(
    tested_sets,
    function(x) identical(x, reference_set),
    FUN.VALUE = logical(1)
  ))) {
    stop(
      "Tested-gene sets differ among contrasts within ", analysis_label, "."
    )
  }
  
  reference_set
}

