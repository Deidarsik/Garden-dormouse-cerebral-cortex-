# Two-sided Fisher tests compare the proportion with a non-empty Target_gene
# assignment among upregulated versus downregulated sex-adjusted DEGs.
# BH correction is applied across the testable contrasts and interpreted at 0.01.
ortholog_fisher_rows <- lapply(
  contrast_order,
  function(contrast_name) {
    i <- match(contrast_name, contrast_order)
    up_total <- sex_adjusted_up[i]
    down_total <- sex_adjusted_down[i]
    up_orth <- upregulated_ortholog_counts[i]
    down_orth <- downregulated_ortholog_counts[i]
    
    if (up_total == 0L || down_total == 0L) {
      return(
        data.frame(
          Contrast = contrast_name,
          Upregulated_DEGs = up_total,
          Upregulated_with_1to1_mouse_ortholog = up_orth,
          Downregulated_DEGs = down_total,
          Downregulated_with_1to1_mouse_ortholog = down_orth,
          Fisher_odds_ratio = NA_real_,
          Fisher_p_value = NA_real_,
          Test_status = "not_testable_empty_direction",
          stringsAsFactors = FALSE
        )
      )
    }
    
    fisher_matrix <- matrix(
      c(
        up_orth,
        up_total - up_orth,
        down_orth,
        down_total - down_orth
      ),
      nrow = 2,
      byrow = TRUE,
      dimnames = list(
        Direction = c("Upregulated", "Downregulated"),
        Mouse_1to1_ortholog = c("Assigned", "Not_assigned")
      )
    )
    
    fisher_result <- stats::fisher.test(
      fisher_matrix,
      alternative = "two.sided"
    )
    
    data.frame(
      Contrast = contrast_name,
      Upregulated_DEGs = up_total,
      Upregulated_with_1to1_mouse_ortholog = up_orth,
      Downregulated_DEGs = down_total,
      Downregulated_with_1to1_mouse_ortholog = down_orth,
      Fisher_odds_ratio = unname(fisher_result$estimate),
      Fisher_p_value = fisher_result$p.value,
      Test_status = "ok",
      stringsAsFactors = FALSE
    )
  }
)

ortholog_fisher_results <- dplyr::bind_rows(ortholog_fisher_rows)
ortholog_fisher_results$Fisher_BH_adjusted_p_value <- NA_real_

testable_fisher <- is.finite(ortholog_fisher_results$Fisher_p_value)
ortholog_fisher_results$Fisher_BH_adjusted_p_value[testable_fisher] <-
  stats::p.adjust(
    ortholog_fisher_results$Fisher_p_value[testable_fisher],
    method = "BH"
  )

ortholog_fisher_results$Significant_at_BH_FDR_0.01 <-
