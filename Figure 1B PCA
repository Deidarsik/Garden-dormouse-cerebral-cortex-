suppressPackageStartupMessages({
  library(edgeR)
  library(ggplot2)
})

# =============================================================================
# 1. INPUT AND OUTPUT FILES
# =============================================================================

count_file <- "/Users/adrian/Desktop/reprex/20251016_merged_Cortex_0FPM.txt"
sample_file <- "/Users/adrian/Desktop/reprex/20251016_merged_Cortex_samples.txt"

output_dir <- "/Users/adrian/Desktop/reprex/Cortex_PCA_only_output"

dir.create(
  output_dir,
  recursive = TRUE,
  showWarnings = FALSE
)

stopifnot(file.exists(count_file))
stopifnot(file.exists(sample_file))

cat("\nCount file:\n", normalizePath(count_file), "\n", sep = "")
cat("Count-file MD5: ", unname(tools::md5sum(count_file)), "\n", sep = "")

cat("\nMetadata file:\n", normalizePath(sample_file), "\n", sep = "")
cat("Metadata-file MD5: ", unname(tools::md5sum(sample_file)), "\n", sep = "")

# =============================================================================
# 2. PHASE LABELS
# =============================================================================

phase_map <- c(
  "SE" = "summer euthermia",
  "TE" = "torpor (early)",
  "TL" = "torpor (late)",
  "AE" = "arousal (early)",
  "AL" = "arousal (late)"
)

ordered_phases <- c(
  "summer euthermia",
  "arousal (early)",
  "arousal (late)",
  "torpor (early)",
  "torpor (late)"
)

phase_cols <- c(
  "summer euthermia" = "#BFD7EA",
  "arousal (early)"  = "#C7E9C0",
  "arousal (late)"   = "#FDDDB6",
  "torpor (early)"   = "#08519C",
  "torpor (late)"    = "#54278F"
)

# =============================================================================
# 3. READ COUNT MATRIX
# =============================================================================

counts <- read.table(
  count_file,
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = ""
)

if (!"Gene" %in% colnames(counts)) {
  stop("The count file must contain a column named 'Gene'.")
}

rownames(counts) <- counts$Gene
counts$Gene <- NULL

if (any(counts %% 1 != 0, na.rm = TRUE)) {
  message("Non-integer counts detected; rounding to nearest integer.")
  counts <- round(as.matrix(counts))
} else {
  counts <- as.matrix(counts)
}

storage.mode(counts) <- "numeric"

if (anyNA(counts)) {
  stop("The count matrix contains missing or non-numeric values.")
}

# =============================================================================
# 4. READ AND ALIGN METADATA
# =============================================================================

meta_raw <- read.table(
  sample_file,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  quote = ""
)

required_columns <- c(
  "Sample",
  "Animal",
  "Tissue",
  "Group",
  "Sex"
)

missing_columns <- setdiff(
  required_columns,
  colnames(meta_raw)
)

if (length(missing_columns) > 0) {
  stop(
    "Metadata is missing required columns: ",
    paste(missing_columns, collapse = ", ")
  )
}

idx <- match(
  colnames(counts),
  meta_raw$Sample
)

if (anyNA(idx)) {
  stop(
    "These count columns are absent from metadata: ",
    paste(
      colnames(counts)[is.na(idx)],
      collapse = ", "
    )
  )
}

meta <- meta_raw[
  idx,
  ,
  drop = FALSE
]

rownames(meta) <- meta$Sample

if (!identical(colnames(counts), rownames(meta))) {
  stop("Count columns and metadata rows are not identically ordered.")
}

if (any(meta$Tissue != "Cortex", na.rm = TRUE)) {
  stop(
    "Non-Cortex samples are present: ",
    paste(unique(meta$Tissue), collapse = ", ")
  )
}

# Group stays coded as SE, TE, TL, AE, and AL.
# phase is the separate descriptive plotting variable.
meta$phase <- phase_map[meta$Group]

if (anyNA(meta$phase)) {
  stop(
    "These Group values could not be mapped: ",
    paste(unique(meta$Group[is.na(meta$phase)]), collapse = ", ")
  )
}

meta$phase <- factor(
  meta$phase,
  levels = ordered_phases
)

meta$sex <- ifelse(
  toupper(meta$Sex) == "M",
  "male",
  "female"
)

meta$sex <- factor(
  meta$sex,
  levels = c("male", "female")
)

cat("\nGroup values:\n")
print(unique(meta$Group))

cat("\nMapped phase values:\n")
print(unique(meta$phase))

cat("\nCount/metadata alignment:\n")
print(identical(colnames(counts), rownames(meta)))

# =============================================================================
# 5. FILTERING AND NORMALISATION
# =============================================================================

dge <- DGEList(
  counts = counts
)

keep <- filterByExpr(
  dge,
  group = meta$phase
)

dge <- dge[
  keep,
  ,
  keep.lib.sizes = FALSE
]

dge <- calcNormFactors(
  dge,
  method = "TMM"
)

logCPM <- cpm(
  dge,
  log = TRUE,
  prior.count = 1
)

cat(
  "\nGenes before filterByExpr: ",
  nrow(counts),
  "\n",
  sep = ""
)

cat(
  "Genes after filterByExpr: ",
  nrow(logCPM),
  "\n",
  sep = ""
)

# =============================================================================
# 6. PCA
# =============================================================================

pca_res <- prcomp(
  t(logCPM),
  center = TRUE,
  scale. = TRUE
)

variance_fraction <- (
  pca_res$sdev^2
) / sum(
  pca_res$sdev^2
)

variance_percent <- 100 * variance_fraction
variance_labels <- sprintf("%.2f", variance_percent)

score_df <- as.data.frame(
  pca_res$x
)

score_df$sample <- meta$Sample
score_df$animal <- meta$Animal
score_df$group  <- meta$Group
score_df$phase  <- meta$phase
score_df$sex    <- meta$sex

cat(
  "PC1 variance explained: ",
  variance_labels[1],
  "%\n",
  sep = ""
)

cat(
  "PC2 variance explained: ",
  variance_labels[2],
  "%\n",
  sep = ""
)

cat(
  "PC1 + PC2 variance explained: ",
  sprintf("%.2f", sum(variance_percent[1:2])),
  "%\n",
  sep = ""
)

# =============================================================================
# 7. PC1-VERSUS-PC2 PLOT
# =============================================================================

x_range <- range(
  score_df$PC1,
  na.rm = TRUE
)

y_range <- range(
  score_df$PC2,
  na.rm = TRUE
)

x_mid <- mean(x_range)
y_mid <- mean(y_range)

final_span <- max(
  diff(x_range),
  diff(y_range)
) * 1.10

if (!is.finite(final_span) || final_span == 0) {
  final_span <- 1
}

x_limits <- x_mid + c(
  -final_span / 2,
  final_span / 2
)

y_limits <- y_mid + c(
  -final_span / 2,
  final_span / 2
)

pca_plot <- ggplot(
  score_df,
  aes(
    x = PC1,
    y = PC2
  )
) +
  geom_point(
    aes(
      colour = phase,
      shape = sex
    ),
    size = 5,
    alpha = 0.9,
    stroke = 1.1
  ) +
  scale_colour_manual(
    values = phase_cols,
    breaks = ordered_phases,
    drop = FALSE
  ) +
  scale_shape_manual(
    values = c(
      "male" = 16,
      "female" = 17
    ),
    drop = FALSE
  ) +
  coord_fixed(
    ratio = 1,
    xlim = x_limits,
    ylim = y_limits
  ) +
  labs(
    x = paste0(
      "PC1 (",
      variance_labels[1],
      "%)"
    ),
    y = paste0(
      "PC2 (",
      variance_labels[2],
      "%)"
    ),
    colour = "Hibernation phase",
    shape = "Sex"
  ) +
  theme_minimal(
    base_size = 18,
    base_family = "Helvetica"
  ) +
  theme(
    axis.title = element_text(size = 18),
    axis.text = element_text(size = 13),
    legend.title = element_text(size = 14),
    legend.text = element_text(size = 12),
    panel.grid.major = element_line(
      colour = "#d9d9d9",
      linewidth = 0.5
    ),
    panel.grid.minor = element_blank(),
    axis.line = element_line(colour = "black"),
    panel.border = element_rect(
      colour = "black",
      fill = NA,
      linewidth = 0.8
    )
  )

print(pca_plot)

ggsave(
  filename = file.path(
    output_dir,
    "Cortex_PCA_PC1_vs_PC2.png"
  ),
  plot = pca_plot,
  width = 8,
  height = 6,
  dpi = 300,
  bg = "white"
)

ggsave(
  filename = file.path(
    output_dir,
    "Cortex_PCA_PC1_vs_PC2.pdf"
  ),
  plot = pca_plot,
  width = 8,
  height = 6,
  bg = "white"
)

write.table(
  score_df,
  file = file.path(
    output_dir,
    "PCA_sample_scores.tsv"
  ),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

write.table(
  data.frame(
    PC = paste0(
      "PC",
      seq_along(variance_percent)
    ),
    Variance_percent = variance_percent
  ),
  file = file.path(
    output_dir,
    "PCA_variance_explained.tsv"
  ),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

writeLines(
  capture.output(sessionInfo()),
  con = file.path(
    output_dir,
    "sessionInfo.txt"
  )
)

cat(
  "\nPCA outputs written to:\n",
  normalizePath(output_dir),
  "\n",
  sep = ""
)
