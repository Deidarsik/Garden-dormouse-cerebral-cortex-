  data.frame(Excluded_Equ03_ID = equ_genes),
  file = file.path(outdir, "excluded_Equ03_genes.csv"),
  row.names = FALSE
)

write.csv(
  data.frame(MouseSymbolSubmitted = genes),
  file = file.path(outdir, "mouse_symbols_submitted.csv"),
  row.names = FALSE
)

# ----------------------------
# 4) Direct SYMBOL-to-Entrez mapping
# ----------------------------

direct_map <- suppressMessages(
  bitr(
    genes,
    fromType = "SYMBOL",
    toType   = "ENTREZID",
    OrgDb    = org.Mm.eg.db
  )
)

if (is.null(direct_map) || nrow(direct_map) == 0) {
  direct_map_clean <- data.frame(
    InputSymbol = character(),
    MouseSymbol = character(),
    ENTREZID    = character(),
    MappingType = character()
  )
} else {
  direct_map_clean <- direct_map %>%
    transmute(
      InputSymbol = SYMBOL,
      MouseSymbol = SYMBOL,
      ENTREZID    = as.character(ENTREZID),
      MappingType = "Direct SYMBOL"
    )
}

directly_mapped <- unique(direct_map_clean$InputSymbol)

unmapped_after_symbol <- setdiff(
  genes,
  directly_mapped
)

# ----------------------------
# 5) Attempt alias mapping
# ----------------------------

if (length(unmapped_after_symbol) > 0) {

  alias_map <- suppressMessages(
    AnnotationDbi::select(
      org.Mm.eg.db,
      keys    = unmapped_after_symbol,
      keytype = "ALIAS",
      columns = c("SYMBOL", "ENTREZID")
    )
  )

  alias_map_clean <- alias_map %>%
    filter(
      !is.na(ENTREZID),
      !is.na(SYMBOL)
    ) %>%
    transmute(
      InputSymbol = ALIAS,
      MouseSymbol = SYMBOL,
      ENTREZID    = as.character(ENTREZID),
      MappingType = "Mouse alias"
    )

} else {

  alias_map_clean <- data.frame(
    InputSymbol = character(),
    MouseSymbol = character(),
    ENTREZID    = character(),
    MappingType = character()
  )
}

# Combine direct and alias mappings
gene_map <- bind_rows(
  direct_map_clean,
  alias_map_clean
) %>%
  distinct(
    InputSymbol,
    MouseSymbol,
    ENTREZID,
    .keep_all = TRUE
  )

mapped_input_symbols <- unique(gene_map$InputSymbol)

unmapped <- setdiff(
  genes,
  mapped_input_symbols
)

entrez_ids <- unique(gene_map$ENTREZID)

