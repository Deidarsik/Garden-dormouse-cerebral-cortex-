paired_results <- te_tl %>%
  dplyr::select(
    GeneID,
    logFC_TE_TL = logFC,
    logCPM_TE_TL = logCPM,
    F_TE_TL = F,
    PValue_TE_TL = PValue,
    FDR_TE_TL = FDR
  ) %>%
  dplyr::inner_join(
    tl_ae %>%
      dplyr::select(
        GeneID,
        logFC_TL_AE = logFC,
        logCPM_TL_AE = logCPM,
        F_TL_AE = F,
        PValue_TL_AE = PValue,
        FDR_TL_AE = FDR
      ),
    by = "GeneID"
  )

shared_significant <- paired_results %>%
  dplyr::filter(
    FDR_TE_TL < fdr_cutoff,
    FDR_TL_AE < fdr_cutoff
  ) %>%
  dplyr::mutate(
    ReversalClass = dplyr::case_when(
      logFC_TE_TL < 0 & logFC_TL_AE > 0 ~
        "torpor_upregulated_increased_TE_to_TL_then_decreased_TL_to_AE",
      
      logFC_TE_TL > 0 & logFC_TL_AE < 0 ~
        "torpor_downregulated_decreased_TE_to_TL_then_increased_TL_to_AE",
      
      TRUE ~
        "Same_direction_or_zero"
    )
  )

opposite_direction <- shared_significant %>%
  dplyr::filter(
    ReversalClass != "Same_direction_or_zero"
  )

torpor_upregulated_class <- opposite_direction %>%
  dplyr::filter(
    ReversalClass ==
      "torpor_upregulated_increased_TE_to_TL_then_decreased_TL_to_AE"
