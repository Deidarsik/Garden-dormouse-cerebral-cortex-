# =============================================================================
# 6. PRIMARY FILTERED ROBUST SEX-ADJUSTED edgeR ANALYSIS
# =============================================================================

dge <- edgeR::DGEList(
  counts = expression_matrix,
  group = metadata$Group
)

genes_before_filtering <- nrow(dge)

keep <- edgeR::filterByExpr(
  dge,
  group = metadata$Group
)

dge <- dge[
  keep,
  ,
  keep.lib.sizes = FALSE
]

dge <- edgeR::normLibSizes(dge)

genes_after_filtering <- nrow(dge)

cat("\nLOW-EXPRESSION FILTERING\n")
cat("Genes before filtering:", genes_before_filtering, "\n")
cat("Genes retained:", genes_after_filtering, "\n")

if (
  strict_expected_counts &&
  genes_after_filtering != expected_filtered_genes
) {
  stop(
    "Expected ", expected_filtered_genes,
    " filtered/tested genes, but obtained ",
    genes_after_filtering,
    ". Check that the same counts, metadata, and filtering pipeline are used."
  )
}

design <- model.matrix(
  ~ 0 + Group + Sex,
  data = metadata
)

colnames(design) <- sub(
  "^Group",
  "",
  colnames(design)
)

if (qr(design)$rank < ncol(design)) {
  stop(
    "The sex-adjusted design matrix (~ 0 + Group + Sex) is not full rank. ",
    "Check whether Sex is confounded with Group or whether metadata levels are invalid."
  )
}

required_group_coefficients <- c("TE", "TL", "AE")
missing_group_coefficients <- setdiff(
  required_group_coefficients,
  colnames(design)
)

if (length(missing_group_coefficients) > 0) {
  stop(
    "The sex-adjusted design is missing coefficients required for the contrasts: ",
    paste(missing_group_coefficients, collapse = ", "),
    ". Design columns are: ",
    paste(colnames(design), collapse = ", ")
  )
}

contrast_matrix <- tryCatch(
  limma::makeContrasts(
    TE_vs_TL = TE - TL,
    TL_vs_AE = TL - AE,
    levels = design
  ),
  error = function(e) {
    stop(
      "Failed to construct TE_vs_TL and TL_vs_AE contrasts from the ",
      "sex-adjusted design. Design columns: ",
      paste(colnames(design), collapse = ", "),
      ". Original error: ",
      conditionMessage(e)
    )
  }
)

dge <- edgeR::estimateDisp(
  dge,
  design,
  robust = TRUE
)

fit <- edgeR::glmQLFit(
  dge,
  design,
  robust = TRUE
)

extract_contrast <- function(contrast_name) {
  qlf <- edgeR::glmQLFTest(
    fit,
    contrast = contrast_matrix[, contrast_name]
  )
  
  result <- edgeR::topTags(
    qlf,
    n = Inf,
    sort.by = "none"
  )$table
  
  result <- data.frame(
    GeneID = rownames(result),
    result,
    row.names = NULL,
    check.names = FALSE,
    stringsAsFactors = FALSE
  )
  
  result %>%
    dplyr::distinct(
      GeneID,
      .keep_all = TRUE
    )
}

te_tl <- extract_contrast("TE_vs_TL")
tl_ae <- extract_contrast("TL_vs_AE")

