cat("Unique Entrez IDs obtained:      ",
    length(entrez_ids), "\n")
cat("Symbols still unmapped:          ",
    length(unmapped), "\n\n")

if (length(unmapped) > 0) {
  cat("Unmapped symbols:\n")
  print(unmapped)
}

write.csv(
  gene_map,
  file = file.path(outdir, "mouse_symbol_to_entrez_mapping.csv"),
  row.names = FALSE
)

write.csv(
  data.frame(UnmappedSymbol = unmapped),
  file = file.path(outdir, "unmapped_mouse_symbols.csv"),
  row.names = FALSE
)

if (length(entrez_ids) == 0) {
  stop(
    "No genes mapped to mouse Entrez IDs. Enrichment cannot be performed."
  )
}

# ----------------------------
# 7) GO Biological Process enrichment
# ----------------------------

ego <- enrichGO(
  gene          = entrez_ids,
  OrgDb         = org.Mm.eg.db,
  keyType       = "ENTREZID",
  ont           = "BP",
  pAdjustMethod = "BH",
  pvalueCutoff  = 0.05,
  qvalueCutoff  = 0.10,
  readable      = TRUE
)

if (is.null(ego)) {
  ego_df <- data.frame()
} else {
  ego_df <- as.data.frame(ego)
}

if (nrow(ego_df) > 0) {

  # Numerator of BgRatio is the number of background genes
  # annotated to that GO term.
  ego_df$BgTermSize <- as.numeric(
    sub("/.*", "", ego_df$BgRatio)
  )

  ego_df$RichFactor <- ego_df$Count / ego_df$BgTermSize
}

# ----------------------------
# 8) KEGG mouse pathway enrichment
# ----------------------------

ekegg <- enrichKEGG(
  gene          = entrez_ids,
  organism      = "mmu",
  pAdjustMethod = "BH",
  pvalueCutoff  = 0.05,
  qvalueCutoff  = 0.10
)

if (!is.null(ekegg) && nrow(as.data.frame(ekegg)) > 0) {

  ekegg <- setReadable(
    ekegg,
    OrgDb   = org.Mm.eg.db,
    keyType = "ENTREZID"
  )

  ekegg_df <- as.data.frame(ekegg)

  ekegg_df$ID <- sub(
    "^mmu",
    "",
    ekegg_df$ID
  )

  ekegg_df$BgTermSize <- as.numeric(
    sub("/.*", "", ekegg_df$BgRatio)
  )

  ekegg_df$RichFactor <- (
    ekegg_df$Count / ekegg_df$BgTermSize
  )

} else {

  ekegg_df <- data.frame()
}

