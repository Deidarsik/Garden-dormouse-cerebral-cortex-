is_valid_identifier <- function(x) {
  x <- trimws(as.character(x))
  
  !is.na(x) &
    x != "" &
    !(x %in% c(
      "-", ".", "NA", "na", "N/A", "n/a",
      "None", "none", "NULL", "null",
      "No", "no", "FALSE", "False", "false", "?"
    ))
}

normalise_mouse_identifier <- function(x, key_type) {
  x <- trimws(as.character(x))
  
  if (identical(key_type, "ENSEMBL")) {
    x <- sub("\\.[0-9]+$", "", x)
  }
  
  x
}

expand_mouse_identifiers <- function(df, identifier_col) {
  if (!all(c("GeneID", identifier_col) %in% colnames(df))) {
    stop(
      "expand_mouse_identifiers(): required columns are missing. ",
      "Required: GeneID and ", identifier_col
    )
  }
  
  df %>%
    dplyr::transmute(
      GeneID = as.character(GeneID),
      MouseInputOriginal = as.character(.data[[identifier_col]])
    ) %>%
    dplyr::filter(is_valid_identifier(MouseInputOriginal)) %>%
    tidyr::separate_rows(
      MouseInputOriginal,
      sep = "\\s*[,;|]+\\s*"
    ) %>%
    dplyr::mutate(
      MouseInputOriginal = trimws(MouseInputOriginal),
      MouseInput = normalise_mouse_identifier(
        MouseInputOriginal,
        mouse_key_type
      )
    ) %>%
    dplyr::filter(
      is_valid_identifier(MouseInputOriginal),
      is_valid_identifier(MouseInput)
    ) %>%
    dplyr::distinct()
}

map_mouse_identifiers <- function(identifier_long, from_type) {
  empty_result <- data.frame(
    MouseInput = character(),
    ENTREZID = character(),
    MouseSymbol = character(),
    stringsAsFactors = FALSE
  )
  
  if (nrow(identifier_long) == 0) {
    return(empty_result)
  }
  
  supported_keytypes <- AnnotationDbi::keytypes(org.Mm.eg.db)
  
  if (!from_type %in% supported_keytypes) {
    stop(
      "Key type '", from_type,
      "' is not supported by org.Mm.eg.db."
    )
  }
  
  keys_here <- unique(identifier_long$MouseInput)
  keys_here <- keys_here[is_valid_identifier(keys_here)]
  
  if (length(keys_here) == 0) {
    return(empty_result)
  }
  
  mapped <- tryCatch(
    suppressMessages(
      AnnotationDbi::select(
        org.Mm.eg.db,
        keys = keys_here,
        keytype = from_type,
        columns = c("ENTREZID", "SYMBOL")
      )
    ),
    error = function(e) {
      warning(
        "Mouse identifier mapping failed: ",
        conditionMessage(e)
      )
      NULL
    }
  )
  
  if (is.null(mapped) || nrow(mapped) == 0) {
    return(empty_result)
  }
  
  data.frame(
    MouseInput = as.character(mapped[[from_type]]),
    ENTREZID = as.character(mapped$ENTREZID),
    MouseSymbol = as.character(mapped$SYMBOL),
    stringsAsFactors = FALSE
  ) %>%
    dplyr::filter(
      is_valid_identifier(MouseInput),
      is_valid_identifier(ENTREZID)
    ) %>%
    dplyr::distinct()
}

empty_enrichment_table <- function() {
  data.frame(
    ID = character(),
    Description = character(),
    GeneRatio = character(),
    BgRatio = character(),
    pvalue = numeric(),
    p.adjust = numeric(),
    qvalue = numeric(),
    geneID = character(),
    Count = integer(),
    BackgroundTermGenes = numeric(),
    RichFactor = numeric(),
    stringsAsFactors = FALSE
  )
}

add_rich_factor <- function(df) {
  if (
    nrow(df) == 0 ||
    !all(c("Count", "BgRatio") %in% colnames(df))
  ) {
    return(df)
  }
  
  df %>%
    dplyr::mutate(
      BackgroundTermGenes = as.numeric(
        sub("/.*", "", BgRatio)
      ),
      RichFactor = Count / BackgroundTermGenes
    )
}

filter_enrichment_by_adjusted_p <- function(df, label) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  if (!"p.adjust" %in% colnames(df)) {
    stop(
      label,
      " enrichment table is missing the required p.adjust column."
    )
  }
  
  df %>%
    dplyr::filter(
      is.finite(p.adjust),
      p.adjust < 0.01
    )
}

add_rich_group <- function(df) {
  if (
    nrow(df) == 0 ||
    !"RichFactor" %in% colnames(df)
  ) {
    return(df)
  }
  
  df <- df %>%
    dplyr::filter(is.finite(RichFactor))
  
  if (nrow(df) == 0) {
    return(df)
  }
  
  rich_breaks <- stats::quantile(
    df$RichFactor,
    probs = c(0, 1 / 3, 2 / 3, 1),
    na.rm = TRUE
  )
  
  if (length(unique(rich_breaks)) == 4) {
    return(
      df %>%
        dplyr::mutate(
          RichGroup = cut(
            RichFactor,
            breaks = rich_breaks,
            include.lowest = TRUE,
            labels = c("Low", "Medium", "High")
          )
        )
    )
  }
  
  distinct_values <- sort(unique(df$RichFactor))
  
  if (length(distinct_values) == 1) {
    df$RichGroup <- factor(
      rep("Low", nrow(df)),
      levels = c("Low", "Medium", "High")
    )
  } else if (length(distinct_values) == 2) {
    df$RichGroup <- factor(
      ifelse(
        df$RichFactor == min(distinct_values),
        "Low",
        "High"
      ),
      levels = c("Low", "Medium", "High")
    )
  } else {
    df$RichGroup <- factor(
      c("Low", "Medium", "High")[
        dplyr::ntile(
          rank(df$RichFactor, ties.method = "first"),
          3
        )
      ],
      levels = c("Low", "Medium", "High")
    )
  }
  
  df
}

safe_enrich_go <- function(genes, universe) {
  tryCatch(
    clusterProfiler::enrichGO(
      gene = genes,
      universe = universe,
      OrgDb = org.Mm.eg.db,
      keyType = "ENTREZID",
      ont = go_ontology,
      pAdjustMethod = "BH",
      pvalueCutoff = pvalue_cutoff,
      qvalueCutoff = qvalue_cutoff,
      readable = TRUE
    ),
    error = function(e) {
      warning(
        "GO enrichment failed: ",
        conditionMessage(e)
      )
      NULL
    }
  )
}

safe_enrich_kegg <- function(genes, universe) {
  result <- tryCatch(
    clusterProfiler::enrichKEGG(
      gene = genes,
      universe = universe,
      organism = "mmu",
      keyType = "ncbi-geneid",
      pAdjustMethod = "BH",
      pvalueCutoff = pvalue_cutoff,
      qvalueCutoff = qvalue_cutoff
    ),
    error = function(e) {
      warning(
        "KEGG enrichment failed: ",
        conditionMessage(e)
      )
      NULL
    }
  )
  
  if (is.null(result)) {
    return(NULL)
  }
  
  if (nrow(as.data.frame(result)) > 0) {
    result <- tryCatch(
      clusterProfiler::setReadable(
        result,
        OrgDb = org.Mm.eg.db,
        keyType = "ENTREZID"
      ),
      error = function(e) {
        warning(
          "KEGG enrichment succeeded, but setReadable() failed: ",
          conditionMessage(e)
        )
        result
      }
    )
  }
  
  result
}


