# ----------------------------
# 2) Exclude Equ03 genes
# ----------------------------

all_genes <- all_genes[
  !is.na(all_genes) &
    all_genes != "" &
    all_genes != "NA"
]

equ_genes <- unique(
  all_genes[grepl("^Equ03\\.", all_genes)]
)

genes <- unique(
  all_genes[!grepl("^Equ03\\.", all_genes)]
)

cat("\nINPUT SUMMARY\n")
