# ----------------------------
# 10) Plot settings
# ----------------------------

three_cols <- pal_npg("nrc")(3)

# Robust three-group assignment.
# Unlike quantile-based cut(), this does not fail when
# several terms have identical RichFactor values.
add_rich_group <- function(df) {
  df %>%
    mutate(
      RichGroup = cut(
        RichFactor,
        breaks = quantile(
          RichFactor,
          probs = c(0, 1/3, 2/3, 1),
          na.rm = TRUE
        ),
        include.lowest = TRUE,
        labels = c("Low", "Medium", "High")
      )
    )
}

clean_theme <- theme_classic() +
  theme(
    plot.title = element_text(
      size = 14,
      face = "bold",
      hjust = 0.5
    ),
    axis.title.x = element_text(
      size = 12,
      face = "bold"
    ),
    axis.title.y = element_text(
      size = 12,
      face = "bold"
    ),
    axis.text.x = element_text(size = 10),
    axis.text.y = element_text(size = 10),
    legend.title = element_text(
      size = 10,
      face = "bold"
    ),
    legend.text = element_text(size = 9)
  )

# ----------------------------
# 11) GO RichFactor dot plot
# ----------------------------

if (nrow(ego_df) > 0) {

  topGO <- ego_df %>%
    filter(is.finite(RichFactor)) %>%
    arrange(
      desc(RichFactor),
      p.adjust
    ) %>%
    slice_head(n = 20) %>%
    add_rich_group()

  p1 <- ggplot(
    topGO,
    aes(
      x = RichFactor,
      y = reorder(
        Description,
        RichFactor
      ),
      colour = RichGroup,
      size = Count
    )
  ) +
    geom_point(alpha = 0.9) +
    scale_colour_manual(
      values = three_cols,
      drop = FALSE
    ) +
    labs(
      title = "GO Biological Process Enrichment",
      x = "Rich factor",
      y = "GO term",
      colour = "Rich factor",
      size = "Gene count"
    ) +
    clean_theme

  ggsave(
    filename = file.path(
      outdir,
      "GO_RichFactor_dotplot.pdf"
    ),
    plot = p1,
    width = 8,
    height = 6
  )

} else {

  cat(
    "\nNo significant GO BP enrichment results found.\n"
  )
}

