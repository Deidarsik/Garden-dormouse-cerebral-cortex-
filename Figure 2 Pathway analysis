# 8. FISHER ENRICHMENT TESTS FOR THE TWO REVERSAL CLASSES
# =============================================================================

# ASSUMPTION / NULL MODEL:
# The prompt's approximation n_sig_TE_TL * n_sig_TL_AE * 0.5 / n_tested
# gives the same expected count for both reversal classes and therefore cannot
# reproduce different class-specific expectations such as 3.15 and 1.68.
# Instead, each class is tested as enrichment of the overlap between its two
# relevant directional significant sets, conditional on their observed margins:
#
#   torpor-upregulated expected =
#     n(TE_vs_TL significant, logFC < 0) *
#     n(TL_vs_AE significant, logFC > 0) / n_tested
#
#   torpor-downregulated expected =
#     n(TE_vs_TL significant, logFC > 0) *
#     n(TL_vs_AE significant, logFC < 0) / n_tested
#
# This is the standard independence expectation corresponding to Fisher's exact
# test and preserves any imbalance in the direction of significant changes.

n_tested_fisher <- nrow(paired_results)

if (n_tested_fisher != genes_after_filtering) {
  stop(
    "Fisher-test background mismatch: paired_results contains ",
    n_tested_fisher,
    " genes but the filtered/tested edgeR set contains ",
    genes_after_filtering,
    "."
  )
}

sig_te_tl_up_torpor <- paired_results %>%
  dplyr::filter(
    FDR_TE_TL < fdr_cutoff,
    logFC_TE_TL < 0
  ) %>%
  dplyr::pull(GeneID) %>%
  unique()

sig_tl_ae_down_from_torpor <- paired_results %>%
  dplyr::filter(
    FDR_TL_AE < fdr_cutoff,
    logFC_TL_AE > 0
  ) %>%
  dplyr::pull(GeneID) %>%
  unique()

sig_te_tl_down_torpor <- paired_results %>%
  dplyr::filter(
    FDR_TE_TL < fdr_cutoff,
    logFC_TE_TL > 0
  ) %>%
  dplyr::pull(GeneID) %>%
  unique()

sig_tl_ae_up_from_torpor <- paired_results %>%
  dplyr::filter(
    FDR_TL_AE < fdr_cutoff,
    logFC_TL_AE < 0
  ) %>%
  dplyr::pull(GeneID) %>%
  unique()

run_directional_overlap_fisher <- function(
    class_name,
    set_te_tl,
    set_tl_ae,
    observed_class_count,
    n_tested
) {
  n_te_tl <- length(set_te_tl)
  n_tl_ae <- length(set_tl_ae)
  observed_overlap <- length(intersect(set_te_tl, set_tl_ae))
  expected_overlap <- n_te_tl * n_tl_ae / n_tested
  
  if (observed_overlap != observed_class_count) {
    stop(
      "Fisher-test observed overlap for ",
      class_name,
      " is ",
      observed_overlap,
      " but the derived reversal class contains ",
      observed_class_count,
      " genes."
    )
  }
  
  contingency <- matrix(
    c(
      observed_overlap,
      n_te_tl - observed_overlap,
      n_tl_ae - observed_overlap,
      n_tested - n_te_tl - n_tl_ae + observed_overlap
    ),
    nrow = 2,
    byrow = TRUE,
    dimnames = list(
      TE_TL_directional_significant = c("Yes", "No"),
      TL_AE_directional_significant = c("Yes", "No")
    )
  )
  
  if (any(contingency < 0)) {
    stop(
      "Invalid Fisher contingency table for ",
      class_name,
      ": negative cell count encountered."
    )
  }
  
  fisher_result <- stats::fisher.test(
    contingency,
    alternative = "greater"
  )
  
  data.frame(
    ReversalClass = class_name,
    n_tested = n_tested,
    n_directional_significant_TE_TL = n_te_tl,
    n_directional_significant_TL_AE = n_tl_ae,
    Observed_count = observed_overlap,
    Expected_count_under_independence = expected_overlap,
    Fisher_odds_ratio = unname(fisher_result$estimate),
    Fisher_p_value = fisher_result$p.value,
    stringsAsFactors = FALSE
  )
}

fisher_enrichment_results <- dplyr::bind_rows(
  run_directional_overlap_fisher(
    class_name =
      "torpor_upregulated_increased_TE_to_TL_then_decreased_TL_to_AE",
    set_te_tl = sig_te_tl_up_torpor,
    set_tl_ae = sig_tl_ae_down_from_torpor,
    observed_class_count = nrow(torpor_upregulated_class),
    n_tested = n_tested_fisher
  ),
  run_directional_overlap_fisher(
    class_name =
      "torpor_downregulated_decreased_TE_to_TL_then_increased_TL_to_AE",
    set_te_tl = sig_te_tl_down_torpor,
    set_tl_ae = sig_tl_ae_up_from_torpor,
    observed_class_count = nrow(torpor_downregulated_class),
    n_tested = n_tested_fisher
  )
) %>%
  dplyr::mutate(
    Fisher_BH_adjusted_p_value = stats::p.adjust(
      Fisher_p_value,
      method = "BH"
    )
  )

