    ) %>%
      dplyr::mutate(
        Status = dplyr::case_when(
          In_unadjusted & In_sex_adjusted ~ "Present in both",
          In_unadjusted & !In_sex_adjusted ~ "Lost after sex adjustment",
          !In_unadjusted & In_sex_adjusted ~ "Gained after sex adjustment",
