prepare_term_table <- function(term_table, suffix) {
  required_columns <- c(
    "ID",
    "Description",
    "GeneRatio",
    "BgRatio",
    "pvalue",
    "p.adjust",
    "qvalue",
    "geneID",
    "Count",
    "BackgroundTermGenes",
    "RichFactor"
  )

  if (is.null(term_table)) {
    term_table <- data.frame()
  }

  term_table <- as.data.frame(term_table)

  for (column_name in required_columns) {
    if (!column_name %in% colnames(term_table)) {
      term_table[[column_name]] <- rep(
        NA,
        nrow(term_table)
      )
    }
  }

  term_table <- term_table[
    ,
    required_columns,
    drop = FALSE
  ]

  term_table$Present <- TRUE

  rename_columns <- setdiff(
    colnames(term_table),
    "ID"
  )

  colnames(term_table)[
    match(rename_columns, colnames(term_table))
  ] <- paste0(
    rename_columns,
    "_",
    suffix
  )

  term_table
}

compare_term_tables <- function(
    unadjusted_table,
    sex_adjusted_table,
    database_name,
    contrast_name,
    direction_name) {

  unadjusted_prepared <- prepare_term_table(
    unadjusted_table,
    "unadjusted"
  )

  sex_adjusted_prepared <- prepare_term_table(
    sex_adjusted_table,
    "sex_adjusted"
  )

  comparison <- dplyr::full_join(
    unadjusted_prepared,
    sex_adjusted_prepared,
    by = "ID"
  ) %>%
    dplyr::mutate(
      Present_unadjusted = tidyr::replace_na(
        Present_unadjusted,
        FALSE
      ),
      Present_sex_adjusted = tidyr::replace_na(
        Present_sex_adjusted,
        FALSE
      ),
      Description = dplyr::coalesce(
        as.character(Description_unadjusted),
        as.character(Description_sex_adjusted)
      ),
      Significance_status = dplyr::case_when(
        Present_unadjusted & Present_sex_adjusted ~
          "Significant in both",
        Present_unadjusted & !Present_sex_adjusted ~
          "Unadjusted only",
        !Present_unadjusted & Present_sex_adjusted ~
          "Sex-adjusted only",
        TRUE ~
          "Neither"
      ),
      Adjusted_P_difference = dplyr::if_else(
        Present_unadjusted & Present_sex_adjusted,
        as.numeric(p.adjust_sex_adjusted) -
          as.numeric(p.adjust_unadjusted),
        NA_real_
      ),
      Count_difference = dplyr::if_else(
        Present_unadjusted & Present_sex_adjusted,
        as.numeric(Count_sex_adjusted) -
          as.numeric(Count_unadjusted),
        NA_real_
      ),
      Database = database_name,
      Contrast = contrast_name,
      Direction = direction_name,
      .before = ID
    ) %>%
    dplyr::select(
      Database,
      Contrast,
      Direction,
      ID,
      Description,
      Significance_status,
      dplyr::everything(),
      -Description_unadjusted,
      -Description_sex_adjusted
    ) %>%
    dplyr::arrange(
      factor(
        Significance_status,
        levels = c(
          "Sex-adjusted only",
          "Unadjusted only",
          "Significant in both",
          "Neither"
        )
      ),
      p.adjust_sex_adjusted,
      p.adjust_unadjusted,
      ID
    )

  comparison
}

term_statistics_changed <- function(comparison_table) {
  shared_rows <- comparison_table %>%
    dplyr::filter(
      Significance_status == "Significant in both"
    )

  if (nrow(shared_rows) == 0) {
    return(FALSE)
  }

  adjusted_p_changed <- any(
    abs(
      as.numeric(shared_rows$p.adjust_sex_adjusted) -
        as.numeric(shared_rows$p.adjust_unadjusted)
    ) > 1e-12,
    na.rm = TRUE
  )

  count_changed <- any(
    as.numeric(shared_rows$Count_sex_adjusted) !=
      as.numeric(shared_rows$Count_unadjusted),
    na.rm = TRUE
  )

  normalise_gene_membership <- function(x) {
    x <- as.character(x)

    vapply(
      x,
      function(one_value) {
        if (is.na(one_value) || one_value == "") {
          return("")
        }

        genes <- unique(
          trimws(
            unlist(
              strsplit(
                one_value,
                "/",
                fixed = TRUE
              )
            )
          )
        )

        genes <- sort(
          genes[
            !is.na(genes) & genes != ""
          ]
        )

        paste(
          genes,
          collapse = ";"
        )
      },
      character(1)
    )
  }

  gene_membership_changed <- any(
    normalise_gene_membership(
      shared_rows$geneID_sex_adjusted
    ) !=
      normalise_gene_membership(
        shared_rows$geneID_unadjusted
      ),
    na.rm = TRUE
  )

  adjusted_p_changed || count_changed || gene_membership_changed
}

