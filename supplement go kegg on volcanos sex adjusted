safe_enrich_go <- function(genes, universe) {
  tryCatch(
    clusterProfiler::enrichGO(
      gene = genes,
      universe = universe,
      OrgDb = org.Mm.eg.db,
      keyType = "ENTREZID",
      ont = go_ontology,
      pAdjustMethod = "BH",
      pvalueCutoff = pvalue_cutoff,
      qvalueCutoff = qvalue_cutoff,
      readable = TRUE
    ),
    error = function(e) {
      warning("GO enrichment failed: ", conditionMessage(e))
      NULL
    }
  )
}

safe_enrich_kegg <- function(genes, universe) {
  kegg_object <- tryCatch(
    clusterProfiler::enrichKEGG(
      gene = genes,
      universe = universe,
      organism = "mmu",
      keyType = "ncbi-geneid",
      pvalueCutoff = pvalue_cutoff,
      pAdjustMethod = "BH",
      qvalueCutoff = qvalue_cutoff
    ),
    error = function(e) {
      warning("KEGG enrichment failed: ", conditionMessage(e))
      NULL
    }
  )
  
  if (is.null(kegg_object)) {
    return(NULL)
  }
  
  if (nrow(as.data.frame(kegg_object)) > 0) {
    kegg_object <- tryCatch(
      clusterProfiler::setReadable(
        kegg_object,
        OrgDb = org.Mm.eg.db,
        keyType = "ENTREZID"
      ),
      error = function(e) {
        warning(
          "KEGG enrichment completed, but setReadable() failed: ",
          conditionMessage(e)
        )
        kegg_object
      }
    )
  }
  
  kegg_object
}

