run_direction_enrichment <- function(
    analysis_label,
    contrast_name,
    direction,
    result_table,
    selected_mouse_col,
    selected_key_type,
    gene_annotations,
    universe_entrez,
    output_root) {
  
  if (!direction %in% c(
    "Increased_in_second_phase",
    "Decreased_in_second_phase"
  )) {
    stop(
      "Direction must be Increased_in_second_phase or ",
      "Decreased_in_second_phase."
    )
  }
  
  # Contrasts are defined as first phase minus second phase:
  #   logFC < 0 = higher in the second phase
  #             = increased from first phase to second phase
  #   logFC > 0 = higher in the first phase
  #             = decreased from first phase to second phase
  direction_folder <- ifelse(
    direction == "Increased_in_second_phase",
    "increased_in_second_phase",
    "decreased_in_second_phase"
  )
  
  direction_title <- ifelse(
    direction == "Increased_in_second_phase",
    "increased in second phase",
    "decreased in second phase"
  )
  
  contrast_label <- gsub("_vs_", "-", contrast_name)
  
  output_dir <- file.path(
    output_root,
    analysis_label,
    contrast_name,
    direction_folder
  )
  
  dir.create(
    output_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  result_core <- result_table %>%
    dplyr::select(
      dplyr::any_of(
        c(
          "GeneID", "logFC", "logCPM", "F", "PValue", "FDR"
        )
      )
    ) %>%
    dplyr::mutate(GeneID = as.character(GeneID)) %>%
    dplyr::distinct(GeneID, .keep_all = TRUE)
  
  annotation_columns <- unique(
    c(
      "GeneID",
      selected_mouse_col,
      intersect(
        c("Gene_name", "Mmu_gene_name", "Mmu_Gene_name"),
        colnames(gene_annotations)
      )
    )
  )
  
  annotated_results <- result_core %>%
    dplyr::left_join(
      gene_annotations %>%
        dplyr::select(dplyr::all_of(annotation_columns)),
      by = "GeneID"
    )
  
  if (nrow(annotated_results) != nrow(result_core)) {
    stop(
      "Annotation joining changed the row count for ",
      analysis_label, "/", contrast_name, "."
    )
  }
  
  significant_here <- annotated_results %>%
    dplyr::filter(
      FDR < enrichment_fdr_cutoff,
      if (direction == "Increased_in_second_phase") {
        logFC < 0
      } else {
        logFC > 0
      }
    ) %>%
    dplyr::distinct(GeneID, .keep_all = TRUE)
  
  # Save all direction-specific FDR-significant original genes before mapping.
  write.csv(
    significant_here,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_ALL_DEGs_before_mouse_mapping.csv"
      )
    ),
    row.names = FALSE
  )
  
  significant_long <- expand_identifier_column(
    significant_here,
    identifier_col = selected_mouse_col
  )
  
  significant_id_map <- map_mouse_identifiers(
    identifier_table = significant_long,
    from_type = selected_key_type
  )
  
  mapped_foreground <- significant_long %>%
    dplyr::inner_join(
      significant_id_map,
      by = "MouseInputOriginal",
      relationship = "many-to-many"
    ) %>%
    dplyr::filter(ENTREZID %in% universe_entrez) %>%
    dplyr::left_join(
      significant_here %>%
        dplyr::select(
          dplyr::any_of(
            c(
              "GeneID", "logFC", "logCPM", "F", "PValue", "FDR",
              "Gene_name", "Mmu_gene_name", "Mmu_Gene_name",
              selected_mouse_col
            )
          )
        ),
      by = "GeneID"
    ) %>%
    dplyr::distinct()
  
  # One-row-per-original-gene audit of all inclusion/exclusion decisions.
  valid_input_status <- significant_long %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(HasValidMouseInput = TRUE)
  
  mapped_status <- significant_long %>%
    dplyr::inner_join(
      significant_id_map,
      by = "MouseInputOriginal",
      relationship = "many-to-many"
    ) %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(MappedToMouseEntrez = TRUE)
  
  used_status <- mapped_foreground %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(UsedForEnrichment = TRUE)
  
  gene_flow_audit <- significant_here %>%
    dplyr::left_join(valid_input_status, by = "GeneID") %>%
    dplyr::left_join(mapped_status, by = "GeneID") %>%
    dplyr::left_join(used_status, by = "GeneID") %>%
    dplyr::mutate(
      HasValidMouseInput = tidyr::replace_na(HasValidMouseInput, FALSE),
      MappedToMouseEntrez = tidyr::replace_na(MappedToMouseEntrez, FALSE),
      UsedForEnrichment = tidyr::replace_na(UsedForEnrichment, FALSE),
      Status = dplyr::case_when(
        UsedForEnrichment ~ "Used for GO/KEGG",
        !HasValidMouseInput ~
          "Excluded: no valid mouse ortholog identifier",
        HasValidMouseInput & !MappedToMouseEntrez ~
          "Excluded: mouse identifier did not map to Entrez",
        MappedToMouseEntrez & !UsedForEnrichment ~
          "Excluded: mapped mouse Entrez absent from tested universe",
        TRUE ~ "Unknown"
      )
    ) %>%
    dplyr::arrange(Status, FDR, GeneID)
  
  write.csv(
    gene_flow_audit,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_AUDIT_every_DEG_to_enrichment.csv"
      )
    ),
    row.names = FALSE
  )
  
  mapped_foreground <- mapped_foreground %>%
    dplyr::arrange(MouseSymbol, ENTREZID, FDR, GeneID)
  
  write.csv(
    mapped_foreground,
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
        "_EXACT_usable_mouse_ortholog_genes.csv"
      )
    ),
    row.names = FALSE
  )
  
  foreground_entrez <- sort(unique(mapped_foreground$ENTREZID))
  
  write.csv(
    data.frame(ENTREZID = foreground_entrez),
    file = file.path(
      output_dir,
      paste0(
        contrast_name,
        "_",
        direction_folder,
