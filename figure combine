make_go_plot <- function(
    dat,
    title_text
) {

  ggplot2::ggplot(
    dat,
    ggplot2::aes(
      x = RichFactor,
      y = Description,
      size = Count,
      colour = NegLog10AdjustedP
    )
  ) +
    ggplot2::geom_point(
      alpha = 0.95
    ) +
    ggplot2::scale_colour_viridis_c(
      name = "-log10(adjusted P)"
    ) +
    ggplot2::scale_size_continuous(
      name = "Gene count",
      range = c(
        1.2,
        4.8
      )
    ) +
    ggplot2::labs(
      title = title_text,
      x = "Rich factor"
    ) +
    base_theme
}

make_kegg_plot <- function(
    dat,
    title_text
) {

  ggplot2::ggplot(
    dat,
    ggplot2::aes(
      x = RichFactor,
      y = Description,
      fill = NegLog10AdjustedP
    )
  ) +
    ggplot2::geom_col(
      width = 0.72
    ) +
    ggplot2::scale_fill_viridis_c(
      name = "-log10(adjusted P)"
    ) +
    ggplot2::labs(
      title = title_text,
      x = "Rich factor"
    ) +
    base_theme
}

make_panel_label <- function(index) {
  letters_vector <- letters
  x <- index
  label_parts <- character(0)

  while (x > 0) {
    remainder <- (x - 1) %% 26

    label_parts <- c(
      letters_vector[
        remainder + 1
      ],
      label_parts
    )

    x <- (x - 1) %/% 26
  }

  paste0(
    label_parts,
    collapse = ""
  )
}

add_panel_label <- function(
    plot_object,
    panel_label
) {

  grid::grobTree(
    ggplot2::ggplotGrob(
      plot_object
    ),
    grid::textGrob(
      paste0(
        panel_label,
        ")"
      ),
      x = grid::unit(
        0.004,
        "npc"
      ),
      y = grid::unit(
        0.997,
        "npc"
      ),
      just = c(
        "left",
        "top"
      ),
      gp = grid::gpar(
        fontsize = 11,
        fontface = "bold"
      )
    )
  )
}

pad_grobs <- function(
    grobs,
    ncol
) {

  if (length(grobs) == 0) {
    return(grobs)
  }

  required_blank_count <- (
    ncol -
      length(grobs) %% ncol
  ) %% ncol

  if (required_blank_count > 0) {
    grobs <- c(
      grobs,
      replicate(
        required_blank_count,
        grid::nullGrob(),
        simplify = FALSE
      )
    )
  }

  grobs
}

make_section_grid <- function(
    grobs,
    ncol
) {

  if (length(grobs) == 0) {
    return(
      grid::textGrob(
        "No significant enrichment results",
        gp = grid::gpar(
          fontsize = 10,
          fontface = "italic"
        )
      )
    )
  }

  padded_grobs <- pad_grobs(
    grobs,
    ncol = ncol
  )

  gridExtra::arrangeGrob(
    grobs = padded_grobs,
    ncol = ncol,
    nrow = ceiling(
      length(padded_grobs) /
        ncol
    )
  )
}

