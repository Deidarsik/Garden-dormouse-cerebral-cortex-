first_existing_column <- function(
    data,
    candidates,
    required = TRUE
) {

  hit <- candidates[
    candidates %in% colnames(data)
  ]

  if (length(hit) > 0) {
    return(hit[[1]])
  }

  if (required) {
    stop(
      "None of these expected columns was found: ",
      paste(candidates, collapse = ", "),
      ". Available columns: ",
      paste(colnames(data), collapse = ", ")
    )
  }

  NA_character_
}

ratio_numerator <- function(x) {
  x <- as.character(x)

  suppressWarnings(
    as.numeric(
      sub(
        "/.*$",
        "",
        x
      )
    )
  )
}

prepare_enrichment_table <- function(
    csv_path,
    top_n
) {

  dat <- read.csv(
    csv_path,
    stringsAsFactors = FALSE,
    check.names = FALSE
  )

  if (nrow(dat) == 0) {
    stop(
      "An analysis marked as non-empty has an empty CSV:\n",
      csv_path
    )
  }

  description_col <- first_existing_column(
    dat,
    c(
      "Description",
      "description",
      "Term",
      "term"
    )
  )

  adjusted_p_col <- first_existing_column(
    dat,
    c(
      "p.adjust",
      "p_adjust",
      "padj",
      "FDR",
      "adjusted_p_value",
      "Adjusted.P.value"
    )
  )

  count_col <- first_existing_column(
    dat,
    c(
      "Count",
      "count",
      "GeneCount",
      "gene_count"
    )
  )

  rich_factor_col <- first_existing_column(
    dat,
    c(
      "RichFactor",
      "Rich_factor",
      "rich_factor",
      "Rich.Factor",
      "richFactor"
    ),
    required = FALSE
  )

  background_ratio_col <- first_existing_column(
    dat,
    c(
      "BgRatio",
      "BG_Ratio",
      "BackgroundRatio"
    ),
    required = FALSE
  )

  gene_id_col <- first_existing_column(
    dat,
    c(
      "geneID",
      "GeneID",
      "gene_id"
    ),
    required = FALSE
  )

  out <- data.frame(
    Description = as.character(
      dat[[description_col]]
    ),
    AdjustedP = suppressWarnings(
      as.numeric(
        dat[[adjusted_p_col]]
      )
    ),
    Count = suppressWarnings(
      as.numeric(
        dat[[count_col]]
      )
    ),
    stringsAsFactors = FALSE
  )

  if (!is.na(gene_id_col)) {
    out$ContributingGenes <- as.character(
      dat[[gene_id_col]]
    )
  } else {
    out$ContributingGenes <- NA_character_
  }

  if (!is.na(rich_factor_col)) {
    out$RichFactor <- suppressWarnings(
      as.numeric(
        dat[[rich_factor_col]]
      )
    )
  } else {
    if (is.na(background_ratio_col)) {
      stop(
        "No RichFactor or BgRatio column was found in:\n",
        csv_path
      )
    }

    background_term_size <- ratio_numerator(
      dat[[background_ratio_col]]
    )

    out$RichFactor <- (
      out$Count /
        background_term_size
    )
  }

  out <- out[
    !is.na(out$Description) &
      trimws(out$Description) != "" &
      is.finite(out$AdjustedP) &
      out$AdjustedP > 0 &
      is.finite(out$Count) &
      is.finite(out$RichFactor),
    ,
    drop = FALSE
  ]

  if (nrow(out) == 0) {
    stop(
      "No usable enrichment rows remained after reading:\n",
      csv_path
    )
  }

  # Select terms by statistical significance.
  out <- out[
    order(
      out$AdjustedP,
      -out$RichFactor
    ),
    ,
    drop = FALSE
  ]

  out <- utils::head(
    out,
    top_n
  )

  out$NegLog10AdjustedP <- -log10(
    out$AdjustedP
  )

  # Arrange the displayed y-axis by Rich Factor.
  display_order <- order(
    out$RichFactor,
    decreasing = FALSE
  )

  out$Description <- factor(
    out$Description,
    levels = out$Description[
      display_order
    ]
  )

  out
}

