find_result_csv <- function(
    contrast,
    direction_folder,
    database
) {

  result_dir <- file.path(
    sex_adjusted_results_dir,
    contrast,
    direction_folder
  )

  if (!dir.exists(result_dir)) {
    stop(
      "The expected result directory was not found:\n",
      result_dir
    )
  }

  if (identical(database, "GO_BP")) {
    filename <- paste0(
      contrast,
      "_",
      direction_folder,
      "_GO_BP_enrichment.csv"
    )
  } else if (identical(database, "KEGG")) {
    filename <- paste0(
      contrast,
      "_",
      direction_folder,
      "_KEGG_mouse_enrichment.csv"
    )
  } else {
    stop(
      "Unsupported database: ",
      database
    )
  }

  csv_path <- file.path(
    result_dir,
    filename
  )

  if (!file.exists(csv_path)) {
    stop(
      "The expected ", database,
      " result table was not found:\n",
      csv_path
    )
  }

  csv_path
}

