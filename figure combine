  "Higher_in_group",
  "Description",
  "AdjustedP",
  "NegLog10AdjustedP",
  "Count",
  "RichFactor",
  "ContributingGenes"
)

plotted_terms <- plotted_terms[
  ,
  c(
    intersect(
      preferred_columns,
      colnames(plotted_terms)
    ),
    setdiff(
      colnames(plotted_terms),
      preferred_columns
    )
  ),
  drop = FALSE
]

