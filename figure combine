direction_to_folder <- function(direction) {
  if (identical(direction, "Increased_in_second_phase")) {
    return("increased_in_second_phase")
  }

  if (identical(direction, "Decreased_in_second_phase")) {
    return("decreased_in_second_phase")
  }

  stop(
    "Unrecognised direction: ",
    direction
  )
}

direction_to_title <- function(direction) {
  if (identical(direction, "Increased_in_second_phase")) {
    return("increased in second phase")
  }

  if (identical(direction, "Decreased_in_second_phase")) {
    return("decreased in second phase")
  }

  stop(
    "Unrecognised direction: ",
    direction
  )
}

extract_contrast_groups <- function(contrast_name) {
  groups <- strsplit(
    contrast_name,
    "_vs_",
    fixed = TRUE
  )[[1]]

  if (length(groups) != 2) {
    stop(
      "Could not parse contrast name: ",
      contrast_name
    )
  }

  groups
}

higher_group_from_direction <- function(
    contrast_name,
    direction
) {

  groups <- extract_contrast_groups(
    contrast_name
  )

  if (identical(
    direction,
    "Increased_in_second_phase"
  )) {
    return(groups[2])
  }

  if (identical(
    direction,
    "Decreased_in_second_phase"
  )) {
    return(groups[1])
  }

  stop(
    "Unrecognised direction: ",
    direction
  )
}

summary_df$DirectionFolder <- vapply(
