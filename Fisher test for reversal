# ------------------------------------------------------------
# 13. Fisher exact-test helper
# ------------------------------------------------------------

fisher_overlap <- function(
    first_set_size,
    second_set_size,
    observed_overlap,
    background_size
) {
  
  first_only <-
    first_set_size -
    observed_overlap
  
  second_only <-
    second_set_size -
    observed_overlap
  
  neither <-
    background_size -
    observed_overlap -
    first_only -
    second_only
  
  contingency_table <- matrix(
    c(
      observed_overlap,
      first_only,
      second_only,
      neither
    ),
    nrow = 2,
    byrow = TRUE,
    dimnames = list(
      First_set = c(
        "In_first_set",
        "Not_in_first_set"
      ),
      Second_set = c(
        "In_second_set",
        "Not_in_second_set"
      )
    )
  )
  
  if (any(contingency_table < 0)) {
    stop(
      "Invalid Fisher contingency table."
    )
  }
  
  fisher_result <- fisher.test(
    contingency_table,
    alternative = "greater"
  )
  
  list(
    table = contingency_table,
    p_value = fisher_result$p.value,
    odds_ratio = unname(
      fisher_result$estimate
    ),
    confidence_interval =
      fisher_result$conf.int
  )
}

