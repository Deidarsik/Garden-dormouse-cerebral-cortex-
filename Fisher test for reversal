# ------------------------------------------------------------
# 5. Function for fitting edgeR models
# ------------------------------------------------------------

fit_model <- function(
    with_sex,
    dge_object,
    metadata
) {
  
  if (with_sex) {
    
    design <- model.matrix(
      ~ 0 + Group + Sex,
      data = metadata
    )
    
  } else {
    
    design <- model.matrix(
      ~ 0 + Group,
      data = metadata
    )
  }
  
  # Convert GroupTE, GroupTL, etc. to TE, TL, etc.
  colnames(design) <- sub(
    "^Group",
    "",
    colnames(design)
  )
  
  if (qr(design)$rank < ncol(design)) {
    stop(
      "The model design is not full rank."
    )
  }
  
  contrast_matrix <- makeContrasts(
    TE_vs_TL = TE - TL,
    TL_vs_AE = TL - AE,
    levels = design
  )
  
  dge_model <- estimateDisp(
    dge_object,
    design,
    robust = TRUE
  )
  
  fit <- glmQLFit(
    dge_model,
    design,
    robust = TRUE
  )
  
  result_list <- list()
  
  for (
    contrast_name in colnames(contrast_matrix)
  ) {
    
    qlf_test <- glmQLFTest(
      fit,
      contrast = contrast_matrix[
        ,
        contrast_name
      ]
    )
    
    result_table <- topTags(
      qlf_test,
      n = Inf,
      sort.by = "PValue"
    )$table
    
    result_list[[contrast_name]] <- data.frame(
      GeneID = rownames(result_table),
      logFC = result_table$logFC,
      logCPM = result_table$logCPM,
      F = result_table$F,
      PValue = result_table$PValue,
      FDR = result_table$FDR,
      stringsAsFactors = FALSE
    )
  }
  
  return(result_list)
}

