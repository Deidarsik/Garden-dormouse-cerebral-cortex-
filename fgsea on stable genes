mean_dependence_trend_warn <- 0.02  # fraction of residual variance explained

# M1: plug-in estimator of the residual variance used in the sampling
# correction. "unmoderated" (fit$sigma^2) is unbiased for the gene's own
# residual variance and is the DEFAULT. "moderated" (eBayes s2.post) has lower
# variance but is shrunk toward a prior, which biases the correction in a
# direction that depends on the gene's own residual variance.
sampling_variance_estimator <- "unmoderated"

# M2: studentize the loess residual by a locally estimated scale.
studentize_primary_statistic <- TRUE


# Ranking statistic for the primary analysis.
#   "corrected_variance" : sampling-corrected, mean-adjusted between-stage
#                          variance (current default)
#   "stage_F"            : moderated F statistic for the stage term. Scale-free
#                          by construction (MS_between / MS_within), so it needs
#                          no sampling correction and no studentization.
primary_ranking_statistic <- "stage_F"

