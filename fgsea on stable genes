      match(paste(sex_sens_stable$pathway, "stable_end"),
            paste(sex_sens_combined$pathway, sex_sens_combined$direction))]
  sex_sens_variable$padj_sex_excluded_joint <-
    sex_sens_combined$padj_sex_excluded_joint[
      match(paste(sex_sens_variable$pathway, "variable_end"),
            paste(sex_sens_combined$pathway, sex_sens_combined$direction))]
  
  write_out(sex_sens_stable,   "sensitivity_sex_linked_excluded_stable.csv")
  write_out(sex_sens_variable, "sensitivity_sex_linked_excluded_variable.csv")
  write_out(sex_sens_combined, "sensitivity_sex_linked_excluded_combined_FDR.csv")
  report("S4 sex-linked-gene exclusion sensitivity: ",
         sum(sex_sens_stable$padj_sex_excluded_joint < fdr_cutoff, na.rm = TRUE),
         " stable-end and ",
         sum(sex_sens_variable$padj_sex_excluded_joint < fdr_cutoff, na.rm = TRUE),
         " variable-end terms")
}

# S5: cameraPR. A competitive preranked test that accounts for inter-gene
# correlation, which the fgsea gene-label null does not. The inter-gene
# correlation is SPECIFIED, not estimated. cameraPR P values are exported
# separately and are never combined with fgsea P values.
if (run_sensitivity_camerapr) {
  cam_stable   <- run_camerapr(ranks_stable[universe],   universe,
                               pathway_indices, inter_gene_cor = 0.01)
  cam_variable <- run_camerapr(ranks_variable[universe], universe,
                               pathway_indices, inter_gene_cor = 0.01)
  cam_stable$analysis   <- "cameraPR sensitivity: relatively low adjusted between-stage variance"
  cam_variable$analysis <- "cameraPR sensitivity: relatively high adjusted between-stage variance"
  cam_stable$direction   <- "stable_end"
  cam_variable$direction <- "variable_end"
  
  camera_combined <- rbind(cam_stable, cam_variable)
  camera_combined$padj_camerapr_joint <-
    p.adjust(camera_combined$p_one_sided, method = "BH")
  camera_combined <- camera_combined[
    order(camera_combined$padj_camerapr_joint, camera_combined$p_one_sided), ]
  
  cam_stable$padj_camerapr_joint <- camera_combined$padj_camerapr_joint[
    match(paste(cam_stable$pathway, "stable_end"),
          paste(camera_combined$pathway, camera_combined$direction))]
  cam_variable$padj_camerapr_joint <- camera_combined$padj_camerapr_joint[
    match(paste(cam_variable$pathway, "variable_end"),
          paste(camera_combined$pathway, camera_combined$direction))]
  
  write_out(cam_stable,      "cameraPR_primary_stable.csv")
  write_out(cam_variable,    "cameraPR_primary_variable.csv")
  write_out(camera_combined, "cameraPR_primary_combined_joint_FDR.csv")
  report("cameraPR sensitivity (specified inter-gene correlation 0.01; joint BH): ",
         sum(cam_stable$padj_camerapr_joint   < fdr_cutoff, na.rm = TRUE),
         " stable-end and ",
         sum(cam_variable$padj_camerapr_joint < fdr_cutoff, na.rm = TRUE),
         " variable-end terms")
}

# S6: the same primary pipeline using the MODERATED residual variance in the
# sampling correction, so the effect of the M1 choice is visible.
if (run_sensitivity_moderated_var) {
  corrected_mod <- gene_stats$between_stage_var_raw -
    gene_stats$sampling_var_moderated
  
  ok_mod <- is.finite(corrected_mod) &
    is.finite(gene_stats$mean_logCPM)
  
  if (!all(ok_mod)) {
    warning(
      "S6: dropping ",
      sum(!ok_mod),
      " gene(s) with non-finite moderated corrected variance."
    )
  }
  
  if (sum(ok_mod) > 100) {
    genes_mod <- gene_stats$Gene_name[ok_mod]
    
    stat_mod <- primary_statistic_from_corrected(
      corrected_mod[ok_mod],
      gene_stats$mean_logCPM[ok_mod]
    )
    
    ranks_mod_stable <- make_priority_ranking(
      stat_mod,
      genes_mod,
      low_at_top = TRUE,
      tie_seed = master_seed + 15
    )
    
    ranks_mod_variable <- reverse_ranking(ranks_mod_stable)
    
    pathways_mod <- lapply(pathways_all, intersect, genes_mod)
    sizes_mod <- lengths(pathways_mod)
    
    pathways_mod <- pathways_mod[
      sizes_mod >= min_pathway_size &
        sizes_mod <= max_pathway_size
    ]
    
    if (!length(pathways_mod)) {
      stop("S6: no testable pathways remain in the moderated-analysis universe.")
    }
    
    sens_mod_stable <- run_one_sided_fgsea(
      ranks_mod_stable,
      pathways_mod,
      "Sensitivity S6: moderated-variance sampling correction, stable end",
      seed = master_seed + 151
    )
    
    sens_mod_variable <- run_one_sided_fgsea(
      ranks_mod_variable,
      pathways_mod,
      "Sensitivity S6: moderated-variance sampling correction, variable end",
      seed = master_seed + 152
    )
    
    sens_mod_stable$direction <- "stable_end"
    sens_mod_variable$direction <- "variable_end"
    
    sens_mod <- rbind(sens_mod_stable, sens_mod_variable)
    sens_mod$sensitivity_family <- "S6_moderated_sampling_correction"
    sens_mod$padj_sensitivity_family <- p.adjust(
      sens_mod$pval,
      method = "BH"
    )
    
    sens_mod <- sens_mod[
      order(sens_mod$padj_sensitivity_family, sens_mod$pval),
    ]
    
    write_out(
      sens_mod,
      "sensitivity_moderated_sampling_correction.csv"
    )
    
    report(
      "S6 moderated sampling correction: ",
      sum(
        sens_mod$padj_sensitivity_family < fdr_cutoff,
        na.rm = TRUE
      ),
      " significant terms in its own FDR family"
    )
    
    report(
      "Spearman correlation between the unmoderated and moderated primary ",
      "statistics on common genes: ",
      round(
        cor(
          gene_stats$between_stage_var_adjusted[ok_mod],
          stat_mod,
          method = "spearman"
        ),
        4
      )
    )
  } else {
    warning("S6 skipped: too few genes have usable moderated statistics.")
  }
}
# =============================================================================
# 13. STAGE-LABEL PERMUTATION CHECK
# =============================================================================
#
# What this validates: whether the composition of the ranking ends, in terms of
# residual variance and expression level, differs from what shuffling stage
# labels produces. What it does NOT validate: the fgsea p-values, the enrichment
# results, or the biological reality of any pathway.

if (run_permutation_check) {
  hdr("8. Permutation check")
  
  # M3: stratify by sex when modelled, by batch when modelled, and fall back to
  # a single stratum otherwise. The previous version silently performed no
  # permutation at all when sex was absent.
  perm_strata <- if (has_sex) {
    meta$SexF
  } else {
    factor(rep("all", nrow(meta)))
  }
  
  if (has_batch) {
    perm_strata <- interaction(
      perm_strata,
      meta$BatchF,
      drop = TRUE
    )
  }
  
  report(
    "Permutation strata: ",
    paste(levels(perm_strata), collapse = ", ")
  )
  
  stratum_sizes <- table(perm_strata)
  
  if (!any(stratum_sizes >= 2)) {
    stop(
      "Every permutation stratum has fewer than two samples; ",
      "no permutation is possible."
    )
  }
  
  stages_per_stratum <- tapply(
    as.character(meta$Stage),
    perm_strata,
    function(z) length(unique(z))
  )
  
  if (!any(stages_per_stratum >= 2)) {
    stop(
      "No permutation stratum contains samples from more than one stage; ",
      "stage labels cannot be meaningfully permuted."
    )
  }
  
  report(
    "Number of stage levels represented per permutation stratum: ",
    paste(
      names(stages_per_stratum),
      stages_per_stratum,
      sep = "=",
      collapse = ", "
    )
  )
  
  rank_end_metrics <- function(stat_vec, resid_var, mean_expr) {
    ord_low  <- order(stat_vec)
    ord_high <- rev(ord_low)
    n_end    <- min(top_n_rank_ends, length(stat_vec))
    
    q_hi <- quantile(resid_var, 0.75, na.rm = TRUE)
    d_lo <- quantile(mean_expr, 0.10, na.rm = TRUE)
    
    c(
      low_end_high_residvar  = mean(resid_var[head(ord_low,  n_end)] >= q_hi),
      high_end_high_residvar = mean(resid_var[head(ord_high, n_end)] >= q_hi),
      low_end_low_expr       = mean(mean_expr[head(ord_low,  n_end)] <= d_lo),
      high_end_low_expr      = mean(mean_expr[head(ord_high, n_end)] <= d_lo),
      expression_spread      = {
        brk <- unique(as.numeric(quantile(mean_expr, seq(0, 1, 0.1), na.rm = TRUE)))
        if (length(brk) < 2) NA_real_ else {
          dec <- cut(mean_expr, breaks = brk, include.lowest = TRUE, labels = FALSE)
          med <- tapply(stat_vec, dec, median, na.rm = TRUE)
          diff(range(med[is.finite(med)]))
        }
      }
    )
  }
  
  observed_metrics <- rank_end_metrics(
    primary_stat,
    gene_stats$residual_var_unmoderated,
    gene_stats$mean_logCPM
  )
  
  one_permutation <- function(seed_i) {
    set.seed(seed_i)
    meta_p <- meta
    for (lev in levels(perm_strata)) {
      idx <- which(perm_strata == lev)
      if (length(idx) > 1) meta_p$Stage[idx] <- sample(meta$Stage[idx])
    }
    d_p <- model.matrix(as.formula(design_terms), data = meta_p)
    colnames(d_p) <- make.names(colnames(d_p))
    if (qr(d_p)$rank < ncol(d_p)) return(NULL)
    
    v_p   <- voom(dge, d_p, plot = FALSE)
    fit_p <- lmFit(v_p, d_p)
    
    sc <- match(paste0("Stage", stage_levels), colnames(d_p))
    if (anyNA(sc)) return(NULL)
    cc <- setdiff(seq_len(ncol(d_p)), sc)
    C_p <- matrix(0, length(stage_levels), ncol(d_p))
    C_p[cbind(seq_along(stage_levels), sc)] <- 1
    if (length(cc)) {
      C_p[, cc] <- matrix(colMeans(d_p[, cc, drop = FALSE]),
                          nrow = length(stage_levels), ncol = length(cc), byrow = TRUE)
    }
    if (primary_ranking_statistic == "stage_F") {
      cm_p <- matrix(0, nrow = ncol(d_p), ncol = length(stage_levels) - 1)
      for (j in seq_len(length(stage_levels) - 1)) {
        cm_p[sc[j + 1], j] <-  1
        cm_p[sc[1],     j] <- -1
      }
      eb_p   <- eBayes(contrasts.fit(fit_p, cm_p), trend = FALSE, robust = TRUE)
      stat_p <- as.numeric(eb_p$F)
      s2_p   <- as.numeric(fit_p$sigma)^2
      mean_p <- rowMeans(v_p$E)
      ok     <- is.finite(stat_p) & is.finite(mean_p)
      if (sum(ok) < 100) return(NULL)
      return(rank_end_metrics(stat_p[ok], s2_p[ok], mean_p[ok]))
    }
    
    m_p    <- fit_p$coefficients %*% t(C_p)
    bsv_p  <- row_vars(m_p)
    s2_p   <- as.numeric(fit_p$sigma)^2          # same estimator as the primary run
    w_p    <- as.matrix(v_p$weights)
    A_p    <- t(C_p) %*% P_centre %*% C_p
    
    samp_p <- compute_sampling_var(d_p, w_p, s2_p, A_p, k_stages)
    
    corr_p <- bsv_p - samp_p
    mean_p <- rowMeans(v_p$E)
    ok     <- is.finite(corr_p) & is.finite(mean_p)
    if (sum(ok) < 100) return(NULL)
    
    stat_p <- primary_statistic_from_corrected(corr_p[ok], mean_p[ok])
    rank_end_metrics(stat_p, s2_p[ok], mean_p[ok])
  }
  
  perm_list <- lapply(seq_len(n_permutations),
                      function(i) one_permutation(master_seed + 5000 + i))
  perm_list <- perm_list[!vapply(perm_list, is.null, logical(1))]
  
  # D5: an empty list would make do.call(rbind, ...) return NULL.
  if (!length(perm_list)) {
    stop("All permutations failed. Check the permuted design for rank deficiency.")
  }
  
  perm_mat <- do.call(rbind, perm_list)
  n_ok <- nrow(perm_mat)
  report("Successful permutations: ", n_ok, " of ", n_permutations)
  
  obs_mat <- matrix(observed_metrics, nrow = n_ok,
                    ncol = length(observed_metrics), byrow = TRUE)
  
  n_valid_perm <- colSums(is.finite(perm_mat))
  
  p_lower_perm <- numeric(length(observed_metrics))
  p_upper_perm <- numeric(length(observed_metrics))
  
  for (j in seq_along(observed_metrics)) {
    x <- perm_mat[, j]
    x <- x[is.finite(x)]
    
    if (!length(x) || !is.finite(observed_metrics[j])) {
      p_lower_perm[j] <- NA_real_
      p_upper_perm[j] <- NA_real_
    } else {
      p_lower_perm[j] <-
        (1 + sum(x <= observed_metrics[j])) / (length(x) + 1)
      
      p_upper_perm[j] <-
        (1 + sum(x >= observed_metrics[j])) / (length(x) + 1)
    }
  }
  
  perm_summary <- data.frame(
    metric = names(observed_metrics),
    observed = as.numeric(observed_metrics),
    permutation_mean = colMeans(perm_mat, na.rm = TRUE),
    permutation_sd = apply(perm_mat, 2, sd, na.rm = TRUE),
    p_lower = p_lower_perm,
    p_upper = p_upper_perm,
    n_valid_permutations = n_valid_perm,
    stringsAsFactors = FALSE
  )
  
  write_out(perm_summary, "permutation_rank_end_summary.csv")
  write_out(as.data.frame(perm_mat), "permutation_raw_metrics.csv")
  print(perm_summary, row.names = FALSE)
}

