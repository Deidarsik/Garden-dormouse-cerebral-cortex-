# 5. ADJUSTED STAGE MEANS, SAMPLING CORRECTION, PRIMARY STATISTIC
# =============================================================================

hdr("4. Stage means and the primary statistic")

stage_coef_names <- paste0("Stage", stage_levels)
if (!all(stage_coef_names %in% colnames(design))) {
  stop("Stage coefficients not found in the design matrix. Check stage level names.")
}
stage_cols <- match(stage_coef_names, colnames(design))
cov_cols   <- setdiff(seq_len(ncol(design)), stage_cols)

# Adjusted marginal (least-squares) stage means.
#
# With `~ 0 + Stage + SexF`, the raw Stage coefficients are the fitted means at
# the REFERENCE level of sex, not marginal means averaged over the covariate
# distribution. C_emm evaluates each stage at the observed mean of every
# covariate column, the standard adjusted-marginal-mean construction.
#
# The covariate term added is IDENTICAL for every stage, so it is a constant
# shift common to all stage means. The BETWEEN-STAGE VARIANCE is therefore
# mathematically invariant to this choice; the adjustment matters for the
# reported absolute levels, not for the primary statistic. Verified below.
C_emm <- matrix(0, nrow = length(stage_levels), ncol = ncol(design),
                dimnames = list(stage_levels, colnames(design)))
C_emm[cbind(seq_along(stage_levels), stage_cols)] <- 1
if (length(cov_cols)) {
  C_emm[, cov_cols] <- matrix(colMeans(design[, cov_cols, drop = FALSE]),
                              nrow = length(stage_levels),
                              ncol = length(cov_cols), byrow = TRUE)
}
stage_emm <- fit$coefficients %*% t(C_emm)
colnames(stage_emm) <- stage_levels

between_stage_var <- row_vars(stage_emm)
invariance_check <- max(abs(between_stage_var -
                              row_vars(fit$coefficients[, stage_cols, drop = FALSE])))
report("Adjusted-marginal-mean check: maximum |between-stage variance from ",
       "adjusted means minus that from raw stage coefficients| = ",
       format(invariance_check, digits = 3, scientific = TRUE),
       " (expected to be ~0 by construction)")

mean_logCPM <- rowMeans(logcpm)
total_var   <- row_vars(logcpm)

# --- sampling-variance contribution ------------------------------------------
#
# Let m be the vector of k estimated stage means for a gene, mu the true stage
# means, and P = I - J/k the centering matrix. Then
#
#   between_stage_var = m' P m / (k - 1)
#   E[m' P m]         = tr(P Sigma) + mu' P mu
#   E[between_stage_var] = Var(mu) + tr(P Sigma) / (k - 1)
#
# with Sigma = sigma^2 * C (X'WX)^-1 C' the covariance of the estimated stage
# means under the weighted fit. Subtracting tr(P Sigma)/(k-1) therefore removes
# the expected sampling contribution. For symmetric matrices tr(P Sigma) equals
# sum(P * Sigma) elementwise, which is what is computed.
#
# M1: sigma^2 is estimated WITHOUT empirical-Bayes shrinkage by default. The
# moderated posterior is shrunk toward a prior, so it over-subtracts for genes
# whose residual variance is below the prior and under-subtracts for those above
# it, biasing the ranking in a direction that depends on the gene's own residual
# variance.

if (has_animal) {
  stop("The sampling-variance correction assumes independent samples. With ",
       "duplicateCorrelation the covariance of the stage means is not ",
       "(X'WX)^-1 and this code must be revised before use.")
}

fit_eb        <- eBayes(fit, trend = FALSE, robust = TRUE)
s2_post_stage <- as.numeric(fit_eb$s2.post)   # D4: distinct name
s2_unmod      <- as.numeric(fit$sigma)^2

s2_for_correction <- switch(
  sampling_variance_estimator,
  unmoderated = s2_unmod,
  moderated   = s2_post_stage,
  stop("sampling_variance_estimator must be 'unmoderated' or 'moderated'.")
)

k_stages <- length(stage_levels)
P_centre <- diag(k_stages) - matrix(1 / k_stages, k_stages, k_stages)

# tr(P C M C') = tr(C' P C M) = sum(A * M) with A = C' P C precomputed once.
A_quad <- t(C_emm) %*% P_centre %*% C_emm

if (is.null(v$weights)) stop("voom weights are missing; cannot compute the correction.")
w_mat <- as.matrix(v$weights)
if (!identical(dim(w_mat), dim(logcpm))) {
  stop("The voom weight matrix does not match the expression matrix.")
}

compute_sampling_var <- function(design_mat, weight_mat, s2_vec, A_mat, k) {
  out <- numeric(nrow(weight_mat))
  for (g in seq_len(nrow(weight_mat))) {
    XtWX <- crossprod(design_mat * sqrt(weight_mat[g, ]))
    M <- tryCatch(chol2inv(chol(XtWX)), error = function(e) NULL)
    if (is.null(M)) M <- tryCatch(solve(XtWX), error = function(e) NULL)
    if (is.null(M)) { out[g] <- NA_real_; next }
    out[g] <- s2_vec[g] * sum(A_mat * M) / (k - 1)
  }
  out
}

sampling_var <- compute_sampling_var(design, w_mat, s2_for_correction, A_quad, k_stages)

if (any(!is.finite(sampling_var)) || any(sampling_var < 0)) {
  stop("The sampling-variance estimate is non-finite or negative; check the design.")
}

# Negative corrected values are RETAINED by design: flooring at zero would bias
# the low-variance end of the ranking, which is the end being interpreted.
between_stage_var_corrected <- between_stage_var - sampling_var

report("Sampling-variance estimator: ", sampling_variance_estimator)
report("Median sampling contribution: ", signif(median(sampling_var), 4),
       " (median raw between-stage variance: ", signif(median(between_stage_var), 4), ")")
report("Genes with a negative corrected variance: ",
       sum(between_stage_var_corrected < 0), " of ", length(between_stage_var_corrected))

# --- mean and scale adjustment -----------------------------------------------

make_offset <- function(x) {
  pos <- x[is.finite(x) & x > 0]
  if (!length(pos)) return(1e-10)
  max(1e-10, min(pos) / 2)
}

# Log-scale adjustment, retained for the S1/S2 sensitivity analyses, which use
# strictly non-negative statistics.
adjust_for_mean <- function(stat, mean_expr, span = loess_span) {
  if (length(stat) != length(mean_expr)) stop("Mean-adjustment inputs have different lengths.")
  if (length(stat) < 20) stop("Too few genes for a reliable mean-variance loess adjustment.")
  if (any(!is.finite(stat)) || any(stat < 0)) {
    stop("Variance statistic contains negative or non-finite values.")
  }
  if (any(!is.finite(mean_expr))) stop("Mean-expression vector contains non-finite values.")
  if (length(unique(mean_expr)) < 10) stop("Too few unique mean-expression values.")
  if (!is.finite(span) || span <= 0 || span > 1) stop("loess span must be in (0, 1].")
  
  off <- make_offset(stat)
  y <- log2(stat + off)
  if (any(!is.finite(y))) stop("Log-transformed variance contains non-finite values.")
  
  lf <- tryCatch(limma::loessFit(y = y, x = mean_expr, span = span),
                 error = function(e) stop("Mean-variance loess failed: ", conditionMessage(e)))
  if (length(lf$fitted) != length(stat) || length(lf$residuals) != length(stat)) {
    stop("Mean-variance loess returned vectors of an unexpected length.")
  }
  if (any(!is.finite(lf$fitted)) || any(!is.finite(lf$residuals))) {
    stop("Mean-variance loess returned non-finite fitted values or residuals.")
  }
  list(offset = off, log_stat = y, fitted = lf$fitted, residual = lf$residuals)
}

# Natural-scale adjustment. Used for the sampling-corrected between-stage
# variance, which can be negative and therefore cannot be log-transformed.
adjust_for_mean_natural <- function(stat, mean_expr, span = loess_span) {
  if (length(stat) != length(mean_expr)) stop("Mean-adjustment inputs have different lengths.")
  if (any(!is.finite(stat)) || any(!is.finite(mean_expr))) {
    stop("Natural-scale mean adjustment received non-finite values.")
  }
  lf <- tryCatch(limma::loessFit(y = stat, x = mean_expr, span = span),
                 error = function(e) stop("Natural-scale loess failed: ", conditionMessage(e)))
  if (any(!is.finite(lf$fitted)) || any(!is.finite(lf$residuals))) {
    stop("Natural-scale loess returned non-finite values.")
  }
  list(fitted = lf$fitted, residual = lf$residuals)
}

# M2: the loess removes E[stat | mean expression] but not Var[stat | mean
# expression], which is strongly decreasing in expression. Without this step,
# lowly expressed genes populate BOTH ends of the ranking irrespective of stage.
# Dividing by a locally estimated scale makes the statistic comparable across
# the expression range. sqrt(pi/2) converts a mean absolute deviation to an SD
# under approximate normality; the constant does not affect the ranking.
studentize_residual <- function(resid, mean_expr, span = loess_span) {
  if (length(resid) != length(mean_expr)) {
    stop("Studentization inputs have different lengths.")
  }
  if (any(!is.finite(resid)) || any(!is.finite(mean_expr))) {
    stop("Studentization received non-finite values.")
  }
  
  # Estimate the expression-dependent residual scale on the log scale.
  # This guarantees that the back-transformed local scale is positive.
  abs_resid <- abs(resid)
  
  positive_abs <- abs_resid[abs_resid > 0]
  scale_floor <- if (length(positive_abs)) {
    max(1e-10, min(positive_abs) / 2)
  } else {
    1e-10
  }
  
  log_abs_resid <- log(abs_resid + scale_floor)
  
  sf <- tryCatch(
    limma::loessFit(
      y = log_abs_resid,
      x = mean_expr,
      span = span
    ),
    error = function(e) {
      stop("Scale loess failed: ", conditionMessage(e))
    }
  )
  
  if (length(sf$fitted) != length(resid) ||
      any(!is.finite(sf$fitted))) {
    stop("Scale loess returned invalid fitted values.")
  }
  
  local_scale <- exp(sf$fitted)
  
  if (any(!is.finite(local_scale)) || any(local_scale <= 0)) {
    stop("Invalid local scale after studentization.")
  }
  
  resid / local_scale
}

primary_statistic_from_corrected <- function(corrected, mean_expr) {
  res <- adjust_for_mean_natural(corrected, mean_expr)$residual
  if (studentize_primary_statistic) res <- studentize_residual(res, mean_expr)
  res
}

adj_corrected              <- adjust_for_mean_natural(between_stage_var_corrected, mean_logCPM)
between_stage_var_meanadj  <- adj_corrected$residual
between_stage_var_adj      <- if (studentize_primary_statistic) {
  studentize_residual(between_stage_var_meanadj, mean_logCPM)
} else {
  between_stage_var_meanadj
}

# Retained for the S1/S2 sensitivity analyses.
adj_between   <- adjust_for_mean(between_stage_var, mean_logCPM)
adj_total     <- adjust_for_mean(total_var, mean_logCPM)
total_var_adj <- adj_total$residual

# --- diagnostics --------------------------------------------------------------
mean_dependence_check <- function(stat, mean_expr, label) {
  ok <- is.finite(stat) & is.finite(mean_expr)
  stat_ok <- stat[ok]; mean_ok <- mean_expr[ok]
  
  rho <- NA_real_; trend_frac <- NA_real_
  max_abs_decile <- NA_real_; decile_range <- NA_real_
  low_decile_spread_ratio <- NA_real_
  
  if (length(stat_ok) >= 3 && length(unique(stat_ok)) > 1 && length(unique(mean_ok)) > 1) {
    rho <- suppressWarnings(cor(stat_ok, mean_ok, method = "spearman", use = "complete.obs"))
    
    lf <- tryCatch(limma::loessFit(y = stat_ok, x = mean_ok, span = loess_span),
                   error = function(e) NULL)
    stat_var <- var(stat_ok, na.rm = TRUE)
    if (!is.null(lf) && is.finite(stat_var) && stat_var > 0 && all(is.finite(lf$fitted))) {
      fitted_var <- var(lf$fitted, na.rm = TRUE)
      if (is.finite(fitted_var)) trend_frac <- fitted_var / stat_var
    }
    
    brk <- unique(as.numeric(quantile(mean_ok, seq(0, 1, 0.1), na.rm = TRUE)))
    if (length(brk) >= 2) {
      dec <- cut(mean_ok, breaks = brk, include.lowest = TRUE, labels = FALSE)
      dec_med <- tapply(stat_ok, dec, median, na.rm = TRUE)
      dec_med <- dec_med[is.finite(dec_med)]
      if (length(dec_med)) {
        max_abs_decile <- max(abs(dec_med), na.rm = TRUE)
        decile_range   <- diff(range(dec_med, na.rm = TRUE))
      }
      # Heteroscedasticity diagnostic: spread in the lowest expression decile
      # relative to the highest. Should be near 1 after studentization.
      dec_sd <- tapply(stat_ok, dec, sd, na.rm = TRUE)
      dec_sd <- dec_sd[is.finite(dec_sd)]
      if (length(dec_sd) >= 2 && dec_sd[length(dec_sd)] > 0) {
        low_decile_spread_ratio <- as.numeric(dec_sd[1] / dec_sd[length(dec_sd)])
      }
    }
  }
  
  data.frame(
    statistic = label,
    spearman_rho_vs_mean_logCPM   = round(rho, 4),
    loess_trend_variance_fraction = round(trend_frac, 5),
    max_abs_decile_median         = round(max_abs_decile, 4),
    decile_median_range           = round(decile_range, 4),
    low_high_decile_sd_ratio      = round(low_decile_spread_ratio, 3),
    stringsAsFactors = FALSE
  )
}

md_tab <- rbind(
  mean_dependence_check(adj_between$log_stat, mean_logCPM,
                        "log2 between-stage variance (raw)"),
  mean_dependence_check(between_stage_var_corrected, mean_logCPM,
                        "sampling-corrected between-stage variance (unadjusted)"),
  mean_dependence_check(between_stage_var_meanadj, mean_logCPM,
                        "sampling-corrected, mean-adjusted (pre-studentization)"),
  mean_dependence_check(between_stage_var_adj, mean_logCPM,
                        "PRIMARY statistic"),
  mean_dependence_check(adj_total$log_stat, mean_logCPM,
                        "log2 total variance (raw)"),
  mean_dependence_check(total_var_adj, mean_logCPM,
                        "total variance (mean-adjusted, sensitivity)")
)
write_out(md_tab, "qc_mean_dependence_check.csv")
report("Mean-dependence diagnostics:")
print(md_tab, row.names = FALSE)

primary_md <- md_tab[md_tab$statistic == "PRIMARY statistic", ]
remaining_mean_dependence <-
  (is.finite(primary_md$spearman_rho_vs_mean_logCPM) &&
     abs(primary_md$spearman_rho_vs_mean_logCPM) > mean_dependence_rho_warn) ||
  (is.finite(primary_md$loess_trend_variance_fraction) &&
     primary_md$loess_trend_variance_fraction > mean_dependence_trend_warn)

if (remaining_mean_dependence) {
  warning("Substantial mean dependence REMAINS in the primary statistic ",
          "(Spearman rho = ", primary_md$spearman_rho_vs_mean_logCPM,
          ", loess trend variance fraction = ",
          primary_md$loess_trend_variance_fraction, "). Adjust loess_span, or ",
          "treat expression level as a confounder when interpreting the results.")
} else {
  report("Residual mean dependence in the primary statistic is negligible.")
}

if (is.finite(primary_md$low_high_decile_sd_ratio) &&
    primary_md$low_high_decile_sd_ratio > 1.5) {
