# =============================================================================
# 6. EXPLORATORY CONFIDENCE BOUNDS (sensitivity only)
# =============================================================================

# Initialise outputs so that the rest of the script remains valid even when
# run_sensitivity_equivalence = FALSE.
max_contrast <- max_contrast_ub <- max_contrast_lb <-
  rep(NA_real_, length(gene_symbols))

stage_F   <- rep(NA_real_, length(gene_symbols))
stage_F_p <- rep(NA_real_, length(gene_symbols))

# These are single summary statistics across genes, not per-gene quantities.
stage_F_spearman   <- NA_real_
stage_F_spearman_p <- NA_real_

n_pairwise_contrasts <- NA_integer_


if (run_sensitivity_equivalence) {
  
  # ---------------------------------------------------------------------------
  # All pairwise stage contrasts
  # ---------------------------------------------------------------------------
  
  pair_idx <- combn(length(stage_levels), 2)
  
  cm_pairs <- makeContrasts(
    contrasts = paste0(
      stage_coef_names[pair_idx[1, ]],
      "-",
      stage_coef_names[pair_idx[2, ]]
    ),
    levels = design
  )
  
  colnames(cm_pairs) <- paste0(
    stage_levels[pair_idx[1, ]],
    "_vs_",
    stage_levels[pair_idx[2, ]]
  )
  
  n_pairwise_contrasts <- ncol(cm_pairs)
  
  fit_pairs <- eBayes(
    contrasts.fit(fit, cm_pairs),
    trend = FALSE,
    robust = TRUE
  )
  
  lfc <- as.matrix(fit_pairs$coefficients)
  stdev_unscaled <- as.matrix(fit_pairs$stdev.unscaled)
  
  if (!identical(dim(lfc), dim(stdev_unscaled))) {
    stop(
      "Pairwise-contrast coefficient and standard-error matrices have ",
      "incompatible dimensions."
    )
  }
  
  
  # ---------------------------------------------------------------------------
  # Empirical-Bayes standard errors for pairwise contrasts
  # ---------------------------------------------------------------------------
  
  s2_post_pairs <- as.numeric(fit_pairs$s2.post)
  df_total      <- as.numeric(fit_pairs$df.total)
  
  if (length(s2_post_pairs) != nrow(lfc) ||
      length(df_total) != nrow(lfc)) {
    stop(
      "Unexpected empirical-Bayes variance or degrees-of-freedom length."
    )
  }
  
  se <- sweep(
    stdev_unscaled,
    MARGIN = 1,
    STATS = sqrt(s2_post_pairs),
    FUN = "*"
  )
  
  
  # ---------------------------------------------------------------------------
  # Bonferroni-simultaneous confidence bounds
  # ---------------------------------------------------------------------------
  
  tcrit <- qt(
    1 - 0.05 / (2 * n_pairwise_contrasts),
    df = df_total
  )
  
  ci_half_width <- sweep(
    se,
    MARGIN = 1,
    STATS = tcrit,
    FUN = "*"
  )
  
  abs_lfc <- abs(lfc)
  
  # Conservative upper/lower bounds for |logFC|.
  ci_ub <- abs_lfc + ci_half_width
  ci_lb <- abs_lfc - ci_half_width
  
  # Absolute effects cannot be negative.
  ci_lb[ci_lb < 0] <- 0
  
  max_contrast <- apply(
    abs_lfc,
    1,
    max,
    na.rm = TRUE
  )
  
  max_contrast_ub <- apply(
    ci_ub,
    1,
    max,
    na.rm = TRUE
  )
  
  max_contrast_lb <- apply(
    ci_lb,
    1,
    max,
    na.rm = TRUE
  )
  
  
  # ---------------------------------------------------------------------------
  # Overall stage-effect moderated F-statistic
  # ---------------------------------------------------------------------------
  
  cm_anova <- makeContrasts(
    contrasts = paste0(
      stage_coef_names[-1],
      "-",
      stage_coef_names[1]
    ),
    levels = design
  )
  
  fit_anova <- eBayes(
    contrasts.fit(fit, cm_anova),
    trend = FALSE,
    robust = TRUE
  )
  
  stage_F   <- as.numeric(fit_anova$F)
  stage_F_p <- as.numeric(fit_anova$F.p.value)
  
  
  # ---------------------------------------------------------------------------
  # Spearman correlation:
  # stage F-statistic versus mean expression across genes
  # ---------------------------------------------------------------------------
  
  ok_stageF <- is.finite(stage_F) &
    is.finite(mean_logCPM)
  
  if (sum(ok_stageF) >= 3 &&
      length(unique(stage_F[ok_stageF])) >= 2 &&
      length(unique(mean_logCPM[ok_stageF])) >= 2) {
    
    stage_F_spearman_test <- suppressWarnings(
      cor.test(
        stage_F[ok_stageF],
        mean_logCPM[ok_stageF],
        method = "spearman",
        exact = FALSE
      )
    )
    
    stage_F_spearman <-
      unname(stage_F_spearman_test$estimate)
    
    stage_F_spearman_p <-
      stage_F_spearman_test$p.value
    
    report(
      "Spearman correlation between stage F-statistic and mean logCPM: rho = ",
      round(stage_F_spearman, 4),
      ", p = ",
      signif(stage_F_spearman_p, 4),
      " (n = ",
      sum(ok_stageF),
      " genes)"
    )
    
  } else {
    
    warning(
      "Could not calculate the Spearman correlation between stage F-statistic ",
      "and mean logCPM because there are too few finite/non-constant observations."
    )
  }
}


