#!/usr/bin/env Rscript
# =============================================================================
# Between-stage expression variability: GO:BP enrichment at the stable and
# variable ends of a sampling-corrected, mean-adjusted variance ranking.
#
# Corrections applied relative to the previous version:
#   M1  sampling correction uses the UNMODERATED residual variance (fit$sigma^2)
#       instead of the empirical-Bayes posterior, removing a bias whose sign
#       depends on the gene's own residual variance.
#   M2  the primary statistic is a STUDENTIZED loess residual: the loess removes
#       the conditional mean, and division by a locally estimated scale removes
#       the conditional spread, so both ranking ends are no longer dominated by
#       lowly expressed genes.
#   M3  permutation strata fall back safely when sex is absent and include batch
#       when it is modelled.
#   D1  equivalence bounds use a Bonferroni-simultaneous critical value.
#   D2  1000 permutations by default.
#   D4  the stage-level and pairwise posterior variances have distinct names.
#   D5  an empty permutation list stops with a clear message.
#   D6  make.names() is checked for silent factor-level merging.
# =============================================================================

suppressPackageStartupMessages({
  library(edgeR)
  library(limma)
  library(fgsea)
  library(msigdbr)
  library(data.table)
  library(BiocParallel)
  library(ggplot2)
})

