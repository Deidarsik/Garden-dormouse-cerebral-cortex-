# D6: make.names() can map distinct raw levels onto the same syntactic name.
safe_factor <- function(x, label) {
  raw <- as.character(x)
  f <- factor(make.names(raw))
  if (nlevels(f) != length(unique(raw))) {
    stop("make.names() merged distinct '", label, "' levels: ",
         length(unique(raw)), " raw values collapsed to ", nlevels(f),
         ". Rename the offending levels before running.")
  }
  f
}

