  "\nTESTED GARDEN DORMOUSE BACKGROUND\n",
  "Genes retained by filterByExpr: ",
  length(tested_dormouse_gene_ids),
  "\n",
  sep = ""
)

if (
  length(tested_dormouse_gene_ids) !=
  expected_tested_dormouse_genes
) {
  stop(
    "The reconstructed tested background contains ",
    length(tested_dormouse_gene_ids),
    " genes, not the expected ",
    expected_tested_dormouse_genes,
    ". Do not continue with a different universe. Check the input files, ",
    "sample order, Group labels, and filtering procedure."
  )
}

write.csv(
  data.frame(
    DormouseGeneID = tested_dormouse_gene_ids,
    stringsAsFactors = FALSE
