# 10. PLOTS
# =============================================================================

three_colours <- ggsci::pal_npg(
  "nrc"
)(3)

clean_theme <- ggplot2::theme_classic() +
  ggplot2::theme(
    plot.title = ggplot2::element_text(
      size = 14,
      face = "bold",
      hjust = 0.5
    ),
    axis.title.x = ggplot2::element_text(
      size = 12,
      face = "bold"
    ),
    axis.title.y = ggplot2::element_text(
      size = 12,
      face = "bold"
    ),
    axis.text.x = ggplot2::element_text(
      size = 10
    ),
    axis.text.y = ggplot2::element_text(
      size = 10
    ),
    legend.title = ggplot2::element_text(
      size = 10,
      face = "bold"
    ),
    legend.text = ggplot2::element_text(
      size = 9
    )
  )

# GO RichFactor dot plot.
if (nrow(ego_significant) > 0) {
  top_go <- ego_significant %>%
    dplyr::slice_head(
      n = top_terms_to_plot
    ) %>%
    add_three_rich_groups() %>%
    dplyr::mutate(
      Description = factor(
        Description,
        levels = rev(Description)
      )
    )
  
  go_plot <- ggplot2::ggplot(
    top_go,
    ggplot2::aes(
      x = RichFactor,
      y = Description,
      colour = RichGroup,
      size = Count
    )
  ) +
    ggplot2::geom_point(
      alpha = 0.9
    ) +
    ggplot2::scale_colour_manual(
      values = three_colours,
      drop = FALSE
    ) +
    ggplot2::labs(
      title = "GO Biological Process Enrichment",
      x = "Rich Factor",
      y = "GO term",
      colour = "Rich Factor",
      size = "Gene Count"
    ) +
    clean_theme
  
  ggplot2::ggsave(
    filename = file.path(
      output_dir,
      "GO_BP_RichFactor_dotplot.pdf"
    ),
    plot = go_plot,
    width = 8,
    height = 6
  )
  
  ggplot2::ggsave(
    filename = file.path(
      output_dir,
      "GO_BP_RichFactor_dotplot.png"
    ),
    plot = go_plot,
    width = 8,
    height = 6,
    dpi = 300
  )
} else {
  save_empty_notice(
    file.path(
      output_dir,
      "GO_BP_NO_SIGNIFICANT_TERMS.txt"
    ),
    paste0(
      "No GO Biological Process terms were significant at BH FDR < ",
      fdr_cutoff,
      "."
    )
  )
}

# KEGG RichFactor bar plot.
if (nrow(ekegg_significant) > 0) {
  top_kegg <- ekegg_significant %>%
    dplyr::slice_head(
      n = top_terms_to_plot
    ) %>%
    add_three_rich_groups() %>%
    dplyr::mutate(
      Description = factor(
        Description,
        levels = rev(Description)
      )
    )
  
  kegg_plot <- ggplot2::ggplot(
    top_kegg,
    ggplot2::aes(
      x = RichFactor,
      y = Description,
      fill = RichGroup
    )
  ) +
    ggplot2::geom_col(
      width = 0.75
    ) +
    ggplot2::scale_fill_manual(
      values = three_colours,
      drop = FALSE
    ) +
    ggplot2::labs(
      title = "KEGG Pathway Enrichment",
      x = "Rich Factor",
      y = "KEGG pathway",
      fill = "Rich Factor"
    ) +
    clean_theme
  
  ggplot2::ggsave(
    filename = file.path(
      output_dir,
      "KEGG_mouse_RichFactor_barplot.pdf"
    ),
    plot = kegg_plot,
    width = 8,
    height = 6
  )
  
  ggplot2::ggsave(
    filename = file.path(
      output_dir,
      "KEGG_mouse_RichFactor_barplot.png"
    ),
    plot = kegg_plot,
    width = 8,
    height = 6,
    dpi = 300
  )
} else {
  save_empty_notice(
    file.path(
      output_dir,
      "KEGG_NO_SIGNIFICANT_PATHWAYS.txt"
    ),
    paste0(
      "No KEGG mouse pathways were significant at BH FDR < ",
      fdr_cutoff,
      "."
    )
  )
}

