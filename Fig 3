# =============================================================================
# 4. RECONSTRUCT THE 17,768 TESTED GARDEN DORMOUSE GENES
# =============================================================================

counts <- read.table(
  count_file,
  header = TRUE,
  row.names = 1,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = "",
  comment.char = ""
)

metadata <- read.table(
  sample_file,
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = "",
  comment.char = ""
)

required_metadata_columns <- c(
  "Sample",
  "Group"
)

missing_metadata_columns <- setdiff(
  required_metadata_columns,
  colnames(metadata)
)

if (length(missing_metadata_columns) > 0) {
  stop(
    "Metadata is missing columns: ",
    paste(missing_metadata_columns, collapse = ", ")
  )
}

metadata$Sample <- as.character(
  metadata$Sample
)

metadata$Group <- factor(
  metadata$Group,
  levels = group_levels
)

if (anyNA(metadata$Group)) {
  stop(
    "Unexpected Group labels were found. Expected only: ",
    paste(group_levels, collapse = ", ")
  )
}

missing_samples <- setdiff(
  metadata$Sample,
  colnames(counts)
)

if (length(missing_samples) > 0) {
  stop(
    "These metadata samples are missing from the count matrix: ",
    paste(missing_samples, collapse = ", ")
  )
}

counts <- counts[
  ,
  metadata$Sample,
  drop = FALSE
]

count_matrix <- as.matrix(counts)
storage.mode(count_matrix) <- "numeric"

if (anyNA(count_matrix)) {
  stop(
    "The count matrix contains non-numeric or missing values."
  )
}

dge_background <- edgeR::DGEList(
  counts = count_matrix,
  group = metadata$Group
)

keep_background <- edgeR::filterByExpr(
  dge_background,
  group = metadata$Group
)

tested_dormouse_gene_ids <- rownames(
  dge_background
)[keep_background]

tested_dormouse_gene_ids <- unique(
  trimws(
    as.character(
      tested_dormouse_gene_ids
    )
  )
)

