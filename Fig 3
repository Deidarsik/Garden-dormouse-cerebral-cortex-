is_valid_identifier <- function(x) {
  x <- trimws(as.character(x))
  
  !is.na(x) &
    x != "" &
    !(x %in% c(
      "-", ".", "NA", "na", "N/A", "n/a",
      "None", "none", "NULL", "null",
      "No", "no", "FALSE", "False", "false"
    ))
}

clean_symbols <- function(x) {
  x <- trimws(as.character(x))
  unique(x[is_valid_identifier(x)])
}

clean_entrez_ids <- function(x) {
  x <- trimws(as.character(x))
  
  # Protect against spreadsheets importing integer IDs as values such as 123.0.
  x <- sub("\\.0$", "", x)
  
  x <- x[
    is_valid_identifier(x) &
      grepl("^[0-9]+$", x)
  ]
  
  unique(x)
}

safe_result_dataframe <- function(result_object) {
  if (is.null(result_object)) {
    return(data.frame())
  }
  
  out <- as.data.frame(result_object)
  
  if (is.null(out) || nrow(out) == 0) {
    return(data.frame())
  }
  
  out
}

add_enrichment_metrics <- function(df) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  required_columns <- c(
    "GeneRatio",
    "BgRatio",
    "Count",
    "p.adjust"
  )
  
  missing_columns <- setdiff(
    required_columns,
    colnames(df)
  )
  
  if (length(missing_columns) > 0) {
    stop(
      "Enrichment result is missing columns: ",
      paste(missing_columns, collapse = ", ")
    )
  }
  
  foreground_term_count <- as.numeric(
    sub("/.*", "", df$GeneRatio)
  )
  
  foreground_annotated_total <- as.numeric(
    sub(".*/", "", df$GeneRatio)
  )
  
  background_term_count <- as.numeric(
    sub("/.*", "", df$BgRatio)
  )
  
  background_annotated_total <- as.numeric(
    sub(".*/", "", df$BgRatio)
  )
  
  df$ForegroundTermCount <- foreground_term_count
  df$ForegroundAnnotatedTotal <- foreground_annotated_total
  df$BackgroundTermCount <- background_term_count
  df$BackgroundAnnotatedTotal <- background_annotated_total
  
  # Rich factor: fraction of the term's background genes found in foreground.
  df$RichFactor <- (
    foreground_term_count /
      background_term_count
  )
  
  # Fold enrichment: foreground proportion divided by background proportion.
  df$FoldEnrichment <- (
    foreground_term_count /
      foreground_annotated_total
  ) / (
    background_term_count /
      background_annotated_total
  )
  
  df$Significant_BH_FDR_0.05 <- (
    !is.na(df$p.adjust) &
      df$p.adjust < fdr_cutoff
  )
  
  df
}

add_three_rich_groups <- function(df) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  if (nrow(df) == 1) {
    df$RichGroup <- factor(
      "High",
      levels = c("Low", "Medium", "High")
    )
    return(df)
  }
  
  group_number <- dplyr::ntile(
    rank(
      df$RichFactor,
      ties.method = "first"
    ),
    3
  )
  
  df$RichGroup <- factor(
    c("Low", "Medium", "High")[group_number],
    levels = c("Low", "Medium", "High")
  )
  
  df
}

