# =============================================================================
# 5. MAP TESTED GARDEN DORMOUSE GENES TO MOUSE SYMBOLS AND ENTREZ IDS
# =============================================================================

annotation <- read.table(
  annotation_file,
  header = TRUE,
  sep = "\t",
  check.names = FALSE,
  stringsAsFactors = FALSE,
  quote = "",
  comment.char = ""
)

if (ncol(annotation) == 0) {
  stop("The annotation table contains no columns.")
}

# The first column contains the garden dormouse Equ03 gene identifier.
colnames(annotation)[1] <- "GeneID"

annotation$GeneID <- trimws(
  as.character(
    annotation$GeneID
  )
)

annotation <- annotation %>%
  dplyr::distinct(
    GeneID,
    .keep_all = TRUE
  )

if (!mouse_symbol_column %in% colnames(annotation)) {
  stop(
    "The annotation table does not contain the requested mouse-symbol ",
    "column '",
    mouse_symbol_column,
    "'.\nAvailable columns:\n",
    paste(colnames(annotation), collapse = ", ")
  )
}

background_annotation <- data.frame(
  GeneID = tested_dormouse_gene_ids,
  stringsAsFactors = FALSE
) %>%
  dplyr::left_join(
    annotation,
    by = "GeneID"
  )

number_annotation_matches <- sum(
  tested_dormouse_gene_ids %in%
    annotation$GeneID
)

cat(
  "Tested garden dormouse genes matched to annotation: ",
  number_annotation_matches,
  " of ",
  length(tested_dormouse_gene_ids),
  "\n",
  sep = ""
)

if (number_annotation_matches == 0) {
  stop(
    "None of the tested garden dormouse GeneIDs matched the annotation table."
  )
}

# Report the orthology categories before any optional restriction.
if (orthology_column %in% colnames(background_annotation)) {
  cat("\nOrthology categories among matched tested genes:\n")
  
  print(
    sort(
      table(
        background_annotation[[orthology_column]],
        useNA = "ifany"
      ),
      decreasing = TRUE
    )
  )
}

background_annotation_for_mapping <- background_annotation

if (restrict_background_to_one_to_one) {
  if (!orthology_column %in% colnames(background_annotation_for_mapping)) {
    stop(
      "restrict_background_to_one_to_one is TRUE, but column '",
      orthology_column,
      "' is absent from the annotation table."
    )
  }
  
  orthology_text <- tolower(
    trimws(
      as.character(
        background_annotation_for_mapping[[orthology_column]]
      )
    )
  )
  
  one_to_one <- grepl(
    "one.?to.?one|one2one|1:1|one.?to.?1|1.?to.?one",
    orthology_text
  )
  
  background_annotation_for_mapping <-
    background_annotation_for_mapping[
      !is.na(one_to_one) & one_to_one,
      ,
      drop = FALSE
    ]
  
  cat(
    "\nTested genes retained after one-to-one orthology restriction: ",
    nrow(background_annotation_for_mapping),
    "\n",
    sep = ""
  )
}

# Extract actual mouse symbols from Gene_name.
# Entries such as Equ03.x are garden dormouse IDs, not mouse symbols, and are
# therefore treated as lacking a usable mouse symbol.
background_gene_to_symbol <- background_annotation_for_mapping %>%
  dplyr::transmute(
    DormouseGeneID = GeneID,
    MouseSymbol = trimws(
      as.character(
        .data[[mouse_symbol_column]]
      )
    )
  ) %>%
  dplyr::filter(
    is_valid_identifier(MouseSymbol)
  ) %>%
  tidyr::separate_rows(
    MouseSymbol,
    sep = "\\s*[,;|]+\\s*"
  ) %>%
  dplyr::mutate(
    MouseSymbol = trimws(MouseSymbol)
  ) %>%
  dplyr::filter(
    is_valid_identifier(MouseSymbol),
    !grepl(
      "^Equ03\\.",
      MouseSymbol,
      ignore.case = TRUE
    )
  ) %>%
  dplyr::distinct()

background_symbols <- clean_symbols(
  background_gene_to_symbol$MouseSymbol
)

cat(
  "\nUnique valid mouse symbols extracted from ",
  mouse_symbol_column,
  ": ",
  length(background_symbols),
  "\n",
  sep = ""
)

if (length(background_symbols) == 0) {
  stop(
    "No usable mouse symbols were extracted from column '",
    mouse_symbol_column,
    "'."
  )
}

if (length(background_symbols) < 1000) {
  stop(
    "Only ",
    length(background_symbols),
    " mouse symbols were obtained for the tested universe. ",
    "This is implausibly small. Inspect the Gene_name column and the ",
    "garden dormouse GeneID matching."
  )
}

# Map the background mouse symbols to current mouse Entrez IDs.
background_symbol_to_entrez <- suppressMessages(
  clusterProfiler::bitr(
    background_symbols,
    fromType = "SYMBOL",
    toType = "ENTREZID",
    OrgDb = org.Mm.eg.db,
    drop = TRUE
  )
) %>%
  dplyr::transmute(
    MouseSymbol = as.character(SYMBOL),
    MouseEntrezID = as.character(ENTREZID)
  ) %>%
  dplyr::filter(
    is_valid_identifier(MouseSymbol),
    is_valid_identifier(MouseEntrezID)
  ) %>%
  dplyr::distinct()

background_entrez <- clean_entrez_ids(
  background_symbol_to_entrez$MouseEntrezID
)

unmapped_background_symbols <- setdiff(
  background_symbols,
  background_symbol_to_entrez$MouseSymbol
)

background_mapping_audit <- background_gene_to_symbol %>%
  dplyr::left_join(
    background_symbol_to_entrez,
    by = "MouseSymbol"
  ) %>%
  dplyr::arrange(
    DormouseGeneID,
    MouseSymbol,
    MouseEntrezID
  )

number_dormouse_genes_with_mouse_entrez <- dplyr::n_distinct(
  background_mapping_audit$DormouseGeneID[
    !is.na(background_mapping_audit$MouseEntrezID)
  ]
)

cat(
  "Garden dormouse genes with a valid mouse Entrez mapping: ",
  number_dormouse_genes_with_mouse_entrez,
  "\n",
  sep = ""
)

cat(
  "Unique valid mouse Entrez IDs in enrichment universe: ",
  length(background_entrez),
  "\n",
  sep = ""
)

cat(
  "Mouse symbols that failed Entrez mapping: ",
  length(unmapped_background_symbols),
  "\n",
  sep = ""
)

if (length(background_entrez) < 1000) {
  stop(
    "Only ",
    length(background_entrez),
    " valid mouse Entrez IDs were obtained for the universe. ",
    "This is implausibly small and indicates a symbol-mapping problem."
  )
}

write.csv(
  background_mapping_audit,
  file = file.path(
    output_dir,
    "background_garden_dormouse_to_mouse_symbol_and_entrez.csv"
  ),
  row.names = FALSE
)

write.csv(
  data.frame(
    MouseSymbol = unmapped_background_symbols,
    stringsAsFactors = FALSE
  ),
  file = file.path(
    output_dir,
    "background_mouse_symbols_unmapped_to_entrez.csv"
  ),
  row.names = FALSE
)

# =============================================================================
# 6. MAP THE FOREGROUND MOUSE SYMBOLS TO ENTREZ IDS
# =============================================================================

foreground_map <- suppressMessages(
  clusterProfiler::bitr(
    foreground_symbols,
    fromType = "SYMBOL",
    toType = "ENTREZID",
    OrgDb = org.Mm.eg.db,
    drop = TRUE
  )
) %>%
  dplyr::transmute(
    MouseSymbol = as.character(SYMBOL),
    MouseEntrezID = as.character(ENTREZID)
  ) %>%
  dplyr::filter(
    is_valid_identifier(MouseSymbol),
    is_valid_identifier(MouseEntrezID)
  ) %>%
  dplyr::distinct()

unmapped_foreground_symbols <- setdiff(
  foreground_symbols,
  foreground_map$MouseSymbol
)

foreground_entrez_before_universe_check <- clean_entrez_ids(
  foreground_map$MouseEntrezID
)

foreground_entrez <- intersect(
  foreground_entrez_before_universe_check,
  background_entrez
)

foreground_map_used <- foreground_map %>%
  dplyr::filter(
    MouseEntrezID %in% foreground_entrez
  ) %>%
  dplyr::arrange(
    MouseSymbol,
    MouseEntrezID
  )

foreground_map_outside_universe <- foreground_map %>%
  dplyr::filter(
    !MouseEntrezID %in% background_entrez
  ) %>%
  dplyr::arrange(
    MouseSymbol,
    MouseEntrezID
  )

cat(
  "\nFOREGROUND MAPPING\n",
  "Mouse symbols supplied: ",
  length(foreground_symbols),
  "\n",
  "Mouse symbols successfully mapped: ",
  dplyr::n_distinct(foreground_map$MouseSymbol),
  "\n",
  "Mouse Entrez IDs before universe check: ",
  length(foreground_entrez_before_universe_check),
  "\n",
  "Mouse Entrez IDs used in enrichment: ",
  length(foreground_entrez),
  "\n",
  sep = ""
)

if (length(unmapped_foreground_symbols) > 0) {
  cat("\nUnmapped foreground mouse symbols:\n")
  print(unmapped_foreground_symbols)
}

if (nrow(foreground_map_outside_universe) > 0) {
  cat(
    "\nMapped foreground genes absent from the tested universe:\n"
  )
  print(foreground_map_outside_universe)
}

write.csv(
  foreground_map_used,
  file = file.path(
    output_dir,
    "foreground_mouse_symbol_to_entrez_used.csv"
  ),
  row.names = FALSE
)

write.csv(
  foreground_map_outside_universe,
  file = file.path(
    output_dir,
    "foreground_mapped_but_outside_tested_universe.csv"
  ),
  row.names = FALSE
)

write.csv(
  data.frame(
    MouseSymbol = unmapped_foreground_symbols,
    stringsAsFactors = FALSE
  ),
  file = file.path(
    output_dir,
    "foreground_unmapped_mouse_symbols.csv"
  ),
  row.names = FALSE
)

if (length(foreground_entrez) == 0) {
  stop(
    "No foreground mouse Entrez IDs remained after intersection with the ",
    "mapped 17,768-gene tested universe."
  )
}

if (
  length(foreground_entrez) <
  0.8 * length(foreground_entrez_before_universe_check)
) {
  warning(
    "Fewer than 80% of the mapped foreground Entrez IDs occur in the ",
    "tested universe. Inspect the exported mapping audit files."
  )
}

# =============================================================================
# 7. GO BIOLOGICAL PROCESS ENRICHMENT
# =============================================================================

ego <- clusterProfiler::enrichGO(
  gene = foreground_entrez,
  universe = background_entrez,
  OrgDb = org.Mm.eg.db,
  keyType = "ENTREZID",
  ont = "BP",
  pAdjustMethod = "BH",
  
  # Keep all returned tests; define significance using p.adjust below.
  pvalueCutoff = 1,
  qvalueCutoff = 1,
  
  minGSSize = min_gene_set_size,
  maxGSSize = max_gene_set_size,
  readable = TRUE
)

ego_df <- safe_result_dataframe(
  ego
)

ego_df <- add_enrichment_metrics(
  ego_df
)

if (nrow(ego_df) > 0) {
  ego_df <- ego_df %>%
    dplyr::arrange(
      p.adjust,
      dplyr::desc(FoldEnrichment)
    )
}

ego_significant <- ego_df %>%
  dplyr::filter(
    Significant_BH_FDR_0.05
  ) %>%
  dplyr::arrange(
    p.adjust,
    dplyr::desc(FoldEnrichment)
  )

# =============================================================================
# 8. KEGG MOUSE PATHWAY ENRICHMENT
# =============================================================================

ekegg <- clusterProfiler::enrichKEGG(
  gene = foreground_entrez,
  universe = background_entrez,
  organism = "mmu",
  keyType = "ncbi-geneid",
  pAdjustMethod = "BH",
  
  # Keep all returned tests; define significance using p.adjust below.
  pvalueCutoff = 1,
  qvalueCutoff = 1,
  
  minGSSize = min_gene_set_size,
  maxGSSize = max_gene_set_size,
  
  # FALSE means use online KEGG rather than old internal KEGG data.
  use_internal_data = FALSE
)

if (
  !is.null(ekegg) &&
  nrow(as.data.frame(ekegg)) > 0
) {
  ekegg <- clusterProfiler::setReadable(
    ekegg,
    OrgDb = org.Mm.eg.db,
    keyType = "ENTREZID"
  )
}

ekegg_df <- safe_result_dataframe(
  ekegg
)

ekegg_df <- add_enrichment_metrics(
  ekegg_df
)

if (nrow(ekegg_df) > 0) {
  ekegg_df <- ekegg_df %>%
    dplyr::arrange(
      p.adjust,
      dplyr::desc(FoldEnrichment)
    )
}

ekegg_significant <- ekegg_df %>%
  dplyr::filter(
    Significant_BH_FDR_0.05
  ) %>%
  dplyr::arrange(
    p.adjust,
    dplyr::desc(FoldEnrichment)
  )

# =============================================================================
# 9. SAVE ENRICHMENT TABLES
