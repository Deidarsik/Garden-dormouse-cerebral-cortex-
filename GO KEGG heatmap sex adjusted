cluster_df <- read.table(
  cluster_assignment_path,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  quote = "",
  comment.char = ""
)

if (!all(
  c(
    "GeneID",
    "RowCluster"
  ) %in% colnames(cluster_df)
)) {
  stop(
    "The cluster-assignment file must contain GeneID and RowCluster."
  )
}

cluster_df <- cluster_df %>%
  dplyr::transmute(
    GeneID = as.character(GeneID),
    RowCluster = as.integer(RowCluster)
  ) %>%
  dplyr::distinct()

cluster_summary <- read.table(
  cluster_summary_path,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  quote = "",
  comment.char = ""
)

required_summary_columns <- c(
  "RowCluster",
  "WarmMinusCold"
)

missing_summary_columns <- setdiff(
  required_summary_columns,
  colnames(cluster_summary)
)

if (length(missing_summary_columns) > 0) {
  stop(
    "The row-cluster summary is missing: ",
    paste(
      missing_summary_columns,
      collapse = ", "
    )
  )
}

cluster_summary <- cluster_summary %>%
  dplyr::mutate(
    RowCluster = as.integer(RowCluster),
    WarmMinusCold = as.numeric(WarmMinusCold)
  ) %>%
  dplyr::distinct(
    RowCluster,
    .keep_all = TRUE
  )

available_clusters <- sort(
  unique(
    cluster_df$RowCluster
  )
)

if (length(available_clusters) != 2) {
  stop(
    "Expected exactly two row clusters, but found: ",
    paste(
      available_clusters,
      collapse = ", "
    )
  )
}

if (!setequal(
  available_clusters,
  cluster_summary$RowCluster
)) {
  stop(
    "The row-cluster assignment and row-cluster summary ",
    "contain different cluster numbers."
  )
}

warm_cluster_number <- cluster_summary$RowCluster[
  which.max(
    cluster_summary$WarmMinusCold
  )
]

cold_cluster_number <- cluster_summary$RowCluster[
  which.min(
    cluster_summary$WarmMinusCold
  )
]

if (identical(
  warm_cluster_number,
  cold_cluster_number
)) {
  stop(
    "The Warm and Cold clusters could not be distinguished."
  )
}

cluster_label_lookup <- data.frame(
  RowCluster = c(
    warm_cluster_number,
    cold_cluster_number
  ),
  ThermalCluster = c(
    "Warm",
    "Cold"
  ),
  stringsAsFactors = FALSE
)

cluster_df <- cluster_df %>%
  dplyr::left_join(
    cluster_label_lookup,
    by = "RowCluster"
  )

if (any(is.na(cluster_df$ThermalCluster))) {
  stop(
    "At least one row cluster could not be labelled Warm or Cold."
  )
}

heatmap_zscore <- read.table(
  heatmap_zscore_path,
  header = TRUE,
  row.names = 1,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  quote = "",
  comment.char = ""
)

heatmap_gene_ids <- unique(
  as.character(
    rownames(heatmap_zscore)
  )
)

cluster_gene_ids <- unique(
  as.character(
    cluster_df$GeneID
  )
)

if (!setequal(
  heatmap_gene_ids,
  cluster_gene_ids
)) {
  stop(
    "The sex-adjusted heatmap matrix and cluster-assignment file ",
    "do not contain exactly the same genes."
  )
}

multi_cluster_genes <- cluster_df %>%
  dplyr::count(
    GeneID,
    name = "NClusters"
  ) %>%
  dplyr::filter(
    NClusters > 1
  )

if (nrow(multi_cluster_genes) > 0) {
  stop(
    "At least one heatmap gene belongs to more than one cluster."
  )
}

cat("\nSEX-ADJUSTED HEATMAP CLUSTERS\n")
cat(
  "Numeric warm-enriched cluster:",
  warm_cluster_number,
  "\n"
)
cat(
  "Numeric cold-enriched cluster:",
  cold_cluster_number,
  "\n"
)
print(
  cluster_summary[
    order(
      cluster_summary$WarmMinusCold,
      decreasing = TRUE
    ),
    ,
    drop = FALSE
  ],
  row.names = FALSE
)

# =============================================================================
# 5. READ ANNOTATIONS AND SEX-ADJUSTED FULL DE RESULTS
# =============================================================================

gene_annotations <- read.table(
  gene_annotations_path,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  quote = "",
  comment.char = ""
)

if (ncol(gene_annotations) == 0) {
  stop(
    "The annotation file contains no columns."
  )
}

colnames(gene_annotations)[1] <- "GeneID"

gene_annotations <- gene_annotations %>%
  dplyr::mutate(
    GeneID = as.character(GeneID)
  ) %>%
  dplyr::distinct(
    GeneID,
    .keep_all = TRUE
  )

if (!gene_symbol_column %in% colnames(gene_annotations)) {
  stop(
    "The annotation file does not contain the requested symbol column: ",
    gene_symbol_column,
    "\nAvailable columns:\n",
    paste(
      colnames(gene_annotations),
      collapse = ", "
    )
  )
}

gene_symbol_lookup <- gene_annotations %>%
  dplyr::transmute(
    GeneID = as.character(GeneID),
    GeneName = trimws(
      as.character(
        .data[[gene_symbol_column]]
      )
    ),
    HasUsableGeneSymbol = is_usable_gene_symbol(
      .data[[gene_symbol_column]]
    )
  ) %>%
  dplyr::distinct(
    GeneID,
    .keep_all = TRUE
  )

full_de_df <- read.table(
  full_de_results_path,
  header = TRUE,
  sep = "\t",
  stringsAsFactors = FALSE,
  check.names = FALSE,
  quote = "",
  comment.char = ""
)

if (!"GeneID" %in% colnames(full_de_df)) {
  stop(
    "The sex-adjusted full DE-results file does not contain GeneID."
  )
}

full_de_df <- full_de_df %>%
  dplyr::mutate(
    GeneID = as.character(GeneID)
  ) %>%
  dplyr::distinct(
    GeneID,
    .keep_all = TRUE
  )

heatmap_missing_from_full_results <- setdiff(
  heatmap_gene_ids,
  full_de_df$GeneID
)

if (length(heatmap_missing_from_full_results) > 0) {
  stop(
    "Some heatmap genes are absent from the sex-adjusted ",
    "full DE-results table."
  )
}

# =============================================================================
# 6. BUILD THE ELIGIBLE TESTED-GENE UNIVERSE
# =============================================================================

universe_source <- full_de_df %>%
  dplyr::select(
    GeneID
  ) %>%
  dplyr::left_join(
    gene_symbol_lookup,
    by = "GeneID"
  )

universe_long <- expand_symbol_column(
  universe_source,
  symbol_column = "GeneName",
  keep_cluster_label = FALSE
)

universe_symbol_map <- map_mouse_symbols(
  universe_long$InputSymbol
)

universe_gene_map <- universe_long %>%
  dplyr::inner_join(
    universe_symbol_map,
    by = "InputSymbol"
  ) %>%
  dplyr::distinct(
    GeneID,
    InputSymbol,
    MouseSymbol,
    ENTREZID,
    MappingType
  )

universe_entrez <- sort(
  unique(
    universe_gene_map$ENTREZID
  )
)

if (length(universe_entrez) == 0) {
  stop(
    "No tested genes with usable annotated symbols mapped ",
    "to mouse Entrez IDs."
  )
}

write_csv(
  universe_gene_map,
  file.path(
    output_root,
    "sex_adjusted_tested_gene_universe_mouse_mapping.csv"
  )
)

write_csv(
  data.frame(
    ENTREZID = universe_entrez,
    stringsAsFactors = FALSE
  ),
  file.path(
    output_root,
    "sex_adjusted_tested_gene_universe_EntrezIDs.csv"
  )
)

cat(
  "\nEligible sex-adjusted universe:",
  length(universe_entrez),
  "unique mouse Entrez IDs\n"
)

# =============================================================================
# 7. MAP THE EXACT WARM AND COLD HEATMAP CLUSTERS
# =============================================================================

heatmap_cluster_source <- cluster_df %>%
  dplyr::left_join(
    gene_symbol_lookup,
    by = "GeneID"
  )

heatmap_cluster_long <- expand_symbol_column(
  heatmap_cluster_source,
  symbol_column = "GeneName",
  keep_cluster_label = TRUE
)

heatmap_symbol_map <- map_mouse_symbols(
  heatmap_cluster_long$InputSymbol
)

cluster_gene_map_before_universe <- heatmap_cluster_long %>%
  dplyr::inner_join(
    heatmap_symbol_map,
    by = "InputSymbol"
  ) %>%
  dplyr::distinct(
    GeneID,
    GeneName = InputSymbol,
    RowCluster,
    ThermalCluster,
    MouseSymbol,
    ENTREZID,
    MappingType
  )

mapped_outside_universe <- cluster_gene_map_before_universe %>%
  dplyr::filter(
    !ENTREZID %in% universe_entrez
  )

write_csv(
  mapped_outside_universe,
  file.path(
    output_root,
    "AUDIT_mapped_heatmap_genes_outside_universe.csv"
  )
)

if (nrow(mapped_outside_universe) > 0) {
  stop(
    "Some mapped heatmap genes are absent from the eligible ",
    "sex-adjusted universe."
  )
}

cluster_gene_map <- cluster_gene_map_before_universe %>%
  dplyr::filter(
    ENTREZID %in% universe_entrez
  ) %>%
  dplyr::distinct()

# =============================================================================
# 8. AUDIT EVERY HEATMAP ROW
# =============================================================================

valid_symbol_status <- heatmap_cluster_source %>%
  dplyr::transmute(
    GeneID,
    RowCluster,
    ThermalCluster,
    GeneName,
    HasUsableGeneSymbol = is_usable_gene_symbol(
      GeneName
    )
  )

mapped_status <- cluster_gene_map_before_universe %>%
  dplyr::distinct(
    GeneID,
    RowCluster,
    ThermalCluster
  ) %>%
  dplyr::mutate(
    MappedToMouseEntrez = TRUE
  )

used_status <- cluster_gene_map %>%
  dplyr::distinct(
    GeneID,
    RowCluster,
    ThermalCluster
  ) %>%
  dplyr::mutate(
    UsedForEnrichment = TRUE
  )

heatmap_gene_flow_audit <- valid_symbol_status %>%
  dplyr::left_join(
    mapped_status,
    by = c(
      "GeneID",
      "RowCluster",
      "ThermalCluster"
    )
  ) %>%
  dplyr::left_join(
    used_status,
    by = c(
      "GeneID",
      "RowCluster",
      "ThermalCluster"
    )
  ) %>%
  dplyr::mutate(
    MappedToMouseEntrez = tidyr::replace_na(
      MappedToMouseEntrez,
      FALSE
    ),
    UsedForEnrichment = tidyr::replace_na(
      UsedForEnrichment,
      FALSE
    ),
    DisplayLabel = dplyr::if_else(
      HasUsableGeneSymbol,
      GeneName,
      GeneID
    ),
    Status = dplyr::case_when(
      UsedForEnrichment ~
        "Used for GO/KEGG",
      
      !HasUsableGeneSymbol ~
        "Excluded: no annotated Gene_name (Equ03-only row)",
      
      HasUsableGeneSymbol & !MappedToMouseEntrez ~
        "Excluded: Gene_name did not map to mouse Entrez",
      
      MappedToMouseEntrez & !UsedForEnrichment ~
        "ERROR: mapped gene absent from universe",
      
      TRUE ~
        "Unknown"
    )
  ) %>%
  dplyr::arrange(
    factor(
      ThermalCluster,
      levels = c(
        "Warm",
        "Cold"
      )
    ),
    Status,
    DisplayLabel
  )

write_csv(
  heatmap_gene_flow_audit,
  file.path(
    output_root,
    "AUDIT_every_sex_adjusted_heatmap_gene_to_enrichment.csv"
  )
)

cluster_input_counts <- heatmap_gene_flow_audit %>%
  dplyr::group_by(
    ThermalCluster,
    RowCluster
  ) %>%
  dplyr::summarise(
    HeatmapRows = dplyr::n_distinct(GeneID),
    RowsWithAnnotatedGeneName = dplyr::n_distinct(
      GeneID[HasUsableGeneSymbol]
    ),
    RowsUsedForEnrichment = dplyr::n_distinct(
      GeneID[UsedForEnrichment]
    ),
    .groups = "drop"
  ) %>%
  dplyr::left_join(
    cluster_gene_map %>%
      dplyr::group_by(
        ThermalCluster,
        RowCluster
      ) %>%
      dplyr::summarise(
        UniqueMouseEntrezIDs = dplyr::n_distinct(
          ENTREZID
        ),
        .groups = "drop"
      ),
    by = c(
      "ThermalCluster",
      "RowCluster"
    )
  ) %>%
  dplyr::mutate(
    UniqueMouseEntrezIDs = tidyr::replace_na(
      UniqueMouseEntrezIDs,
      0L
    ),
    ExcludedRows = HeatmapRows - RowsUsedForEnrichment
  ) %>%
  dplyr::arrange(
    factor(
      ThermalCluster,
      levels = c(
        "Warm",
        "Cold"
      )
    )
  )

write_csv(
  cluster_input_counts,
  file.path(
    output_root,
    "AUDIT_warm_cold_cluster_input_counts.csv"
  )
)

write_csv(
  cluster_gene_map,
  file.path(
    output_root,
    "EXACT_warm_cold_usable_genes_for_GO_KEGG.csv"
  )
)

cat("\nWARM/COLD FOREGROUND AUDIT\n")
print(
  cluster_input_counts,
  row.names = FALSE
)

# =============================================================================
# 9. PLOT SETTINGS
