# =============================================================================
# 10. RUN GO AND KEGG FOR ONE THERMAL CLUSTER
# =============================================================================

run_thermal_cluster_enrichment <- function(
    thermal_cluster,
    cluster_gene_map,
    heatmap_gene_flow_audit,
    universe_entrez,
    output_root,
    pvalue_cutoff,
    qvalue_cutoff,
    top_terms_to_plot) {
  
  cluster_slug <- tolower(
    thermal_cluster
  )
  
  cluster_dir <- file.path(
    output_root,
    paste0(
      cluster_slug,
      "_cluster"
    )
  )
  
  dir.create(
    cluster_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  all_heatmap_rows_here <- heatmap_gene_flow_audit %>%
    dplyr::filter(
      ThermalCluster == thermal_cluster
    ) %>%
    dplyr::arrange(
      DisplayLabel,
      GeneID
    )
  
  usable_rows_here <- cluster_gene_map %>%
    dplyr::filter(
      ThermalCluster == thermal_cluster
    ) %>%
    dplyr::arrange(
      MouseSymbol,
      ENTREZID,
      GeneName,
      GeneID
    )
  
  genes_here <- sort(
    unique(
      usable_rows_here$ENTREZID
    )
  )
  
  write_csv(
    all_heatmap_rows_here,
    file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_ALL_heatmap_rows_with_mapping_status.csv"
      )
    )
  )
  
  writeLines(
    unique(
      all_heatmap_rows_here$DisplayLabel
    ),
    con = file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_ALL_heatmap_labels_one_per_line.txt"
      )
    )
  )
  
  write_csv(
    usable_rows_here,
    file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_EXACT_usable_genes_for_GO_KEGG.csv"
      )
    )
  )
  
  write_csv(
    data.frame(
      ENTREZID = genes_here,
      stringsAsFactors = FALSE
    ),
    file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_EXACT_GO_KEGG_foreground_EntrezIDs.csv"
      )
    )
  )
  
  writeLines(
    genes_here,
    con = file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_EXACT_GO_KEGG_foreground_EntrezIDs_one_per_line.txt"
      )
    )
  )
  
  cat("\n============================================================\n")
  cat(
    toupper(thermal_cluster),
    "-ENRICHED HEATMAP CLUSTER\n",
    sep = ""
  )
  cat(
    "All heatmap rows:",
    dplyr::n_distinct(
      all_heatmap_rows_here$GeneID
    ),
    "\n"
  )
  cat(
    "Rows used for enrichment:",
    dplyr::n_distinct(
      usable_rows_here$GeneID
    ),
    "\n"
  )
  cat(
    "Unique mouse Entrez IDs:",
    length(genes_here),
    "\n"
  )
  
  if (length(genes_here) == 0) {
    warning(
      thermal_cluster,
      " cluster has no usable mapped genes. Enrichment skipped."
    )
    
    return(NULL)
  }
  
  if (!all(
    genes_here %in% universe_entrez
  )) {
    stop(
      thermal_cluster,
      " foreground contains Entrez IDs outside the universe."
    )
  }
  
  ego <- clusterProfiler::enrichGO(
    gene = genes_here,
    universe = universe_entrez,
    OrgDb = org.Mm.eg.db,
    keyType = "ENTREZID",
    ont = "BP",
    pAdjustMethod = "BH",
    pvalueCutoff = pvalue_cutoff,
    qvalueCutoff = qvalue_cutoff,
    readable = TRUE
  )
  
  ego_df <- add_rich_factor(
    as.data.frame(ego)
  )
  
  ekegg <- clusterProfiler::enrichKEGG(
    gene = genes_here,
    universe = universe_entrez,
    organism = "mmu",
    keyType = "ncbi-geneid",
    pvalueCutoff = pvalue_cutoff,
    pAdjustMethod = "BH",
    qvalueCutoff = qvalue_cutoff
  )
  
  if (nrow(
    as.data.frame(ekegg)
  ) > 0) {
    ekegg <- clusterProfiler::setReadable(
      ekegg,
      OrgDb = org.Mm.eg.db,
      keyType = "ENTREZID"
    )
  }
  
  ekegg_df <- add_rich_factor(
    as.data.frame(ekegg)
  )
  
  write_csv(
    ego_df,
    file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_GO_BP_enrichment.csv"
      )
    )
  )
  
  write_csv(
    ekegg_df,
    file.path(
      cluster_dir,
      paste0(
        cluster_slug,
        "_KEGG_mouse_enrichment.csv"
      )
    )
  )
  
  if (nrow(ego_df) > 0) {
    top_go <- ego_df %>%
      dplyr::arrange(
        dplyr::desc(RichFactor)
      ) %>%
      utils::head(
        top_terms_to_plot
      ) %>%
      add_rich_group()
    
    go_plot <- ggplot2::ggplot(
      top_go,
      ggplot2::aes(
        x = RichFactor,
        y = reorder(
          Description,
          RichFactor
        ),
        color = RichGroup,
        size = Count
      )
    ) +
      ggplot2::geom_point(
        alpha = 0.9
      ) +
      ggplot2::scale_color_manual(
        values = three_cols,
        drop = FALSE
      ) +
      ggplot2::labs(
        title = paste0(
          thermal_cluster,
          "-enriched cluster: GO Biological Process"
        ),
        x = "Rich Factor",
        y = "GO term",
        color = "Rich Factor",
        size = "Gene Count"
      ) +
      clean_theme
    
    ggplot2::ggsave(
      filename = file.path(
        cluster_dir,
        paste0(
          cluster_slug,
          "_GO_RichFactor_dotplot.pdf"
        )
      ),
      plot = go_plot,
      width = 8,
      height = 6
    )
  } else {
    cat(
      thermal_cluster,
      " cluster: no significant GO BP terms.\n",
      sep = ""
    )
  }
  
  if (nrow(ekegg_df) > 0) {
    top_kegg <- ekegg_df %>%
      dplyr::arrange(
        dplyr::desc(RichFactor)
      ) %>%
      utils::head(
        top_terms_to_plot
      ) %>%
      add_rich_group()
    
    kegg_plot <- ggplot2::ggplot(
      top_kegg,
      ggplot2::aes(
        x = RichFactor,
        y = reorder(
          Description,
          RichFactor
        ),
        fill = RichGroup
      )
    ) +
      ggplot2::geom_col(
        width = 0.75
      ) +
      ggplot2::scale_fill_manual(
        values = three_cols,
        drop = FALSE
      ) +
      ggplot2::labs(
        title = paste0(
          thermal_cluster,
          "-enriched cluster: KEGG pathways"
        ),
        x = "Rich Factor",
        y = "KEGG pathway",
        fill = "Rich Factor"
      ) +
      clean_theme
    
    ggplot2::ggsave(
      filename = file.path(
        cluster_dir,
        paste0(
          cluster_slug,
          "_KEGG_RichFactor_barplot.pdf"
        )
      ),
      plot = kegg_plot,
      width = 8,
      height = 6
    )
  } else {
    cat(
      thermal_cluster,
      " cluster: no significant KEGG pathways.\n",
      sep = ""
    )
  }
  
  list(
    ThermalCluster = thermal_cluster,
    foreground_mapping = usable_rows_here,
    foreground_entrez = genes_here,
    GO = ego,
    GO_table = ego_df,
    KEGG = ekegg,
    KEGG_table = ekegg_df
  )
}

