#!/usr/bin/env Rscript

###############################################################################
# GO_KEGG_sex_adjusted_warm_cold_heatmap_clusters.R
#
# PURPOSE
#   Run GO Biological Process and KEGG enrichment separately for the
#   warm-enriched and cold-enriched row clusters from the SEX-ADJUSTED
#   warm-versus-cold heatmap.
#
# IMPORTANT
#   1. The script reads the outputs produced by:
#        warm_vs_cold_heatmap_sex_adjusted.R
#   2. It determines automatically which numeric row cluster is Warm and
#      which is Cold from the row-cluster summary:
#        Warm = largest WarmMinusCold
#        Cold = smallest WarmMinusCold
#   3. It uses the SEX-ADJUSTED full differential-expression table to build
#      the tested-gene universe.
#   4. As requested, heatmap rows without a valid annotated Gene_name are
#      excluded from both the foreground and the eligible background.
#      Therefore rows displayed only as Equ03.xxxxx are not submitted to
#      GO or KEGG.
###############################################################################

