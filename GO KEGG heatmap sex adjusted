is_valid_identifier <- function(x) {
  x <- trimws(as.character(x))
  
  !is.na(x) &
    x != "" &
    !(toupper(x) %in% c(
      "NA",
      "N/A",
      "NONE",
      "NULL",
      "UNKNOWN",
      "UNANNOTATED",
      "NO",
      "FALSE",
      "-",
      ".",
      "?"
    ))
}

is_usable_gene_symbol <- function(x) {
  x <- trimws(as.character(x))
  
  valid <- is_valid_identifier(x)
  
  if (exclude_equ03_only_rows) {
    valid <- valid & !grepl(
      "^Equ03\\.",
      x,
      ignore.case = TRUE
    )
  }
  
  valid
}

write_csv <- function(x, path) {
  write.csv(
    x,
    file = path,
    row.names = FALSE,
    na = ""
  )
}

expand_symbol_column <- function(
    df,
    symbol_column,
    keep_cluster_label = FALSE) {
  
  required_columns <- c(
    "GeneID",
    symbol_column
  )
  
  if (keep_cluster_label) {
    required_columns <- c(
      required_columns,
      "RowCluster",
      "ThermalCluster"
    )
  }
  
  missing_columns <- setdiff(
    required_columns,
    colnames(df)
  )
  
  if (length(missing_columns) > 0) {
    stop(
      "Missing required columns: ",
      paste(missing_columns, collapse = ", ")
    )
  }
  
  if (keep_cluster_label) {
    out <- df %>%
      dplyr::transmute(
        GeneID = as.character(GeneID),
        RowCluster = as.integer(RowCluster),
        ThermalCluster = as.character(ThermalCluster),
        InputSymbol = trimws(
          as.character(.data[[symbol_column]])
        )
      )
  } else {
    out <- df %>%
      dplyr::transmute(
        GeneID = as.character(GeneID),
        InputSymbol = trimws(
          as.character(.data[[symbol_column]])
        )
      )
  }
  
  out %>%
    dplyr::filter(
      is_usable_gene_symbol(InputSymbol)
    ) %>%
    tidyr::separate_rows(
      InputSymbol,
      sep = "\\s*[,;|]+\\s*"
    ) %>%
    dplyr::mutate(
      InputSymbol = trimws(InputSymbol)
    ) %>%
    dplyr::filter(
      is_usable_gene_symbol(InputSymbol)
    ) %>%
    dplyr::distinct()
}

map_mouse_symbols <- function(symbols) {
  symbols <- unique(
    trimws(
      as.character(symbols)
    )
  )
  
  symbols <- symbols[
    is_usable_gene_symbol(symbols)
  ]
  
  empty_result <- data.frame(
    InputSymbol = character(),
    ENTREZID = character(),
    MouseSymbol = character(),
    MappingType = character(),
    stringsAsFactors = FALSE
  )
  
  if (length(symbols) == 0) {
    return(empty_result)
  }
  
  direct_map <- suppressMessages(
    AnnotationDbi::select(
      org.Mm.eg.db,
      keys = symbols,
      keytype = "SYMBOL",
      columns = c(
        "ENTREZID",
        "SYMBOL"
      )
    )
  )
  
  if (is.null(direct_map) || nrow(direct_map) == 0) {
    direct_result <- empty_result
  } else {
    direct_result <- direct_map %>%
      dplyr::transmute(
        InputSymbol = as.character(SYMBOL),
        ENTREZID = as.character(ENTREZID),
        MouseSymbol = as.character(SYMBOL),
        MappingType = "SYMBOL"
      ) %>%
      dplyr::filter(
        is_valid_identifier(InputSymbol),
        is_valid_identifier(ENTREZID)
      ) %>%
      dplyr::distinct()
  }
  
  directly_mapped_symbols <- unique(
    direct_result$InputSymbol
  )
  
  alias_candidates <- setdiff(
    symbols,
    directly_mapped_symbols
  )
  
  if (length(alias_candidates) == 0) {
    alias_result <- empty_result
  } else {
    alias_map <- suppressMessages(
      AnnotationDbi::select(
        org.Mm.eg.db,
        keys = alias_candidates,
        keytype = "ALIAS",
        columns = c(
          "ENTREZID",
          "SYMBOL"
        )
      )
    )
    
    if (is.null(alias_map) || nrow(alias_map) == 0) {
      alias_result <- empty_result
    } else {
      alias_result <- alias_map %>%
        dplyr::transmute(
          InputSymbol = as.character(ALIAS),
          ENTREZID = as.character(ENTREZID),
          MouseSymbol = as.character(SYMBOL),
          MappingType = "ALIAS"
        ) %>%
        dplyr::filter(
          is_valid_identifier(InputSymbol),
          is_valid_identifier(ENTREZID)
        ) %>%
        dplyr::distinct()
    }
  }
  
  dplyr::bind_rows(
    direct_result,
    alias_result
  ) %>%
    dplyr::distinct(
      InputSymbol,
      ENTREZID,
      MouseSymbol,
      .keep_all = TRUE
    )
}

add_rich_factor <- function(df) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  df %>%
    dplyr::mutate(
      BackgroundTermGenes = as.numeric(
        sub(
          "/.*",
          "",
          BgRatio
        )
      ),
      RichFactor = Count / BackgroundTermGenes
    )
}

add_rich_group <- function(df) {
  if (nrow(df) == 0) {
    return(df)
  }
  
  if (nrow(df) == 1) {
    df$RichGroup <- factor(
      "Low",
      levels = c(
        "Low",
        "Medium",
        "High"
      )
    )
    
    return(df)
  }
  
  df %>%
    dplyr::mutate(
      RichGroup = factor(
        c(
          "Low",
          "Medium",
          "High"
        )[
          dplyr::ntile(
            rank(
              RichFactor,
              ties.method = "first"
            ),
            3
          )
        ],
        levels = c(
          "Low",
          "Medium",
          "High"
        )
      )
    )
}

