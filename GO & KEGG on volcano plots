safe_query_biomart <- function(
    dataset_name,
    gene_ids
) {
  
  if (length(gene_ids) == 0) {
    return(
      data.frame(
        Target_gene = character(0),
        queried_gene_biotype = character(0),
        stringsAsFactors = FALSE
      )
    )
  }
  
  tryCatch(
    {
      
      dataset_mart <- useMart(
        biomart = "ensembl",
        dataset = dataset_name,
        host = "https://www.ensembl.org"
      )
      
      queried_info <- getBM(
        attributes = c(
          "ensembl_gene_id",
          "gene_biotype"
        ),
        filters = "ensembl_gene_id",
        values = gene_ids,
        mart = dataset_mart
      )
      
      colnames(queried_info) <- c(
        "Target_gene",
        "queried_gene_biotype"
      )
      
      queried_info %>%
        dplyr::distinct(
          Target_gene,
          .keep_all = TRUE
        )
      
    },
    error = function(e) {
      
      message(
        "Could not query dataset ",
        dataset_name,
        ": ",
        conditionMessage(e)
      )
      
      data.frame(
        Target_gene = character(0),
        queried_gene_biotype = character(0),
        stringsAsFactors = FALSE
      )
    }
  )
}

