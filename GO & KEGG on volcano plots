add_rich_factor <- function(df) {
  if (nrow(df) == 0 || !all(c("Count", "BgRatio") %in% colnames(df))) {
    return(df)
  }
  
  df %>%
    dplyr::mutate(
      BackgroundTermGenes = as.numeric(sub("/.*", "", BgRatio)),
      RichFactor = Count / BackgroundTermGenes
    )
}

run_go <- function(foreground_entrez) {
  if (length(foreground_entrez) == 0) return(NULL)
  
  tryCatch(
    clusterProfiler::enrichGO(
      gene = foreground_entrez,
      universe = background_entrez,
      OrgDb = org.Mm.eg.db,
      keyType = "ENTREZID",
      ont = go_ontology,
      pAdjustMethod = "BH",
      pvalueCutoff = 1,
      qvalueCutoff = 1,
      readable = TRUE
    ),
    error = function(e) {
      warning("GO enrichment failed: ", conditionMessage(e))
      NULL
    }
  )
}

run_kegg <- function(foreground_entrez) {
  if (length(foreground_entrez) == 0) return(NULL)
  
  tryCatch(
    clusterProfiler::enrichKEGG(
      gene = foreground_entrez,
      universe = background_entrez,
      organism = "mmu",
      keyType = "ncbi-geneid",
      pAdjustMethod = "BH",
      pvalueCutoff = 1,
      qvalueCutoff = 1
    ),
    error = function(e) {
      warning("KEGG enrichment failed: ", conditionMessage(e))
      NULL
    }
  )
}

object_to_table <- function(enrichment_object) {
  if (is.null(enrichment_object)) {
    return(data.frame())
  }
  
  as.data.frame(enrichment_object) %>%
    add_rich_factor() %>%
    dplyr::arrange(p.adjust, dplyr::desc(RichFactor))
}

make_empty_plot <- function(title_text, message_text) {
  ggplot2::ggplot() +
    ggplot2::annotate("text", x = 0, y = 0, label = message_text, size = 5) +
    ggplot2::xlim(-1, 1) +
    ggplot2::ylim(-1, 1) +
    ggplot2::labs(title = title_text) +
    ggplot2::theme_void() +
    ggplot2::theme(
      plot.title = ggplot2::element_text(face = "bold", hjust = 0.5, size = 14)
    )
}

make_go_plot <- function(significant_table, title_text) {
  if (nrow(significant_table) == 0) {
    return(make_empty_plot(
      title_text,
      paste0("No GO BP terms at BH-adjusted P < ", enrichment_fdr_cutoff)
    ))
  }
  
  plot_table <- significant_table %>%
    dplyr::slice_head(n = top_terms_to_plot) %>%
    dplyr::mutate(Description = factor(Description, levels = rev(Description)))
  
  ggplot2::ggplot(
    plot_table,
    ggplot2::aes(
      x = RichFactor,
      y = Description,
      size = Count,
      color = -log10(p.adjust)
    )
  ) +
    ggplot2::geom_point(alpha = 0.9) +
    ggplot2::scale_color_viridis_c(option = "D") +
    ggplot2::labs(
      title = title_text,
      x = "Rich factor",
      y = "GO Biological Process",
      size = "Gene count",
      color = expression(-log[10](adjusted~P))
    ) +
    ggplot2::theme_classic() +
    ggplot2::theme(
      plot.title = ggplot2::element_text(face = "bold", hjust = 0.5, size = 14),
      axis.title = ggplot2::element_text(face = "bold"),
      axis.text.y = ggplot2::element_text(size = 9)
    )
}

make_kegg_plot <- function(significant_table, title_text) {
  if (nrow(significant_table) == 0) {
    return(make_empty_plot(
      title_text,
      paste0("No KEGG pathways at BH-adjusted P < ", enrichment_fdr_cutoff)
    ))
  }
  
  plot_table <- significant_table %>%
    dplyr::slice_head(n = top_terms_to_plot) %>%
    dplyr::mutate(Description = factor(Description, levels = rev(Description)))
  
  ggplot2::ggplot(
    plot_table,
    ggplot2::aes(
      x = RichFactor,
      y = Description,
      fill = -log10(p.adjust)
    )
  ) +
    ggplot2::geom_col(width = 0.75) +
    ggplot2::scale_fill_viridis_c(option = "D") +
    ggplot2::labs(
      title = title_text,
      x = "Rich factor",
      y = "KEGG pathway",
      fill = expression(-log[10](adjusted~P))
    ) +
    ggplot2::theme_classic() +
    ggplot2::theme(
      plot.title = ggplot2::element_text(face = "bold", hjust = 0.5, size = 14),
      axis.title = ggplot2::element_text(face = "bold"),
      axis.text.y = ggplot2::element_text(size = 9)
    )
}

# =============================================================================
# 5. RUN SIX CONTRASTS x TWO edgeR DIRECTIONS x GO/KEGG
# =============================================================================

all_results <- list()
summary_rows <- list()
summary_index <- 1L

for (contrast_name in contrast_order) {
  result_table <- unadjusted_analysis$results_list[[contrast_name]] %>%
    dplyr::mutate(
      GeneID = as.character(GeneID),
      Significance = as.character(Significance)
    ) %>%
    dplyr::distinct(GeneID, .keep_all = TRUE)
  
  missing_columns <- setdiff(
    c("GeneID", "logFC", "FDR", "Significance"),
    colnames(result_table)
  )
  if (length(missing_columns) > 0) {
    stop(
      "Missing columns in ", contrast_name, ": ",
      paste(missing_columns, collapse = ", ")
    )
  }
  
  contrast_parts <- strsplit(contrast_name, "_vs_", fixed = TRUE)[[1]]
  first_group <- contrast_parts[1]
  second_group <- contrast_parts[2]
  
  all_results[[contrast_name]] <- list()
  
  for (direction in direction_order) {
    direction_dir <- file.path(output_dir, contrast_name, direction)
    dir.create(direction_dir, recursive = TRUE, showWarnings = FALSE)
    
    # Use the exact edgeR direction definition from the supplied script.
    foreground_original <- result_table %>%
      dplyr::filter(
        FDR < deg_fdr_cutoff,
        Significance == direction
      ) %>%
      dplyr::left_join(
        gene_annotations_clean %>%
          dplyr::select(GeneID, MouseInputOriginal),
        by = "GeneID"
      ) %>%
      dplyr::distinct(GeneID, .keep_all = TRUE)
    
    # Defensive verification that Significance agrees with logFC.
    if (direction == "Upregulated" && any(foreground_original$logFC <= 0)) {
      stop(contrast_name, ": Upregulated contains non-positive logFC values.")
    }
    if (direction == "Downregulated" && any(foreground_original$logFC >= 0)) {
      stop(contrast_name, ": Downregulated contains non-negative logFC values.")
    }
    
    foreground_mapping <- foreground_original %>%
      dplyr::select(GeneID, MouseInputOriginal) %>%
      expand_mouse_ids() %>%
      map_to_mouse_entrez() %>%
      dplyr::filter(ENTREZID %in% background_entrez) %>%
      dplyr::left_join(
        foreground_original %>%
          dplyr::select(dplyr::any_of(c(
            "GeneID", "logFC", "logCPM", "F", "PValue", "FDR", "Significance"
          ))),
        by = "GeneID"
      ) %>%
      dplyr::distinct()
    
    foreground_entrez <- sort(unique(foreground_mapping$ENTREZID))
    
    if (!all(foreground_entrez %in% background_entrez)) {
      stop(contrast_name, "/", direction, ": foreground is outside background.")
    }
    
    write.csv(
      foreground_original,
      file.path(direction_dir, "01_all_edgeR_DEGs_before_mouse_mapping.csv"),
      row.names = FALSE
    )
    
    write.csv(
      foreground_mapping,
      file.path(direction_dir, "02_usable_mouse_ortholog_mapping.csv"),
      row.names = FALSE
    )
    
    write.csv(
      data.frame(ENTREZID = foreground_entrez),
      file.path(direction_dir, "03_foreground_mouse_EntrezIDs.csv"),
      row.names = FALSE
    )
    
    go_object <- run_go(foreground_entrez)
    kegg_object <- run_kegg(foreground_entrez)
    
    go_all <- object_to_table(go_object)
    kegg_all <- object_to_table(kegg_object)
    
    go_significant <- if (nrow(go_all) == 0) {
      go_all
    } else {
      go_all %>% dplyr::filter(!is.na(p.adjust), p.adjust < enrichment_fdr_cutoff)
    }
    
    kegg_significant <- if (nrow(kegg_all) == 0) {
      kegg_all
    } else {
      kegg_all %>% dplyr::filter(!is.na(p.adjust), p.adjust < enrichment_fdr_cutoff)
    }
    
    write.csv(go_all, file.path(direction_dir, "04_GO_BP_all_tested_terms.csv"), row.names = FALSE)
    write.csv(go_significant, file.path(direction_dir, "05_GO_BP_significant_terms.csv"), row.names = FALSE)
    write.csv(kegg_all, file.path(direction_dir, "06_KEGG_all_tested_pathways.csv"), row.names = FALSE)
    write.csv(kegg_significant, file.path(direction_dir, "07_KEGG_significant_pathways.csv"), row.names = FALSE)
    
    higher_group <- if (direction == "Upregulated") first_group else second_group
    direction_subtitle <- paste0(direction, "; higher in ", higher_group)
    
    go_plot <- make_go_plot(
      go_significant,
      paste0(gsub("_vs_", " vs ", contrast_name), ": ", direction_subtitle, " — GO BP")
    )
    
    kegg_plot <- make_kegg_plot(
      kegg_significant,
      paste0(gsub("_vs_", " vs ", contrast_name), ": ", direction_subtitle, " — KEGG")
    )
    
    ggplot2::ggsave(
      file.path(direction_dir, "08_GO_BP_plot.pdf"),
      go_plot,
      width = 9,
      height = 7
    )
    
    ggplot2::ggsave(
      file.path(direction_dir, "09_KEGG_plot.pdf"),
      kegg_plot,
      width = 9,
      height = 7
    )
    
    summary_rows[[summary_index]] <- data.frame(
      Contrast = contrast_name,
      Direction = direction,
      Higher_in_group = higher_group,
      DEG_FDR_cutoff = deg_fdr_cutoff,
      Original_DEGs = nrow(foreground_original),
      Original_DEGs_with_usable_mouse_ortholog = dplyr::n_distinct(foreground_mapping$GeneID),
      Unique_mouse_Entrez_foreground = length(foreground_entrez),
      Unique_mouse_Entrez_background = background_entrez_count,
      Enrichment_BH_cutoff = enrichment_fdr_cutoff,
      Significant_GO_BP_terms = nrow(go_significant),
      Significant_KEGG_pathways = nrow(kegg_significant),
      stringsAsFactors = FALSE
    )
    
    all_results[[contrast_name]][[direction]] <- list(
      foreground_original = foreground_original,
      foreground_mapping = foreground_mapping,
      foreground_entrez = foreground_entrez,
      GO_object = go_object,
      GO_all = go_all,
      GO_significant = go_significant,
      KEGG_object = kegg_object,
      KEGG_all = kegg_all,
      KEGG_significant = kegg_significant
    )
    
    summary_index <- summary_index + 1L
  }
}

