is_valid_id <- function(x) {
  x <- trimws(as.character(x))
  !is.na(x) & x != "" & !(x %in% c("-", ".", "NA", "N/A", "NULL", "?"))
}

expand_mouse_ids <- function(df) {
  df %>%
    dplyr::select(GeneID, MouseInputOriginal) %>%
    dplyr::filter(is_valid_id(MouseInputOriginal)) %>%
    tidyr::separate_rows(MouseInputOriginal, sep = "\\s*[,;|]+\\s*") %>%
    dplyr::mutate(
      MouseInputOriginal = trimws(MouseInputOriginal),
      MouseInput = dplyr::case_when(
        mouse_id_keytype == "ENSEMBL" ~ sub("\\.[0-9]+$", "", MouseInputOriginal),
        TRUE ~ MouseInputOriginal
      )
    ) %>%
    dplyr::filter(is_valid_id(MouseInput)) %>%
    # When ENSEMBL is selected, retain only mouse Ensembl gene IDs. This
    # intentionally excludes ENSSTOG and other non-mouse Ensembl identifiers.
    dplyr::filter(
      mouse_id_keytype != "ENSEMBL" | grepl("^ENSMUSG", MouseInput)
    ) %>%
    dplyr::distinct()
}

map_to_mouse_entrez <- function(expanded_ids) {
  if (nrow(expanded_ids) == 0) {
    return(data.frame(
      GeneID = character(),
      MouseInputOriginal = character(),
      MouseInput = character(),
      ENTREZID = character(),
      MouseSymbol = character(),
      stringsAsFactors = FALSE
    ))
  }
  
  mapped <- suppressMessages(
    AnnotationDbi::select(
      org.Mm.eg.db,
      keys = unique(expanded_ids$MouseInput),
      keytype = mouse_id_keytype,
      columns = c("ENTREZID", "SYMBOL")
    )
  )
  
  mapped <- data.frame(
    MouseInput = as.character(mapped[[mouse_id_keytype]]),
    ENTREZID = as.character(mapped$ENTREZID),
    MouseSymbol = as.character(mapped$SYMBOL),
    stringsAsFactors = FALSE
  ) %>%
    dplyr::filter(is_valid_id(MouseInput), is_valid_id(ENTREZID)) %>%
    dplyr::distinct()
  
  expanded_ids %>%
    dplyr::inner_join(mapped, by = "MouseInput", relationship = "many-to-many") %>%
    dplyr::distinct(GeneID, MouseInputOriginal, MouseInput, ENTREZID, MouseSymbol)
}

