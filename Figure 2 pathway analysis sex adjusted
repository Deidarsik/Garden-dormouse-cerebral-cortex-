# =============================================================================
# 10. RUN ENRICHMENT FOR ONE EXACT REVERSAL CLASS
# =============================================================================

run_reversal_class_enrichment <- function(
    class_table,
    class_key,
    class_title
) {
  class_dir <- file.path(
    output_root,
    class_key
  )
  
  dir.create(
    class_dir,
    recursive = TRUE,
    showWarnings = FALSE
  )
  
  original_genes <- class_table %>%
    dplyr::distinct(
      GeneID,
      .keep_all = TRUE
    ) %>%
    dplyr::left_join(
      gene_annotations,
      by = "GeneID"
    )
  
  class_long <- expand_mouse_identifiers(
    original_genes,
    identifier_col = mouse_ortholog_col
  )
  
  class_id_map <- map_mouse_identifiers(
    class_long,
    from_type = mouse_key_type
  )
  
  mapped_before_universe <- class_long %>%
    dplyr::inner_join(
      class_id_map,
      by = "MouseInput",
      relationship = "many-to-many"
    ) %>%
    dplyr::distinct(
      GeneID,
      MouseInputOriginal,
      MouseInput,
      ENTREZID,
      MouseSymbol
    )
  
  mapped_foreground <- mapped_before_universe %>%
    dplyr::filter(
      ENTREZID %in% universe_entrez
    ) %>%
    dplyr::left_join(
      original_genes %>%
        dplyr::select(
          dplyr::any_of(
            c(
              "GeneID",
              "ReversalClass",
              "logFC_TE_TL",
              "FDR_TE_TL",
              "logFC_TL_AE",
              "FDR_TL_AE",
              "Gene_name",
              "Mmu_gene_name",
              "Mmu_Gene_name",
              mouse_ortholog_col
            )
          )
        ),
      by = "GeneID"
    ) %>%
    dplyr::distinct()
  
  foreground_entrez <- sort(
    unique(mapped_foreground$ENTREZID)
  )
  
  # One row per original dormouse gene showing exactly why it was or was not
  # used in enrichment.
  valid_input_status <- class_long %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(HasValidMouseInput = TRUE)
  
  mapped_status <- mapped_before_universe %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(MappedToMouseEntrez = TRUE)
  
  used_status <- mapped_foreground %>%
    dplyr::distinct(GeneID) %>%
    dplyr::mutate(UsedForEnrichment = TRUE)
  
  audit <- original_genes %>%
    dplyr::distinct(
      GeneID,
      .keep_all = TRUE
    ) %>%
    dplyr::left_join(
      valid_input_status,
      by = "GeneID"
    ) %>%
    dplyr::left_join(
      mapped_status,
      by = "GeneID"
    ) %>%
    dplyr::left_join(
      used_status,
      by = "GeneID"
    ) %>%
    dplyr::mutate(
      HasValidMouseInput = tidyr::replace_na(
        HasValidMouseInput,
        FALSE
      ),
      MappedToMouseEntrez = tidyr::replace_na(
        MappedToMouseEntrez,
        FALSE
      ),
      UsedForEnrichment = tidyr::replace_na(
        UsedForEnrichment,
        FALSE
      ),
      Status = dplyr::case_when(
        UsedForEnrichment ~
          "Used for GO/KEGG",
        
        !HasValidMouseInput ~
          "Excluded: no valid mouse ortholog identifier",
        
        HasValidMouseInput & !MappedToMouseEntrez ~
          "Excluded: mouse identifier did not map to Entrez",
        
        MappedToMouseEntrez & !UsedForEnrichment ~
          "Excluded: mapped Entrez ID absent from tested universe",
        
        TRUE ~
          "Unknown"
      )
    ) %>%
    dplyr::arrange(
      Status,
      GeneID
    )
  
  write.csv(
    original_genes,
    file = file.path(
      class_dir,
      paste0(
        class_key,
        "_ALL_original_dormouse_genes.csv"
      )
    ),
    row.names = FALSE
  )
  
  write.csv(
    audit,
    file = file.path(
      class_dir,
      paste0(
        class_key,
        "_AUDIT_every_original_gene.csv"
      )
    ),
    row.names = FALSE
  )
  
  write.csv(
    mapped_foreground,
    file = file.path(
      class_dir,
      paste0(
        class_key,
        "_EXACT_mapped_foreground.csv"
      )
    ),
    row.names = FALSE
  )
  
  write.csv(
    data.frame(
      ENTREZID = foreground_entrez,
      stringsAsFactors = FALSE
    ),
    file = file.path(
      class_dir,
      paste0(
        class_key,
        "_EXACT_foreground_EntrezIDs.csv"
      )
    ),
    row.names = FALSE
  )
  
  writeLines(
    foreground_entrez,
    con = file.path(
      class_dir,
      paste0(
        class_key,
        "_EXACT_foreground_EntrezIDs_one_per_line.txt"
      )
    )
  )
  
  cat("\n============================================================\n")
  cat(class_title, "\n")
  cat(
    "Original dormouse genes:",
    nrow(original_genes),
    "\n"
  )
  cat(
    "Original genes mapped and used:",
    dplyr::n_distinct(mapped_foreground$GeneID),
    "\n"
  )
  cat(
    "Unique mouse Entrez IDs submitted:",
    length(foreground_entrez),
    "\n"
  )
  cat(
    "Explicit tested universe:",
    length(universe_entrez),
    "mouse Entrez IDs\n"
  )
  
  if (length(foreground_entrez) == 0) {
    go_object <- NULL
    kegg_object <- NULL
    go_df <- empty_enrichment_table()
    kegg_df <- empty_enrichment_table()
  } else {
    if (!all(foreground_entrez %in% universe_entrez)) {
      stop(
        class_key,
        " contains foreground IDs outside the tested universe."
      )
    }
    
    go_object <- safe_enrich_go(
      genes = foreground_entrez,
      universe = universe_entrez
    )
    
    kegg_object <- safe_enrich_kegg(
      genes = foreground_entrez,
      universe = universe_entrez
    )
    
    go_df <- if (is.null(go_object)) {
      empty_enrichment_table()
    } else {
      add_rich_factor(
        as.data.frame(go_object)
      )
    }
    
    kegg_df <- if (is.null(kegg_object)) {
      empty_enrichment_table()
    } else {
      add_rich_factor(
        as.data.frame(kegg_object)
      )
    }
  }
  
  write.csv(
    go_df,
    file = file.path(
      class_dir,
      paste0(
        class_key,
        "_GO_BP_enrichment.csv"
      )
    ),
    row.names = FALSE
  )
  
  write.csv(
    kegg_df,
    file = file.path(
      class_dir,
      paste0(
        class_key,
        "_KEGG_mouse_enrichment.csv"
      )
    ),
    row.names = FALSE
  )
  
  if (
    nrow(go_df) > 0 &&
    "RichFactor" %in% colnames(go_df)
  ) {
    top_go <- go_df %>%
      dplyr::filter(is.finite(RichFactor)) %>%
      dplyr::arrange(
        dplyr::desc(RichFactor),
        p.adjust
      ) %>%
      utils::head(top_terms_to_plot) %>%
      add_rich_group()
    
    if (nrow(top_go) > 0) {
      go_plot <- ggplot2::ggplot(
        top_go,
        ggplot2::aes(
          x = RichFactor,
          y = reorder(Description, RichFactor),
          color = RichGroup,
          size = Count
        )
      ) +
        ggplot2::geom_point(alpha = 0.9) +
        ggplot2::scale_color_manual(
          values = three_cols,
          drop = FALSE
        ) +
        ggplot2::labs(
          title = paste0(
            class_title,
            ": GO Biological Process"
          ),
          x = "Rich Factor",
          y = "GO term",
          color = "Rich Factor",
          size = "Gene Count"
        ) +
        clean_theme
      
      ggplot2::ggsave(
        filename = file.path(
          class_dir,
          paste0(
            class_key,
            "_GO_RichFactor_dotplot.pdf"
          )
        ),
        plot = go_plot,
        width = 9,
        height = 7
      )
    }
  } else {
    cat(
      class_title,
      ": no significant GO BP terms.\n"
    )
  }
  
  if (
    nrow(kegg_df) > 0 &&
    "RichFactor" %in% colnames(kegg_df)
  ) {
    top_kegg <- kegg_df %>%
      dplyr::filter(is.finite(RichFactor)) %>%
      dplyr::arrange(
        dplyr::desc(RichFactor),
        p.adjust
      ) %>%
      utils::head(top_terms_to_plot) %>%
      add_rich_group()
    
    if (nrow(top_kegg) > 0) {
      kegg_plot <- ggplot2::ggplot(
        top_kegg,
        ggplot2::aes(
          x = RichFactor,
          y = reorder(Description, RichFactor),
          fill = RichGroup
        )
      ) +
        ggplot2::geom_col(width = 0.75) +
        ggplot2::scale_fill_manual(
          values = three_cols,
          drop = FALSE
        ) +
        ggplot2::labs(
          title = paste0(
            class_title,
            ": KEGG pathways"
          ),
          x = "Rich Factor",
          y = "KEGG pathway",
          fill = "Rich Factor"
        ) +
        clean_theme
      
      ggplot2::ggsave(
        filename = file.path(
          class_dir,
          paste0(
            class_key,
            "_KEGG_RichFactor_barplot.pdf"
          )
        ),
        plot = kegg_plot,
        width = 9,
        height = 7
      )
    }
  } else {
    cat(
      class_title,
      ": no significant KEGG pathways.\n"
    )
  }
  
  summary <- data.frame(
    Class = class_key,
    Biological_description = class_title,
    Original_dormouse_genes = nrow(original_genes),
    Original_genes_with_valid_mouse_input =
      dplyr::n_distinct(class_long$GeneID),
    Original_genes_mapped_to_Entrez =
      dplyr::n_distinct(mapped_before_universe$GeneID),
    Original_genes_used_for_enrichment =
      dplyr::n_distinct(mapped_foreground$GeneID),
    Unique_mouse_Entrez_foreground =
      length(foreground_entrez),
    Tested_mouse_Entrez_universe =
      length(universe_entrez),
    Significant_GO_BP_terms =
      nrow(go_df),
    Significant_KEGG_pathways =
      nrow(kegg_df),
    stringsAsFactors = FALSE
  )
  
  list(
    summary = summary,
    original_genes = original_genes,
    audit = audit,
    mapped_foreground = mapped_foreground,
    foreground_entrez = foreground_entrez,
    GO_object = go_object,
    GO_table = go_df,
    KEGG_object = kegg_object,
    KEGG_table = kegg_df
  )
}


