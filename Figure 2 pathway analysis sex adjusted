  file = file.path(
    output_root,
    "TL_vs_AE_ALL_tested_gene_results.csv"
  ),
  row.names = FALSE
)


# =============================================================================
# 7. DERIVE THE EXACT REVERSAL CLASSES
# =============================================================================

paired_results <- te_tl %>%
  dplyr::select(
    GeneID,
    logFC_TE_TL = logFC,
    logCPM_TE_TL = logCPM,
    F_TE_TL = F,
    PValue_TE_TL = PValue,
    FDR_TE_TL = FDR
  ) %>%
  dplyr::inner_join(
    tl_ae %>%
      dplyr::select(
        GeneID,
        logFC_TL_AE = logFC,
        logCPM_TL_AE = logCPM,
        F_TL_AE = F,
        PValue_TL_AE = PValue,
        FDR_TL_AE = FDR
      ),
    by = "GeneID"
  )

shared_significant <- paired_results %>%
  dplyr::filter(
    FDR_TE_TL < fdr_cutoff,
    FDR_TL_AE < fdr_cutoff
  ) %>%
  dplyr::mutate(
    ReversalClass = dplyr::case_when(
      logFC_TE_TL < 0 & logFC_TL_AE > 0 ~
        "Dominant_increased_TE_to_TL_then_decreased_TL_to_AE",
      
      logFC_TE_TL > 0 & logFC_TL_AE < 0 ~
        "Inverse_decreased_TE_to_TL_then_increased_TL_to_AE",
      
      TRUE ~
        "Same_direction_or_zero"
    )
  )

opposite_direction <- shared_significant %>%
  dplyr::filter(
    ReversalClass != "Same_direction_or_zero"
  )

dominant_class <- opposite_direction %>%
  dplyr::filter(
    ReversalClass ==
      "Dominant_increased_TE_to_TL_then_decreased_TL_to_AE"
  )

inverse_class <- opposite_direction %>%
  dplyr::filter(
    ReversalClass ==
      "Inverse_decreased_TE_to_TL_then_increased_TL_to_AE"
  )

cat("\nREVERSAL COUNTS\n")
cat(
  "Shared significant TE–TL and TL–AE genes:",
  nrow(shared_significant),
  "\n"
)
cat(
  "Opposite-direction genes:",
  nrow(opposite_direction),
  "\n"
)
cat(
  "Dominant increase-then-decrease class:",
  nrow(dominant_class),
  "\n"
)
cat(
  "Inverse decrease-then-increase class:",
  nrow(inverse_class),
  "\n"
)

if (strict_expected_counts) {
  observed_counts <- c(
    shared = nrow(shared_significant),
    opposite = nrow(opposite_direction),
    dominant = nrow(dominant_class),
    inverse = nrow(inverse_class)
  )
  
  expected_counts <- c(
    shared = expected_shared_reversal_genes,
    opposite = expected_shared_reversal_genes,
    dominant = expected_dominant_genes,
    inverse = expected_inverse_genes
  )
  
  if (!identical(
    unname(observed_counts),
    unname(expected_counts)
  )) {
    stop(
      "Reversal counts do not match the expected manuscript analysis.\n",
      "Observed: ",
      paste(
        names(observed_counts),
        observed_counts,
        sep = "=",
        collapse = ", "
      ),
      "\nExpected: ",
      paste(
        names(expected_counts),
        expected_counts,
        sep = "=",
        collapse = ", "
      )
    )
  }
}

